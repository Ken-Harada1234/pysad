!********************************************************************
!*
!*   ASTRID2 - THE ULTIMATE SYNCHROTRON RADIATION SOURCE
!*   http://www.isa.au.dk/facilities/astrid2/astrid2.asp
!*
!********************************************************************

MOMENTUM= 0.58 GEV;

MARK
	MKS   =()
	MKE   =()
;

MONI
	PM     =()
;

CAVI
	CAVI=(VOLT= 50000 FREQ = 104950000)
;

BEND
	PV = ( L = 0    K0 = 0     ROTATE =-90 DEG ) 
	PH = ( L = 0    K0 = 0  )
;

QUAD
	QF3 = ( L =0.1800 K1 =5.939500*0.1800 )
	QF2 = ( L =0.1800 K1 =6.070000*0.1800 )
;

SEXT
	SF = ( L =0.0750   K2 =   125.62*0.0750 )
	SD = ( L =0.1500   K2 =   -81.93*0.15 )
;

BEND
	BH = (L = 0.8500 ANGLE = 0.523599 K1 = -1.678200*0.8500  E1=0 E2=0)
;

DRIFT
	D14837    = (L = 1.4837 )
        D14837MPW = (L = 0.5212 )
	D0100     = (L = 0.1000 )
	D0180     = (L = 0.1800 )
	D0190     = (L = 0.1900 )
	D0120     = (L = 0.1200 )

;

LINE
	HV    = (PH PV)
	NCELL
	=(MKS
	  D14837 PM D0100 QF3  D0180 HV D0180 
          BH 
          D0190 SD D0120 QF2 D0120 SF
          PM
	  SF D0120 QF2 D0120 SD D0190 
          BH D0180 HV D0180 QF3 D0100 PM D14837
          MKE) 

	RING = (3*NCELL CAVI 3*NCELL)
!	RING = (6*CELL)
;

 SEXT   SD      =(L =.15  K2 =-11.729486011842393 )
        SF      =(L =.075 K2 =8.681418961367605 )
 ;
 BEND

! Kmpw = 32.7
! lmpw = 0.175 [m]
! Bmax = 2 [T]
! rhomin = 0.9660907010809813 [m] 
! theta (average) / pole = lmpw / 2 / (Sqrt[2] * rhomin) = 0.0640435140143602

       BMPW1I = ( L = .175/4 K0 =  0.0640435140143602/2           E2 =1)
       BMPW1  = ( L = .175/2 K0 =  0.0640435140143602    E1 =.5    E2 =.5)
       BMPW2  = ( L = .175/2 K0 = -0.0640435140143602    E1 =.5    E2 =.5)
       BMPW1F = ( L = .175/4 K0 =  0.0640435140143602/2  E1 =1)
 ;
 MARK   MMPWS = ()
        MMPWE = ()
 ;
 LINE   PMPW = (BMPW1 BMPW2)
        MPW  = (MMPWS BMPW1I BMPW2 10*PMPW BMPW1F MMPWE)
        TCELL
             =(MKS
              D14837 PM D0100 QF3  D0180 HV D0180
              BH
              D0190 SD D0120 QF2 D0120 SF
              PM
              SF D0120 QF2 D0120 SD D0190
              BH D0180 HV D0180 QF3 D0100 PM D14837MPW
              MPW
              D14837MPW PM D0100 QF3  D0180 HV D0180
              BH
              D0190 SD D0120 QF2 D0120 SF
              PM
              SF D0120 QF2 D0120 SD D0190
              BH D0180 HV D0180 QF3 D0100 PM D14837
              MKE)

        RINGMPW = (2*NCELL CAVI TCELL 2*NCELL) 
 ;
!+
!  MPW (ASTRID2, 11 周期、K=32.7、λ=0.175 m) を入れたリングと入れないリングの比較
!  RING = MPW なし、RINGMPW = 2 セルの直線部 1 つを MPW 入りセルに置換
!-
ON LOG RFSW RADCOD RAD COD;
OFF FLUC;
FFS;
  $FORM = "12.6";
  PageWidth = 1999;

  USE RING;
  cell calc emit;
  disp $$$;
  em0 = Emittance[];
  Print["noMPW  NX NY = ", Twiss["NX","$$$"]/2/Pi, " ", Twiss["NY","$$$"]/2/Pi];
  Print["noMPW  U0[eV] = ", EnergyLossU0/.em0, "  emitx[nm] = ", (Emittances/.em0)[1]*1e9, "  sigE = ", MomentumSpread/.em0];
  Print["noMPW  BX BY (MKS of cell) = ", Twiss["BX",1], " ", Twiss["BY",1]];

  USE RINGMPW;
  cell calc emit;
  disp $$$;
  em1 = Emittance[];
  Print["MPW    NX NY = ", Twiss["NX","$$$"]/2/Pi, " ", Twiss["NY","$$$"]/2/Pi];
  Print["MPW    U0[eV] = ", EnergyLossU0/.em1, "  emitx[nm] = ", (Emittances/.em1)[1]*1e9, "  sigE = ", MomentumSpread/.em1];
  Print["MPW    LENGTH(s) = ", Twiss["S","$$$"], "  #elements = ", LINE["LENGTH"]];

  ! MPW 区間の BY, 磁石区間を Twiss で読む 
  iS = LINE["POSITION","MMPWS"]; iE = LINE["POSITION","MMPWE"];
  Print["MMPWS #", iS, " s=", Twiss["S",iS], " BY=", Twiss["BY",iS], "   MMPWE #", iE, " s=", Twiss["S",iE], " BY=", Twiss["BY",iE]];
  ssum = 0; wsum = 0;
  Do[ ds = Twiss["S",i+1]-Twiss["S",i]; ssum = ssum + ds; wsum = wsum + ds*(Twiss["BY",i]+Twiss["BY",i+1])/2; , {i,iS,iE-1}];
  Print["MPW length = ", ssum, "  <BY> in MPW = ", wsum/ssum];
  Print["dNY (MPW - noMPW) = ", Twiss["NY","$$$"]/2/Pi - 2.140178];
Exit;
