! MULT: 多極をまとめた要素 (K1 だけなら QUAD、ANGLE 付きなら BEND と同じ)
MOMENTUM = 3GEV;
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS = (L=0.1);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
MULT  MF = (L=0.3 K1=0.7) MD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MULT  MB = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = ();
LINE CELLQ = (SF DS QF D2 B D2 QD DS SD D1);
LINE CELLM = (SF DS MF D2 MB D2 MD DS SD D1);
LINE RINGQ = (ORIGIN 24*CELLQ);
LINE RINGM = (ORIGIN 24*CELLM);
FFS;
$FORM = "10.6";
USE RINGQ; CELL; CALC;
Print["QUAD/BEND ring: NX=", Twiss["NX","$$$"]/2/Pi, " NY=", Twiss["NY","$$$"]/2/Pi];
USE RINGM; CELL; CALC;
Print["MULT ring     : NX=", Twiss["NX","$$$"]/2/Pi, " NY=", Twiss["NY","$$$"]/2/Pi];
TYPE MF MB;
Exit;
