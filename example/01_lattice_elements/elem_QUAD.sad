! QUAD: 輸送路で転送行列と β の変換を見る (L=0.3, K1=0.7 は積分強度)
MOMENTUM = 3GEV;
QUAD Q = (L=0.3 K1=0.7) QT = (L=0.001 K1=0.021);
DRIFT D1 = (L=1);
MARK START = (BX=10 BY=10 AX=0 AY=0) FIN = ();
LINE T = (START Q FIN);
LINE TT = (START QT FIN);
FFS;
$FORM = "10.6";
USE T; INS; CALC;
m = TransferMatrix["START","FIN"];
Print["thick Q  M11 M12 M21 M22 = ", m[[1,1]], " ", m[[1,2]], " ", m[[2,1]], " ", m[[2,2]]];
Print["thick Q  M33 M34 M43 M44 = ", m[[3,3]], " ", m[[3,4]], " ", m[[4,3]], " ", m[[4,4]]];
Print["BX FIN = ", Twiss["BX","FIN"], "  BY FIN = ", Twiss["BY","FIN"]];
Print["NX FIN = ", Twiss["NX","FIN"], "  NY FIN = ", Twiss["NY","FIN"]];
USE TT; INS; CALC;
m = TransferMatrix["START","FIN"];
Print["thin QT  M21 = ", m[[2,1]], "  M43 = ", m[[4,3]]];
Exit;
