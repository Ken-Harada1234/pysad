! APERT: 追跡だけで効く開口 (AX AY が半幅、DX DY が中心)。粒子が外にいると flag が 0 になる
MOMENTUM = 3GEV;
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS = (L=0.1);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = ();
APERT AP = (AX=0.01 AY=0.005);
LINE CELL = (SF DS QF D2 B D2 QD DS SD D1);
LINE RING = (ORIGIN AP 24*CELL);
FFS;
$FORM = "10.6";
USE RING; CELL; CALC;
TYPE AP;
NPARA = 1;
! 2 粒子: 1 は開口の中 (x=1mm)、2 は外 (x=20mm)。K64 は最初の TrackParticles で最初から外の粒子を落とさない (docs の A52) ので 2 回呼ぶ
beam = {1, {{0.001,0.02}, {0,0}, {0.001,0.001}, {0,0}, {0,0}, {0,0}, {1,1}}};
r = TrackParticles[beam, LINE["LENGTH"], 1, 1];
Print["1st call: flag = ", r[[2,7]], "  x = ", r[[2,1]]];
r = TrackParticles[beam, LINE["LENGTH"], 1, 1];
Print["2nd call: flag = ", r[[2,7]], "  x = ", r[[2,1]]];
Exit;
