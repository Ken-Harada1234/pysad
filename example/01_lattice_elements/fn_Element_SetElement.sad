MOMENTUM = 3GEV;
! FODO ring: 24 cells, 15 deg bend per cell (2*pi total), 3 GeV
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS = (L=0.1);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = ();
CAVI RF = (L=0 VOLT=1.5E6 FREQ=5.0E8 PHI=0);
LINE CELL = (SF DS QF D2 B D2 QD DS SD D1);
LINE RING = (ORIGIN RF 24*CELL);
FFS;
$FORM = "10.6";
USE RING; CELL; CALC;
Print["Element K1 QF = ", Element["K1","QF"], "  L = ", Element["L","QF"], "  VALUE = ", Element["VALUE","QF"]];
Print["Element TYPENAME QF B RF = ", Element["TYPENAME",{"QF","B","RF"}]];
Print["Element POSITION QF = ", Element["POSITION","QF"], "  NAME = ", Element["NAME", Element["POSITION","QF"]]];
Print["Element KEYWORDS B = ", Element["KEYWORDS","B"]];
Element["K1","QF"] = 0.8;
CALC;
Print["after Element[K1,QF]=0.8: NX = ", Twiss["NX","$$$"]/2/Pi, "  LINE K1 QF.5 = ", LINE["K1","QF.5"]];
r = SetElement["QF", "QUAD", "K1" -> 0.7];
Print["SetElement returns ", r];
CALC;
Print["after SetElement K1=0.7: NX = ", Twiss["NX","$$$"]/2/Pi];
Exit;
