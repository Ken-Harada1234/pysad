! BEND: セクター型 (E1=E2=0) と長方形型 (E1=E2=ANGLE/2)、FRINGE
MOMENTUM = 3GEV;
BEND BS = (L=1.2 ANGLE=0.2617993877991494 E1=0 E2=0);
BEND BR = (L=1.2 ANGLE=0.2617993877991494 E1=0.5 E2=0.5);
BEND BF = (L=1.2 ANGLE=0.2617993877991494 E1=0.5 E2=0.5 F1=0.3 FRINGE=3);
MARK START = (BX=10 BY=10 AX=0 AY=0) FIN = ();
LINE TS = (START BS FIN);
LINE TR = (START BR FIN);
LINE TF = (START BF FIN);
FFS;
$FORM = "10.6";
USE TS; INS; CALC;
m = TransferMatrix["START","FIN"];
Print["BS M11 M12 M21 M22 = ", m[[1,1]], " ", m[[1,2]], " ", m[[2,1]], " ", m[[2,2]]];
Print["BS M33 M34 M43 M44 = ", m[[3,3]], " ", m[[3,4]], " ", m[[4,3]], " ", m[[4,4]]];
Print["BS EX EPX = ", Twiss["EX","FIN"], " ", Twiss["EPX","FIN"]];
USE TR; INS; CALC;
m = TransferMatrix["START","FIN"];
Print["BR M11 M12 M21 M22 = ", m[[1,1]], " ", m[[1,2]], " ", m[[2,1]], " ", m[[2,2]]];
Print["BR M33 M34 M43 M44 = ", m[[3,3]], " ", m[[3,4]], " ", m[[4,3]], " ", m[[4,4]]];
Print["BR EX EPX = ", Twiss["EX","FIN"], " ", Twiss["EPX","FIN"]];
USE TF; INS; CALC;
m = TransferMatrix["START","FIN"];
Print["BF M11 M12 M21 M22 = ", m[[1,1]], " ", m[[1,2]], " ", m[[2,1]], " ", m[[2,2]]];
Print["BF M33 M34 M43 M44 = ", m[[3,3]], " ", m[[3,4]], " ", m[[4,3]], " ", m[[4,4]]];
Print["BF EX EPX = ", Twiss["EX","FIN"], " ", Twiss["EPX","FIN"]];
USE TS; INS; CALC;
Print["geometry at FIN (BS): GX GY GZ = ", LINE["GX","FIN"], " ", LINE["GY","FIN"], " ", LINE["GZ","FIN"], "  CHI1 CHI2 CHI3 = ", LINE["GCHI1","FIN"], " ", LINE["GCHI2","FIN"], " ", LINE["GCHI3","FIN"]];
Exit;
