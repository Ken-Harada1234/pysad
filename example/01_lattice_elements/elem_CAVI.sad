! CAVI: RF 空洞 (HARM で周波数を周回周波数の整数倍にする)。Emittance[] のシンクロトロンチューン (RAD なし)
MOMENTUM = 3GEV;
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS = (L=0.1);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = ();
CAVI RF = (L=0 VOLT=1.5E6 HARM=176 PHI=0);
LINE CELL = (SF DS QF D2 B D2 QD DS SD D1);
LINE RING = (ORIGIN RF 24*CELL);
FFS;
$FORM = "10.6";
USE RING; CELL; CALC;
TYPE RF;
em = Emittance[];
Print["Tunes (x,y,s) = ", Tunes/.em];
Print["MomentumCompaction = ", MomentumCompaction/.em];
Print["Stable = ", Stable/.em, "  U0 = ", EnergyLossU0/.em, "  Vc = ", RfVoltageVc/.em];
RF VOLT 3.0E6;
CALC;
em = Emittance[];
Print["VOLT=3MV  Tunes (x,y,s) = ", Tunes/.em, "  U0 = ", EnergyLossU0/.em, "  alpha = ", MomentumCompaction/.em];
RF VOLT 6.0E6;
CALC;
em = Emittance[];
Print["VOLT=6MV  Tunes (x,y,s) = ", Tunes/.em, "  U0 = ", EnergyLossU0/.em, "  alpha = ", MomentumCompaction/.em];
RF PHI 0.5;
CALC;
em = Emittance[];
Print["VOLT=6MV PHI=0.5  Tunes (x,y,s) = ", Tunes/.em];
Exit;
