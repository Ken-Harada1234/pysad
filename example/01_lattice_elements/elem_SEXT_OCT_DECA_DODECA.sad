! SEXT OCT DECA DODECA: 輸送路では線形光学に効かない。リングでは六極が chromaticity に効く
MOMENTUM = 3GEV;
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS = (L=0.1);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0) S3 = (L=0.2 K2=10);
OCT  O4 = (L=0.2 K3=100);
DECA D5 = (L=0.2 K4=1000);
DODECA D6 = (L=0.2 K5=10000);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK ORIGIN = ();
MARK START = (BX=10 BY=10 AX=0 AY=0) FIN = ();
LINE T = (START S3 O4 D5 D6 FIN);
LINE CELL = (SF DS QF D2 B D2 QD DS SD D1);
LINE RING = (ORIGIN 24*CELL);
FFS;
$FORM = "10.6";
USE T; INS; CALC;
TYPE S3 O4 D5 D6;
m = TransferMatrix["START","FIN"];
Print["K5 of D6: LINE = ", LINE["K5","D6"], "  Element = ", Element["K5","D6"]];
Print["with S3 O4 D5 D6 : M11 M12 M21 M22 = ", m[[1,1]], " ", m[[1,2]], " ", m[[2,1]], " ", m[[2,2]]];
USE RING; CELL; CALC;
Print["K2=0 : NX NY = ", Twiss["NX","$$$"]/2/Pi, " ", Twiss["NY","$$$"]/2/Pi];
SF K2 5;
SD K2 -8;
CALC;
Print["K2 SF SD = ", LINE["K2",{"SF.1","SD.1"}], "  NX NY = ", Twiss["NX","$$$"]/2/Pi, " ", Twiss["NY","$$$"]/2/Pi];
ps = LINE["POSITION","SF.1"] + {0,.25,.5,.75,1};
Print["SF.1 along s: BX = ", Twiss["BX",ps], "  EX = ", Twiss["EX",ps], "  BY = ", Twiss["BY",ps]];
ps = LINE["POSITION","SD.1"] + {0,.25,.5,.75,1};
Print["SD.1 along s: BX = ", Twiss["BX",ps], "  EX = ", Twiss["EX",ps], "  BY = ", Twiss["BY",ps]];
CHRO;
Exit;
