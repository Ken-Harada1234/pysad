MOMENTUM = 3GEV;
! FODO ring: 24 cells, 15 deg bend per cell (2*pi total), 3 GeV
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS = (L=0.1);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = ();
CAVI RF = (L=0 VOLT=1.5E6 FREQ=5.0E8 PHI=0);
LINE CELL = (SF DS QF D2 B D2 QD DS SD D1);
LINE RING = (ORIGIN RF 24*CELL);
FFS;
USE RING; CELL; CALC;
NORFSW; NORAD; NOFLUC;
LOSSAMPL = 0.05;
$FORM = "12.6";
x0 = {1e-3, 0.02, 0.025, 0.03, 0.04};
n = Length[x0];
zero = Table[0, {i, n}];
beam = {x0, zero, zero, zero, zero, zero, Table[1, {i, n}]};
Print["--- NOLOSSMAP (既定): 戻りの列数 ---"];
r = TrackParticles[{1, beam}, 1, 1, 30];
Print["Dimensions=", Dimensions[r[[2]]], " flag=", r[[2,7]]];
LOSSMAP;
Print["--- LOSSMAP: 8 列目に損失した要素番号、9 列目に損失した周 ---"];
r = TrackParticles[{1, beam}, 1, 1, 30];
Print["Dimensions=", Dimensions[r[[2]]]];
Print["flag      =", r[[2,7]]];
Print["lost elem =", r[[2,8]]];
Print["lost turn =", r[[2,9]]];
Print["element name at loss: ", Table[If[r[[2,8,k]] > 0, LINE["NAME", r[[2,8,k]]], "-"], {k, 1, n}]];
Exit;
