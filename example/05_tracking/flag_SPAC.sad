MOMENTUM = 20MEV;    ! 低エネルギー (空間電荷を見るため。K は規格化なので光学は同じ)
! ラティスは 00_lattice/spac_ring.sad と同じ (FODO ring: 24 cells, 15 deg bend per cell, 周長 105.6 m)
! SPAC 用: DRIFT の RADIUS = 真空ダクト半径 (m)。正なら空間電荷とその半径での損失、負なら損失のみ
DRIFT D1 = (L=1.0 RADIUS=0.03) D2 = (L=0.5 RADIUS=0.03) DS = (L=0.1 RADIUS=0.03);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = ();
CAVI RF = (L=0 VOLT=0 FREQ=5.0E8 PHI=0);    ! 電圧 0 (RFSW を ON にするので、20 MeV のビームを空洞で乱さない)
LINE CELL = (SF DS QF D2 B D2 QD DS SD D1);
LINE RING = (ORIGIN RF 24*CELL);
LINE TL = (ORIGIN D1);                       ! (A) 用: 1 m のドリフトだけの輸送路
FFS;
NPARA = 1;
RFSW; NORAD; NOFLUC;             ! フラグは FFS の最上位に書く (Do[...] などの式の中では切り替わらない)。pysad v2 の空間電荷は RFSW が要る
$FORM = "12.6";
rms[v_] := Sqrt[Plus@@(v^2)/Length[v]];
fr[x_] := x - Floor[x];
re = 2.8179403205e-15;           ! 電子の古典半径 [m]
pp = 20e6/0.51099895e6; gam = Sqrt[1+pp^2]; bet = pp/gam;

! ==== (A) 1 m のドリフト (RADIUS = 3 cm): 一様なビームの広がりを包絡方程式 a'' = K/a と比べる
USE TL; INS; CALC;
np = 2000;
PBUNCH = 1e12;                   ! 1 バンチの実粒子数 (マクロ粒子 1 個は PBUNCH/np 個)
a0 = 1e-3; lb = 0.1;             ! 半径 1 mm の一様な円、長さ 0.1 m の一様なバンチ (角度 0)
rr = Table[a0*Sqrt[fr[i*0.6180339887+0.5]], {i, np}];
th = Table[2*Pi*fr[i*0.7548776662], {i, np}];
x0 = rr*Cos[th]; y0 = rr*Sin[th];
z0 = Table[lb*(fr[i*0.5698402910]-0.5), {i, np}];
zero = Table[0, {i, np}];
beam = {x0, zero, y0, zero, z0, zero, Table[1, {i, np}]};
NOSPAC;
r = TrackParticles[{1, beam}][[2]];
Print["(A) NOSPAC rms x=", rms[r[[1]]], " y=", rms[r[[3]]], " alive=", Plus@@r[[7]]];
SPAC;
r = TrackParticles[{1, beam}][[2]];
Print["(A) SPAC   rms x=", rms[r[[1]]], " y=", rms[r[[3]]], " alive=", Plus@@r[[7]]];
! 解析式: ペルビアンス K = 2 r_e λ/(β²γ³)、λ = PBUNCH/lb。a'' = K/a を 1 m 積分 (一様な円の rms は a/2)
kperv = 2*re*(PBUNCH/lb)/(bet^2*gam^3);
env[k_] := Module[{a = a0, ap = 0, h = 1e-3},
  Do[ap = ap + h/2*k/a; a = a + h*ap; ap = ap + h/2*k/a, {i, 1000}]; a];
Print["(A) K = ", kperv, "  envelope rms: K -> ", env[kperv]/2, "  K/gamma (K64 SPC1) -> ", env[kperv/gam]/2];

! ==== (B) リング 1 周のチューンシフト (空間電荷は RADIUS>0 の DRIFT の中だけ = 周長の 50%)
USE RING; CELL; CALC;
np = 4000;
PBUNCH = 1.5e9;
SPACSTEP = 0.1;                  ! SPAC のキックの間隔 [m] (pysad v2 の変数。既定 0.05。gs では意味を持たない: 5 cm 固定)
eps = 1e-6; sz = 0.01;           ! 整合したガウスビーム: エミッタンス 1e-6 m (x, y)、バンチ長 1 cm、運動量の広がり 0
gs[k_, c_] := Table[Sqrt[-2*Log[fr[i*k+0.5]+1e-12]]*Cos[2*Pi*fr[i*c]], {i, np}];   ! ガウス分布 (乱数を使わない)
bx = Twiss["BX", 1]; ax = Twiss["AX", 1]; by = Twiss["BY", 1]; ay = Twiss["AY", 1];
u1 = gs[0.6180339887, 0.7548776662]; u2 = gs[0.5698402910, 0.8191725134];
u3 = gs[0.6710436067, 0.4502835858]; u4 = gs[0.8566748839, 0.7338918566];
x0 = Sqrt[eps*bx]*u1; px0 = Sqrt[eps/bx]*(u2 - ax*u1);
y0 = Sqrt[eps*by]*u3; py0 = Sqrt[eps/by]*(u4 - ay*u3);
z0 = sz*gs[0.7071067812, 0.3247179572];
zero = Table[0, {i, np}];
! 試験粒子 1 個をビームと一緒に 1 周させ、小さなずれ dd に対する応答から 1 周の行列の対角和を作る
dd = 1e-6;
trk[t_] := Module[{b, r},
  b = {Append[x0, t[[1]]], Append[px0, t[[2]]], Append[y0, t[[3]]], Append[py0, t[[4]]], Append[z0, 0], Append[zero, 0], Table[1, {i, np+1}]};
  r = TrackParticles[{1, b}, 1, 1, 1][[2]];
  {r[[1, np+1]], r[[2, np+1]], r[[3, np+1]], r[[4, np+1]]}];
tune[] := Module[{c0, cx, cp, cy, cq},
  c0 = trk[{0, 0, 0, 0}]; cx = trk[{dd, 0, 0, 0}]; cp = trk[{0, dd, 0, 0}]; cy = trk[{0, 0, dd, 0}]; cq = trk[{0, 0, 0, dd}];
  {ArcCos[((cx[[1]]-c0[[1]]) + (cp[[2]]-c0[[2]]))/(2*dd)]/(2*Pi), ArcCos[((cy[[3]]-c0[[3]]) + (cq[[4]]-c0[[4]]))/(2*dd)]/(2*Pi)}];
Print["(B) Twiss: nux=", Twiss["NX", $$$]/(2*Pi), " nuy=", Twiss["NY", $$$]/(2*Pi)];
NOSPAC;
nu0 = tune[];
Print["(B) NOSPAC fractional tune (ArcCos) x=", nu0[[1]], " y=", nu0[[2]]];
SPAC;
nu1 = tune[];
Print["(B) SPAC   fractional tune (ArcCos) x=", nu1[[1]], " y=", nu1[[2]]];
! チューンの小数部は 0.5 より大きい (0.696、0.906) ので、ArcCos の値は 1 - 小数部。チューンの変化は符号を変えたもの
Print["(B) tracking  dnux=", -(nu1[[1]]-nu0[[1]]), " dnuy=", -(nu1[[2]]-nu0[[2]])];
! 解析式 (Laslett): dnu_u = -(1/4 pi) Int beta_u k_u ds、k_x = kp/(sx (sx+sy))、kp = 2 r_e λ_peak/(β²γ³)、λ_peak = PBUNCH/(Sqrt[2 pi] sz)、
! s_u = Sqrt[beta_u eps]。RADIUS>0 の DRIFT の中だけ (Simpson 則。Twiss["BX", k+0.5] は要素 k の中点) と、全周に入れた場合
kp = 2*re*PBUNCH/(Sqrt[2*Pi]*sz)/(bet^2*gam^3);
fx[k_] := Module[{b1 = Twiss["BX", k], b2 = Twiss["BY", k]}, b1*kp/(Sqrt[eps*b1]*(Sqrt[eps*b1]+Sqrt[eps*b2]))];
fy[k_] := Module[{b1 = Twiss["BX", k], b2 = Twiss["BY", k]}, b2*kp/(Sqrt[eps*b2]*(Sqrt[eps*b1]+Sqrt[eps*b2]))];
nlat = LINE["LENGTH"];
sxd = 0; syd = 0; sxa = 0; sya = 0; ld = 0; la = 0;
Do[
  len = LINE["L", k];
  If[len > 0,
    wx = (fx[k] + 4*fx[k+0.5] + fx[k+1])/6*len; wy = (fy[k] + 4*fy[k+0.5] + fy[k+1])/6*len;
    sxa = sxa + wx; sya = sya + wy; la = la + len;
    If[LINE["RADIUS", k] > 0, sxd = sxd + wx; syd = syd + wy; ld = ld + len]],
  {k, 1, nlat-1}];
Print["(B) Laslett (DRIFT only, ", ld, " m of ", la, " m): dnux=", -sxd/(4*Pi), " dnuy=", -syd/(4*Pi)];
Print["(B) Laslett (whole ring):  dnux=", -sxa/(4*Pi), " dnuy=", -sya/(4*Pi)];
Print["(B) Laslett (DRIFT only)/gamma (K64 SPC1): dnux=", -sxd/(4*Pi)/gam, " dnuy=", -syd/(4*Pi)/gam];

! ==== (C) RADIUS<0: 空間電荷なし、半径 |RADIUS| (0.4 mm) で損失だけ
np = 200;
x0 = Table[3e-4*Sin[0.37*i]*Cos[0.11*i], {i, np}];
y0 = Table[3e-4*Cos[0.23*i]*Sin[0.71*i], {i, np}];
z0 = Table[0.01*Sin[0.13*i], {i, np}];
zero = Table[0, {i, np}];
beam = {x0, zero, y0, zero, z0, zero, Table[1, {i, np}]};
Print["(C) initial rms x=", rms[x0], " y=", rms[y0], "  RADIUS(D1)=", Element["RADIUS","D1"]];
Element["RADIUS", "D1"] = -4e-4; Element["RADIUS", "D2"] = -4e-4; Element["RADIUS", "DS"] = -4e-4;
SPAC;
r = TrackParticles[{1, beam}, 1, 1, 2][[2]];
Print["(C) SPAC RADIUS=-0.4 mm, 2 turns: alive=", Plus@@r[[7]]];
NOSPAC;
r = TrackParticles[{1, beam}, 1, 1, 2][[2]];
Print["(C) NOSPAC RADIUS=-0.4 mm, 2 turns: alive=", Plus@@r[[7]]];
Exit;
