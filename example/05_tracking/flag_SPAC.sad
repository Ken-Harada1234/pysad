MOMENTUM = 20MEV;    ! 低エネルギー (空間電荷を見るため。K は規格化なので光学は同じ)
! FODO ring: 24 cells, 15 deg bend per cell (2*pi total), 3 GeV
! SPAC 用: DRIFT の RADIUS = 真空ダクト半径 (m)。正なら空間電荷とその半径での損失、負なら損失のみ
DRIFT D1 = (L=1.0 RADIUS=0.03) D2 = (L=0.5 RADIUS=0.03) DS = (L=0.1 RADIUS=0.03);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = ();
CAVI RF = (L=0 VOLT=1.5E6 FREQ=5.0E8 PHI=0);
LINE CELL = (SF DS QF D2 B D2 QD DS SD D1);
LINE RING = (ORIGIN RF 24*CELL);
FFS;
NORFSW; NORAD; NOFLUC;
USE RING; CELL; CALC;
$FORM = "12.6";
NP = 200;                        ! マクロ粒子数
PBUNCH = 1e13;                   ! 1 バンチの実粒子数
np = 200;
x0 = Table[3e-4*Sin[0.37*i]*Cos[0.11*i], {i, np}];
y0 = Table[3e-4*Cos[0.23*i]*Sin[0.71*i], {i, np}];
z0 = Table[0.01*Sin[0.13*i], {i, np}];
zero = Table[0, {i, np}];
beam = {x0, zero, y0, zero, z0, zero, Table[1, {i, np}]};
rms[v_] := Sqrt[Plus@@(v^2)/Length[v]];
Print["initial rms x=", rms[x0], " y=", rms[y0], "  RADIUS(D1)=", Element["RADIUS","D1"]];
! (A) RADIUS=+0.03 m: 空間電荷あり。NOSPAC と比べる
Do[
  nt = {1, 20, 100}[[k]];
  NOSPAC;
  r = TrackParticles[{1, beam}, 1, 1, nt][[2]];
  Print["(A) NOSPAC ", nt, " turns: rms x=", rms[r[[1]]], " y=", rms[r[[3]]], " alive=", Plus@@r[[7]]];
  SPAC;
  r = TrackParticles[{1, beam}, 1, 1, nt][[2]];
  Print["(A) SPAC   ", nt, " turns: rms x=", rms[r[[1]]], " y=", rms[r[[3]]], " alive=", Plus@@r[[7]]],
  {k, 1, 3}];
! (B) RADIUS<0: 空間電荷なし、半径 |RADIUS| (0.4 mm) で損失だけ
Element["RADIUS", "D1"] = -4e-4; Element["RADIUS", "D2"] = -4e-4; Element["RADIUS", "DS"] = -4e-4;
SPAC;
r = TrackParticles[{1, beam}, 1, 1, 2][[2]];
Print["(B) SPAC RADIUS=-0.4 mm, 2 turns: alive=", Plus@@r[[7]]];
NOSPAC;
r = TrackParticles[{1, beam}, 1, 1, 2][[2]];
Print["(B) NOSPAC RADIUS=-0.4 mm, 2 turns: alive=", Plus@@r[[7]]];
Exit;
