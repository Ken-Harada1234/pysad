MOMENTUM = 3GEV;
! FODO ring: 24 cells, 15 deg bend per cell (2*pi total), 3 GeV
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS = (L=0.1);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = ();
CAVI RF = (L=0 VOLT=4.0E6 FREQ=5.0E8 PHI=0);
LINE CELL = (SF DS QF D2 B D2 QD DS SD D1);
LINE RING = (ORIGIN RF 24*CELL);
! QF から始まる並び (RADINT は先頭が SEXT だと DL=0 で NaN になるため。FODO_ring と同じ磁石列、位相だけ違う)
LINE CELLQ = (QF D2 B D2 QD DS SD D1 SF DS);
LINE RINGQ = (ORIGIN RF 24*CELLQ);
FFS;
USE RING; CELL; CALC;
RFSW; RAD; NOFLUC;
EMIT;                       ! DA は閉軌道・規格化座標・平衡エミッタンスを使う。RF 4 MV で U0=1.56 MV を補う
NORAD;
DAPWIDTH = 51;           ! 追跡を始める粒子の窓の幅 (既定 7)。pysad は 51 のみ対応
$FORM = "12.6";
! range = {xrange, yrange, zrange}。既定 Axes "ZX": zrange にリスト (3 値)、xrange は {最小,最大} を 51 点
Print["EMITX=", EMITX, " EMITY=", EMITY, " EMITZ=", EMITZ];
res = DynamicApertureSurvey[{{1,400},{1,1},{-0.5,0,0.5}}, 50, Output->6];
Print["SCORE ", res[[1]]];
Print["RES ", res[[2]]];
Exit;
