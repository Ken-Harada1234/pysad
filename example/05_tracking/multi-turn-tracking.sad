MOMENTUM = 3GEV;
! FODO ring: 24 cells, 15 deg bend per cell (2*pi total), 3 GeV
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS = (L=0.1);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = ();
CAVI RF = (L=0 VOLT=4.0E6 FREQ=5.0E8 PHI=0);
LINE CELL = (SF DS QF D2 B D2 QD DS SD D1);
LINE RING = (ORIGIN RF 24*CELL);
! QF から始まる並び (RADINT は先頭が SEXT だと DL=0 で NaN になるため。FODO_ring と同じ磁石列、位相だけ違う)
LINE CELLQ = (QF D2 B D2 QD DS SD D1 SF DS);
LINE RINGQ = (ORIGIN RF 24*CELLQ);
FFS;
USE RING; CELL; CALC;
RFSW; RAD; NOFLUC;
EMIT;                              ! 多周回追跡の前に 1 回: 閉軌道・規格化座標・平衡エミッタンス (EMITX, EMITY, SIGE) を作る
NORAD; NORFSW;                       ! 追跡は RF なし (z は毎周 0 に戻る): ベータトロン振動だけを見る
$FORM = "12.6";
ax = Twiss["AX","ORIGIN"]; bx = Twiss["BX","ORIGIN"]; ex = Twiss["EX","ORIGIN"]; epx = Twiss["EPX","ORIGIN"];
ay = Twiss["AY","ORIGIN"]; by = Twiss["BY","ORIGIN"];
Print["EMITX=", EMITX, " SIGE=", SIGE, " nu_x=", Twiss["NX","$$$"]/2/Pi, " nu_y=", Twiss["NY","$$$"]/2/Pi];
! 初期振幅: 水平 nsig σ (σ = Sqrt[EMITX bx]) の粒子を追跡し、毎周の規格化座標から位相の進みを出す
nt = 200;
Do[
  nsig = {1, 10, 20, 30}[[k]];
  x0 = nsig*Sqrt[EMITX*bx];
  b = {{x0},{0},{0},{0},{0},{0},{1}};
  ph = {}; inv = {};
  Do[
    X = b[[1,1]]/Sqrt[bx]; P = (ax*b[[1,1]] + bx*b[[2,1]])/Sqrt[bx];
    ph = Append[ph, ArcTan[X, -P]]; inv = Append[inv, X^2 + P^2];
    b = TrackParticles[{1, b}, 1, n, n][[2]],
    {n, 1, nt}];
  dph = Table[Mod[ph[[i+1]] - ph[[i]], 2*Pi], {i, 1, nt-1}];
  Print["amp=", nsig, " sigma (x0=", x0, ")  nu_x(tracking)=", Plus@@dph/(nt-1)/(2*Pi),
        "  smear=", (Max[inv] - Min[inv])/(Plus@@inv/nt)],
  {k, 1, 4}];
Exit;
