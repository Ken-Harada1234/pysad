MOMENTUM = 3GEV;
! FODO ring: 24 cells, 15 deg bend per cell (2*pi total), 3 GeV
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS = (L=0.1);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = ();
CAVI RF = (L=0 VOLT=1.5E6 FREQ=5.0E8 PHI=0);
LINE CELL = (SF DS QF D2 B D2 QD DS SD D1);
LINE RING = (ORIGIN RF 24*CELL);
FFS;
USE RING; CELL; CALC;
NORFSW; NORAD; NOFLUC;
$FORM = "14.8";
np = 100;
x0 = Table[1e-4*Sin[0.37*i], {i, np}];
y0 = Table[1e-4*Cos[0.23*i], {i, np}];
zero = Table[0, {i, np}];
beam = {x0, zero, y0, zero, zero, zero, Table[1, {i, np}]};
res = {};
Do[
  FFS[{"JITTER", "NOJITTER", "QUIET", "NOQUIET"}[[k]]];     ! Do の中のフラグ切り替えは FFS[...] で
  r = TrackParticles[{1, beam}, 1, 1, 10][[2]];
  res = Append[res, {Plus@@r[[1]], Plus@@r[[3]], Plus@@r[[2]]}];
  Print["case ", k, ": sum x=", Plus@@r[[1]], " sum y=", Plus@@r[[3]], " sum px=", Plus@@r[[2]]],
  {k, 1, 4}];
Print["max difference between cases: ", Max[Abs[res[[1]] - res[[2]]], Abs[res[[1]] - res[[3]]], Abs[res[[1]] - res[[4]]]]];
Exit;
