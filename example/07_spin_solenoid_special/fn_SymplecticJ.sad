MOMENTUM = 3GEV;
! FODO ring: 24 cells, 15 deg bend per cell (2*pi total), 3 GeV
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS = (L=0.1);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = ();
CAVI RF = (L=0 VOLT=1.5E6 FREQ=5.0E8 PHI=0);
LINE CELL = (SF DS QF D2 B D2 QD DS SD D1);
LINE RING = (ORIGIN RF 24*CELL);
FFS;
$FORM = "12.8";
! SymplecticJ[n] = n x n のシンプレクティック行列 J ({{0,1,..},{-1,0,..},{0,0,0,1,..},...})
J2 = SymplecticJ[2]; J4 = SymplecticJ[4]; J6 = SymplecticJ[6];
Print["J2=", J2];
Print["J4=", J4];
Print["J6=", J6];
Print["J4.J4 = ", J4.J4, "   Transpose[J4].J4 = ", Transpose[J4].J4];
! 薄い FODO セル (x-px) の 1 周行列 M は M^T J M = J (シンプレクティック条件)
Dr[l_] := {{1, l}, {0, 1}};
Qt[k_] := {{1, 0}, {-k, 1}};
M = Dr[0.5].Qt[-0.5].Dr[0.5].Dr[0.5].Qt[0.5].Dr[0.5];
Print["M=", M, " det=", M[[1,1]]*M[[2,2]] - M[[1,2]]*M[[2,1]]];
Print["M^T J2 M - J2 = ", Transpose[M].J2.M - J2];
! 4x4 (x,px,y,py): x と y が独立な (ブロック対角の) 写像でも M^T J4 M = J4
M4 = {{M[[1,1]], M[[1,2]], 0, 0}, {M[[2,1]], M[[2,2]], 0, 0}, {0, 0, M[[1,1]], M[[1,2]]}, {0, 0, M[[2,1]], M[[2,2]]}};
Print["4x4: M^T J4 M - J4 = ", Transpose[M4].J4.M4 - J4];
Exit;
