MOMENTUM = 1.7GEV;
DRIFT D1=(L=0.5) D2=(L=0.4);
QUAD QF=(L=0.3 K1=0.9) QD=(L=0.3 K1=-0.8);
SOL S0=(BOUND=0 BZ=0.8 GEO=0) SE=(BOUND=1 BZ=0.0);
MARK ST=();
LINE R=(ST S0 QF D1 QD D2 QF D1 QD D2 SE);
FFS;
USE R;
NORAD; NOFLUC;
$FORM="16.10";
n=3;
x0={1e-4,2e-4,-1e-4}; px0={1e-5,0,2e-5}; y0={5e-5,-1e-4,2e-4}; py0={0,1e-5,-1e-5}; z0={0,0,0}; dp0={0,1e-3,-1e-3}; fl0={1,1,1};
r=TrackParticles[{1,{x0,px0,y0,py0,z0,dp0,fl0}},12,1];
Print["RES ",r[[2,1]]];
Print["RES ",r[[2,2]]];
Print["RES ",r[[2,3]]];
Print["RES ",r[[2,4]]];
Print["RES ",r[[2,5]]];
Print["RES ",r[[2,6]]];
Exit;
