MOMENTUM = 3GEV;
! FODO ring: 24 cells, 15 deg bend per cell (2*pi total), 3 GeV
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS = (L=0.1);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = ();
CAVI RF = (L=0 VOLT=1.5E6 FREQ=5.0E8 PHI=0);
LINE CELL = (SF DS QF D2 B D2 QD DS SD D1);
LINE RING = (ORIGIN RF 24*CELL);

FFS;
$FORM = "14.9";
Get["DrawMagnetsDXF.n"];
USE RING;
Print["USE RING: ", LINE["LENGTH"] - 1, " elements, L = ", LINE["S", LINE["LENGTH"]], " m"];
DrawMagnetsDXF["DXF_FODO_cell_3d.dxf", Region->{"SF.1", "SD.1"}, Spec->{"B"->{Width->.5, PoleWidth->.15, Type->Ctype1, Height->.3}, "QUAD"->{Width->.36, Height->.36}, "SEXT"->{Width->.24, Height->.24}}, Mode->"3D"];
Print["  wrote DXF_FODO_cell_3d.dxf"];
DrawMagnetsDXF["DXF_FODO_cell_3d_split.dxf", Region->{"SF.1", "SD.1"}, Spec->{"B"->{Width->.5, PoleWidth->.15, Type->Ctype1, Height->.3}, "QUAD"->{Width->.36, Height->.36}, "SEXT"->{Width->.24, Height->.24}}, Mode->"3D", Parts->"split"];
Print["  wrote DXF_FODO_cell_3d_split.dxf"];
DrawMagnetsDXF["DXF_FODO_ring_3d.dxf", Mode->"3D"];
Print["  wrote DXF_FODO_ring_3d.dxf"];
Exit;
