MOMENTUM = 3GEV;
! FODO ring: 24 cells, 15 deg bend per cell (2*pi total), 3 GeV
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS = (L=0.1);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = ();
! SOL = ソレノイド領域の境界 (長さ 0)。BOUND=1 の SOL を対で置く。SA で BZ=5 T が始まり、SB で 0 に戻る。GEO=1 は片方だけ
SOL   SA = (L=0 BZ=5 BOUND=1 GEO=1) SB = (L=0 BZ=0 BOUND=1);
CAVI RF = (L=0 VOLT=1.5E6 FREQ=5.0E8 PHI=0);
LINE CELL = (SF DS QF D2 B D2 QD DS SD D1);
LINE CELLS = (SF DS QF D2 B D2 QD DS SD SA D1 SB);   ! 1 セル目の D1 (1 m) がソレノイド領域
LINE RING = (ORIGIN RF 24*CELL);
LINE RINGS = (ORIGIN RF CELLS 23*CELL);

FFS;
$FORM = "14.9";
Get["DrawMagnetsDXF.n"];
USE RINGS;
Print["USE RINGS: ", LINE["LENGTH"] - 1, " elements, L = ", LINE["S", LINE["LENGTH"]], " m"];
DrawMagnetsDXF["DXF_SOL_cells.dxf", Region->{1, 25}, TextHeight->.1];
Print["  wrote DXF_SOL_cells.dxf"];
Exit;
