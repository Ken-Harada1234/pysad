! (担当 C2) 台本の読み方: MAIN 部の代入 `NAME = 式;` と、`FFS USE RING;` の形。互換モードによらない (gs と同じ動作)。
! - MAIN の代入は、後の要素定義 (L=LD など。定義の時点の値) と FFS 部 (最後の値) の両方で使える。名前は大文字小文字を区別する。
! - MAIN の式: 数 [単位] (10 DEG、20 CM)、+ - * / ^、( )、関数 SIN COS TAN ATAN SQRT EXP LOG(常用) LN COSH、PI、前に代入した変数。
! - `FFS USE RING;` は FFS に入って USE RING。FFS の文と同じ行の残り (`FFS;NPARA=1;` の NPARA=1;) は実行されない (gs と同じ)。
! この例の C2w_main_script.pysad.txt は pysad の出力 (v2 モード。k64 モードでも同じ)。gs の出力は末尾の注釈。
MOMENTUM = 3 GEV;
LD = 1.0;                    ! ドリフトの長さ [m]
NCELL = 12;
THETA = 360 DEG/NCELL;       ! 偏向角 (1 セルに 1 台)
LB = 0.6 M + 60 CM;
KF = SQRT(0.49);
DRIFT D1 = (L=LD) D2 = (L=LD/2);
QUAD QF = (L=0.3 K1=KF) QD = (L=0.3 K1=-0.6);
BEND B = (L=LB ANGLE=THETA);
MARK ST = ();
LINE CELL1 = (QF D2 B D2 QD D1);
LINE RING = (ST 12*CELL1);
PBUNCH = 2E10;
FFS USE RING;
CELL; CALC;
$FORM = "12.8";
Print["LD = ", LD, "  THETA = ", THETA, "  LB = ", LB, "  KF = ", KF, "  NCELL = ", NCELL];
Print["L(D1) = ", LINE["L","D1"], "  ANGLE(B) = ", LINE["ANGLE","B"], "  K1(QF) = ", LINE["K1","QF"]];
Print["circumference = ", LINE["S","$$$"], "  total bend/2Pi = ", NCELL*THETA/(2 Pi), "  PBUNCH = ", PBUNCH];
Print["tunes = ", Twiss["NX","$$$"]/(2 Pi), " ", Twiss["NY","$$$"]/(2 Pi)];
Exit;
! gs (K64、2026-10-19 ビルド) の出力 (同じ台本):
!   LD =   1.00000000  THETA =    .52359878  LB =   1.20000000  KF =    .70000000  NCELL =  12.00000000
!   L(D1) =   1.00000000  ANGLE(B) =    .52359878  K1(QF) =    .70000000
!   circumference =  45.60000000  total bend/2Pi =   1.00000000  PBUNCH =  2.000000E10
!   tunes =   3.18986443   1.80541583
