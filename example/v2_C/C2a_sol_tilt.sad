! C2a: ずれて傾いたソレノイド (SOL の DX DY DPX DPY → 幾何が CHI1..3・出口の DX DY DZ を決める)、端の放射 F1、幾何の fit
! pysad v2 (既定のモード)。k64 モードでは SOL のずれ・回転は未対応 (エラー)。
MOMENTUM = 3 GEV;
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS=(L=0.25) DV=(L=0.25);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6) QS1=(L=0.2 K1=0.1) QS2=(L=0.2 K1=-0.1);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = () MS=();
CAVI RF = (L=0 VOLT=4.0E6 FREQ=5.0E8 PHI=0);
! GEO=1 の SOL に軌道の位置 (DX DY) と向き (DPX DPY) を書く。F1 は端の放射に使う長さ (0 なら端では放射しない)
SOL SA = (L=0 BZ=2 BOUND=1 GEO=1 DX=0.002 DY=-0.001 DPX=0.003 DPY=0.002 F1=0.1) SB = (L=0 BZ=0 BOUND=1 F1=0.1);
LINE CELLQ = (QF D2 B D2 QD D1);
LINE CELLS = (QF D2 B D2 QD SA DS QS1 DV QS2 DS SB MS);
LINE RINGQ = (ORIGIN RF 12*CELLQ CELLS 11*CELLQ);
FFS;
USE RINGQ;
CELL; CALC;
$FORM = "12.8";
Print["tunes (CALC)            : ", Twiss["NX","$$$"]/2/Pi, " ", Twiss["NY","$$$"]/2/Pi];
Print["closed orbit at entrance: ", Twiss[{"DX","DPX","DY","DPY"},"SA"]];
Print["orbit just inside SOL   : ", Twiss[{"DX","DPX","DY","DPY"},"SA+1"], "   (solenoid frame: DX DY of SA)"];
Print["orbit at exit           : ", Twiss[{"DX","DPX","DY","DPY"},"MS"]];
Print["geometry at MS (GX GY GZ): ", LINE[{"GX","GY","GZ"},"MS"]];
! 設計軌道の粒子と、ずれた粒子の 1 周の追跡 (放射なし)
NORAD; NOFLUC;
b = {{0, 1e-4}, {0, 0}, {0, 1e-4}, {0, 0}, {0, 0}, {0, 0}, {1, 1}};
r = TrackParticles[{1, b}, 1, 1, 1][[2]];
Print["1 turn, design particle : x=", r[[1,1]], " y=", r[[3,1]]];
Print["1 turn, 0.1 mm particle : x=", r[[1,2]], " y=", r[[3,2]]];
! Emittance (端の放射 F1 を含む)
RFSW; RAD; NORADCOD; NOFLUC;
e1 = Emittance[];
u1 = EnergyLossU0/.e1;
Element["F1","SA"] = 0; Element["F1","SB"] = 0;
e0 = Emittance[];
u0 = EnergyLossU0/.e0;
Print["emittances              : ", Emittances/.e0];
Print["U0 with F1=0.1 - F1=0   : ", u1-u0, " eV"];
! 幾何の fit: 領域の中の四極 QS1 で、出口の点 MS の高さ GZ を合わせる (変数が領域の中にあるので微分は中心差分)
NORAD;
FIT MS GZ -2.0E-4;
FREE QS1;
GO;
Print["after fit GZ at MS      : ", LINE["GZ","MS"], "  K1(QS1) = ", LINE["K1","QS1"]];
Exit;
