!@LAT 5GeV
!=====================================================================
! V0714_chrom_cell: セルごとの6 極の色収差補正 (S1・S2 を 0 にして、S3・S4 だけで合わせる)
!
! 元: chrom_v07_12rev (v07_12 の6 極を決め直した台本。chrom・chrom2・chrom3・chromA・chromN は別のリング用の旧い版で、取り込まない)。
! 流れ: S1*・S2* を 0 にして、MCELL・LCELL・MCELLA・LCELLA の順に、セルのチューンを保ったまま (FIT の NX・NY 条件)
!       DP = 0.001 (中直線部のセル) / 0.01 (長直線部のセル) で S3*・S4* を動かして色収差を合わせる。
!       最後に RING の光学を出す。
! 注意: v07_14 の6 極の最終設定 (S1・S2 が 0 でない 20231205 の再調整版) とは違う。この台本の結果 (S3・S4 の値) は
!       「S1・S2 なしで色収差だけを補正した6 極」の値で、v07_14 の最終設定ではない (元の台本は v07_12 のとき最後まで
!       動かした形跡があるが、v07_14 での結果は不明)。
!=====================================================================
NPARA = 8;
ON LOG;
ON RAD FLUC COD RFSW RADCOD;
FFS;
  $FORM = "15.10";
  PageWidth = 1999;

USE RING;
  S1* 0;
  S2* 0;
  cell calc;
SAVE;

! CellChrom[セル名, DP]: セルのチューンを保って S3*・S4* で色収差を合わせる
CellChrom[cell_, dpv_]:=(
    FFS["USE "//cell//";"];
    FFS["cell calc emit;",6];
    nxcell = Twiss["NX","$$$"]/2/Pi;
    nycell = Twiss["NY","$$$"]/2/Pi;
    FFS["FIT;"];
    FFS["NX nxcell 2;"];
    FFS["NY nycell 2;"];
    FFS["DP="//ToString[dpv]//";"];
    FFS["FREE S3*,S4*"];
    FFS["GO;",6];
    FFS["FITP 1;"];
    FFS["type S*;",6];
    FFS["SAVE"];
);
CellChrom["MCELL", 0.001];
CellChrom["LCELL", 0.01];
CellChrom["MCELLA", 0.001];
CellChrom["LCELLA", 0.01];

USE RING;
    FFS["cell calc emit;",6];
    FFS["type S*;",6];
    Print["CHK tune ", Twiss["NX","$$$"]/2/Pi, " ", Twiss["NY","$$$"]/2/Pi];
stop;
stop;
