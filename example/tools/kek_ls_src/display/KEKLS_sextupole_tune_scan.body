! KEK-LS v03_68: 六極の強さを変えたときの、運動量依存のチューンシフトの変化  (元: dp_sv_sx.sad)
! 六極 SDH・SFH の K2 を、設計値から (dsd, dsf) だけずらし (SD は + 方向、SF は + 方向)、δ = DP0 を -3%〜+3% で振って、
! チューンの設計値からのずれの絶対値の和 dtux・dtuy を求める。ずれの和が小さい点 = 運動量方向にチューンが動かない六極の組。
! 元との違い: 元は v02_42 のラティスの 6 本の六極 (SDA・SFA・SDC・SDB・SFB・SDD) を (+dsd, +dsf) と (−dsd, −dsf) でずらし、
!   dsf・dsd を -3〜3 (0.2 刻み、31×31 = 961 点) × δ 13 点。v03_68 の六極は SDH・SFH の 2 本なので、基準値をこの 2 本に直した
!   (元の台本の「best for v02_42」の値は使わない)。例は dsf・dsd = -3〜3 を 1.5 刻み (5×5 = 25 点)、δ は 1% 刻み (7 点)。
!   完全な設定: ds0 = -3; dds = 0.2; nds = 31; dd = 0.005; nd = 12。
!   USE RING → RINGC。datas.txt への書き出しは省いた。
NPARA = 8;
ON LOG;
ON RAD FLUC COD RFSW RADCOD;
FFS;
$FORM = "15.10";
PageWidth = 1999;

ds0 = -3;  dds = 1.5;  nds = 5;
dd = 0.01;  nd = 6;

USE RINGC;
cell calc emit;
nx0 = Twiss["NX","$$$"]/2/Pi;
ny0 = Twiss["NY","$$$"]/2/Pi;
sdh0 = LINE["K2","SDH"];
sfh0 = LINE["K2","SFH"];
Print["design tune ", nx0, " ", ny0, "  K2 SDH ", sdh0, "  SFH ", sfh0];
Print["columns: dsd dsf dtux dtuy   (dtu = sum over delta of |nu(delta) - nu0|)"];
Do[
  Do[
    LINE["K2","SDH"] = sdh0 + dsd;
    LINE["K2","SFH"] = sfh0 + dsf;
    dtux = 0;
    dtuy = 0;
    Do[
      DP0 = (i - nd/2) * dd;
      FFS["cell calc"];
      dtux = dtux + Abs[Twiss["NX","$$$"]/2/Pi-nx0];
      dtuy = dtuy + Abs[Twiss["NY","$$$"]/2/Pi-ny0];
    ,{i,0,nd}];
    DP0 = 0;
    Print["S ", dsd, " ", dsf, " ", dtux, " ", dtuy];
  ,{dsf,ds0,ds0+(nds-1)*dds+dds/2,dds}];
,{dsd,ds0,ds0+(nds-1)*dds+dds/2,dds}];
LINE["K2","SDH"] = sdh0;
LINE["K2","SFH"] = sfh0;
FFS["cell calc"];
Exit;
