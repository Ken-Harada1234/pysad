! DELCOR (B40・B62)、旧式の WAKE コマンド (B66)、ResponseMatrix の TRPT、MULT のスキュー成分
MOMENTUM = 3GEV;
DRIFT D1 = (L=1) D2 = (L=0.5);
QUAD QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
BEND B = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
CAVI RFC = (VOLT=1.5e6 HARM=64);
MARK ST = ();
LINE CELL1 = (QF D2 B D2 QD D1);
LINE RING = (ST 12*CELL1 RFC);
! 輸送路 (加速つき)
DRIFT DR = (L=1);
QUAD Q1 = (L=0.3 K1=0.5) Q2 = (L=0.3 K1=-0.5);
BEND ST1 = (L=0.1 K0=0) ST2 = (L=0.1 K0=0);
CAVI AC = (L=1 VOLT=1e8 FREQ=2.856e9 PHI=-1.5707963267948966) WK = (L=0.4 VOLT=0 FREQ=2.856e9);
MULT MSK = (L=0.5 K1=0.1 SK1=0.2 SK2=30);
MONI M2 = ();
MARK S0 = (BX=5 BY=5);
LINE BL = (S0 ST1 DR Q1 DR AC Q2 DR ST2 AC DR Q1 DR M2);
LINE BW = (S0 Q1 DR WK DR MSK DR);
FFS;
$FORM = "14.8";
USE RING; CELL;
DELCOR 5 1e-4 2e-4 QF QD RFC ST;
Print["DELCOR: DX of QF.1, RFC, ST = ", LINE["DX","QF.1"], " ", LINE["DX","RFC"], " ", LINE["DX","ST"], "   (v2: CAVI and MARK get DX DY too)"];
USE BL; TRPT; INS; CALC;
n = LINE["LENGTH"]; opt = {Table[Twiss["*",k], {k, 1, n}]};
st = {LINE["POSITION","ST1"], LINE["POSITION","ST2"]};
rt = ResponseMatrix[LINE["POSITION","M2"], st, st+1, opt, 0, "X"];
NOTRPT;
rn = ResponseMatrix[LINE["POSITION","M2"], st, st+1, opt, 0, "X"];
Print["ResponseMatrix: TRPT ", rt, ", NOTRPT ", rn, ", ratio ", rt[[1]]/rn[[1]], "  (Sqrt[p(steer)/p(monitor)] = Sqrt[3.0/3.2] = ", Sqrt[3.0/3.2], ")"];
USE BW; TRPT; INS; CALC; LWAKE; NORAD;
PBUNCH = 1e12;
WAKE LONGITUDINAL WK -0.1 2e9 -0.02 1e9 0 5e8 0.02 -1e9 0.1 -2e9 0.2 -1e9 ENDWAKE;
np = 100;
z0 = Table[0.01 Sin[0.13 i], {i, np}];
zz = Table[0, {np}];
r = TrackParticles[{1, {zz, zz, zz, zz, z0, zz, Table[1, {np}]}}, "$$$", 1, 1];
Print["WAKE command: mean dp after the cavity = ", Plus@@r[[2,6]]/np];
Print["MULT with SK1 SK2: R1 at the end = ", Twiss["R1","$$$"], "  (the skew components were ignored before)"];
Exit;
