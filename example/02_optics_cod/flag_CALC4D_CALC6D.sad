MOMENTUM = 3GEV;
! FODO ring: 24 cells, 15 deg bend per cell (2*pi total), 3 GeV
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS = (L=0.1);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = ();
CAVI RF = (L=0 VOLT=1.5E6 FREQ=5.0E8 PHI=0);
LINE CELL = (SF DS QF D2 B D2 QD DS SD D1);
LINE RING = (ORIGIN RF 24*CELL);
FFS;
$FORM = "10.6";
USE RING; CELL; CALC;
em = Emittance[];
Print["CALC4D: Tunes from Emittance (x,y,s) = ", Tunes/.em];
Print["CALC4D: NX NY /2pi = ", Twiss["NX","$$$"]/2/Pi, " ", Twiss["NY","$$$"]/2/Pi, "  EX at 1 = ", Twiss["EX",1], "  DZ at 1 = ", Twiss["DZ",1]];
Print["CALC4D: NZ BZ at end = ", Twiss["NZ","$$$"], " ", Twiss["BZ","$$$"]];
RFSW;
CALC6D;
CALC;
Print["CALC6D: NX NY NZ /2pi = ", Twiss["NX","$$$"]/2/Pi, " ", Twiss["NY","$$$"]/2/Pi, " ", Twiss["NZ","$$$"]/2/Pi];
Print["CALC6D: EX at 1 = ", Twiss["EX",1], "  DZ at 1 = ", Twiss["DZ",1], "  BZ AZ at 1 = ", Twiss["BZ",1], " ", Twiss["AZ",1]];
MATRIX ORIGIN $$$;
Exit;
