MOMENTUM = 3GEV;
! FODO ring: 24 cells, 15 deg bend per cell (2*pi total), 3 GeV
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS = (L=0.1);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = ();
CAVI RF = (L=0 VOLT=1.5E6 FREQ=5.0E8 PHI=0);
LINE CELL = (SF DS QF D2 B D2 QD DS SD D1);
LINE RING = (ORIGIN RF 24*CELL);
FFS;
$FORM = "10.6";
USE RING; CELL; CALC;
MATRIX SF.1 SF.2;
MATRIX PHYSICAL SF.1 SF.2;
MATRIX QF.1 QD.1;
m = TransferMatrix["SF.1","SF.2"];
Print["trace x = ", m[[1,1]]+m[[2,2]], "  trace y = ", m[[3,3]]+m[[4,4]]];
Print["det x   = ", m[[1,1]]*m[[2,2]]-m[[1,2]]*m[[2,1]], "  det y = ", m[[3,3]]*m[[4,4]]-m[[3,4]]*m[[4,3]]];
Print["cell phase advance x,y /2pi = ", (Twiss["NX","SF.2"]-Twiss["NX","SF.1"])/2/Pi, " ", (Twiss["NY","SF.2"]-Twiss["NY","SF.1"])/2/Pi];
MATRIX ORIGIN $$$;
Exit;
