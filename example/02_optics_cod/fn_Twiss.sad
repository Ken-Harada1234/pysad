MOMENTUM = 3GEV;
! FODO ring: 24 cells, 15 deg bend per cell (2*pi total), 3 GeV
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS = (L=0.1);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = ();
CAVI RF = (L=0 VOLT=1.5E6 FREQ=5.0E8 PHI=0);
LINE CELL = (SF DS QF D2 B D2 QD DS SD D1);
LINE RING = (ORIGIN RF 24*CELL);
FFS;
$FORM = "10.6";
USE RING; CELL; CALC;
Print["BX at QF.1, QD.1, B.1        = ", Twiss["BX",{"QF.1","QD.1","B.1"}]];
Print["BX at 5 (QF.1), 5.5, 6 (D2.1) = ", Twiss["BX",{5,5.5,6}]];
Print["EX EPX at B.1 (entrance)     = ", Twiss["EX","B.1"], " ", Twiss["EPX","B.1"]];
Print["ALL at ORIGIN                = ", Twiss["ALL","ORIGIN"]];
Print["NX NY at $$$ /2pi            = ", Twiss["NX","$$$"]/2/Pi, " ", Twiss["NY","$$$"]/2/Pi];
Print["GMX at QF.1 (=(1+AX^2)/BX)   = ", Twiss["GMX","QF.1"], " ", (1+Twiss["AX","QF.1"]^2)/Twiss["BX","QF.1"]];
Print["PEX (physical dispersion) at QF.1 = ", Twiss["PEX","QF.1"]];
Print["LENGTH GAMMA = ", Twiss["LENGTH"], " ", Twiss["GAMMA",1]];
Print["number of BX values = ", Length[Twiss["BX"]]];
Print["max BX max BY = ", Max[Twiss["BX"]], " ", Max[Twiss["BY"]]];
Print["BX at all QF.* (count) = ", Length[Twiss["BX","QF.*"]]];
Exit;
