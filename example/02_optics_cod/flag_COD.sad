MOMENTUM = 3GEV;
! FODO_ring.sad と同じ光学で、ずれのある四極を 2 台入れたリング (誤差入りの閉軌道用、乱数なし)
! QFX (セル 1 の QF):  DX=+0.1 mm, DY=-0.2 mm      QDX (セル 13 の QD):  DY=+0.3 mm
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS = (L=0.1);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
QUAD  QFX = (L=0.3 K1=0.7 DX=1.0E-4 DY=-2.0E-4);
QUAD  QDX = (L=0.3 K1=-0.6 DY=3.0E-4);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = ();
CAVI RF = (L=0 VOLT=1.5E6 FREQ=5.0E8 PHI=0);
LINE CELL = (SF DS QF D2 B D2 QD DS SD D1);
LINE CELLX = (SF DS QFX D2 B D2 QD DS SD D1);
LINE CELLY = (SF DS QF D2 B D2 QDX DS SD D1);
LINE RING = (ORIGIN RF CELLX 11*CELL CELLY 11*CELL);
FFS;
! 誤差入りリング: ずれのある四極 QFX (DX=0.1mm DY=-0.2mm) と QDX (DY=0.3mm) による閉軌道
$FORM = "10.6";
USE RING; CELL; CALC;
pq = LINE["POSITION","QDX"];
ps = {1, 5, 6, 50, pq, pq+1, 200};
Print["positions = ", ps];
Print["COD ON : tune NX NY = ", Twiss["NX","$$$"]/2/Pi, " ", Twiss["NY","$$$"]/2/Pi];
Print["COD DX = ", Twiss["DX",ps]];
Print["COD DY = ", Twiss["DY",ps]];
Print["COD DPX = ", Twiss["DPX",ps]];
Print["COD DPY = ", Twiss["DPY",ps]];
Print["max |DX| max |DY| = ", Max[Abs[Twiss["DX"]]], " ", Max[Abs[Twiss["DY"]]]];
NOCOD;
CALC;
Print["COD OFF: DX = ", Twiss["DX",ps], "  DY = ", Twiss["DY",ps]];
Print["COD OFF: tune NX NY = ", Twiss["NX","$$$"]/2/Pi, " ", Twiss["NY","$$$"]/2/Pi];
COD;
CALC;
Print["COD ON : DX = ", Twiss["DX",ps], "  DY = ", Twiss["DY",ps]];
Exit;
