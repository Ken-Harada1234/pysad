MOMENTUM = 3GEV;
! FODO ring: 24 cells, 15 deg bend per cell (2*pi total), 3 GeV
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS = (L=0.1);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = ();
CAVI RF = (L=0 VOLT=1.5E6 FREQ=5.0E8 PHI=0);
LINE CELL = (SF DS QF D2 B D2 QD DS SD D1);
LINE RING = (ORIGIN RF 24*CELL);
FFS;
$FORM = "10.6";
USE RING; CELL; CALC;
m = TransferMatrix["SF.1","SF.2"];
Print["TransferMatrix size = ", Dimensions[m]];
Print["row1 = ", m[[1]]];
Print["row2 = ", m[[2]]];
mi = TransferMatrix["SF.2","SF.1"];
Print["inverse check: M11,M12 of M*Minv = ", (m.mi)[[1,1]], " ", (m.mi)[[1,2]]];
RF VOLT 6.0E6;
CALC;
RFSW; RAD; NOFLUC;
EMIT;
b = BeamMatrix[1];
Print["BeamMatrix size = ", Dimensions[b]];
Print["sqrt(b11) sqrt(b33) sqrt(b66) = ", Sqrt[b[[1,1]]], " ", Sqrt[b[[3,3]]], " ", Sqrt[b[[6,6]]]];
Print["EMITX EMITY SIGE = ", EMITX, " ", EMITY, " ", SIGE];
Print["DP (special variable) = ", DP, "   b66 = ", b[[6,6]]];
Print["EMITX*BX + (EX*SIGE)^2 = ", EMITX*Twiss["BX",1]+(Twiss["EX",1]*SIGE)^2, "   EMITX*BX + (EX*DP)^2 = ", EMITX*Twiss["BX",1]+(Twiss["EX",1]*DP)^2, "   b11 = ", b[[1,1]]];
Exit;
