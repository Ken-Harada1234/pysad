MOMENTUM = 3GEV;
! FODO ring: 24 cells, 15 deg bend per cell (2*pi total), 3 GeV
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS = (L=0.1);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = ();
CAVI RF = (L=0 VOLT=1.5E6 FREQ=5.0E8 PHI=0);
LINE CELL = (SF DS QF D2 B D2 QD DS SD D1);
LINE RING = (ORIGIN RF 24*CELL);
FFS;
! 誤差コマンド DELX DELY DTHETA DL DK DDK と DUMP (UNIFORM は乱数なし)
$FORM = "10.6";
USE RING; CELL; CALC;
DELX UNIFORM 1E-4 QF.1|QF.2;
DELY UNIFORM -2E-4 QF.1|QD.3;
DTHETA UNIFORM 1E-3 QD.2;
DL UNIFORM 1E-3 D1.1;
DK UNIFORM 1E-3 QF.3;
DDK UNIFORM 1E-5 B.1;
DUMP QF.1|QF.2|QF.3|QD.2|QD.3|D1.1|B.1|Q*.4;
! 乱数の誤差 (種を固定)
SeedRandom[7];
DELX 1E-4 SF.*;
DUMP SF.1|SF.2|SF.3;
Exit;
