MOMENTUM = 3GEV;
! FODO ring: 24 cells, 15 deg bend per cell (2*pi total), 3 GeV
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS = (L=0.1);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = ();
CAVI RF = (L=0 VOLT=1.5E6 FREQ=5.0E8 PHI=0);
LINE CELL = (SF DS QF D2 B D2 QD DS SD D1);
LINE RING = (ORIGIN RF 24*CELL);
FFS;
$FORM = "10.6";
USE RING; CELL; CALC;
CHRO;
nx0 = Twiss["NX","$$$"]/2/Pi; ny0 = Twiss["NY","$$$"]/2/Pi;
dd = 1E-4;
DP0 = dd;  CALC; nxp = Twiss["NX","$$$"]/2/Pi; nyp = Twiss["NY","$$$"]/2/Pi;
DP0 = -dd; CALC; nxm = Twiss["NX","$$$"]/2/Pi; nym = Twiss["NY","$$$"]/2/Pi;
Print["tune at DP0=0     : ", nx0, " ", ny0];
Print["tune at DP0=+1e-4 : ", nxp, " ", nyp];
Print["tune at DP0=-1e-4 : ", nxm, " ", nym];
Print["xi (finite diff)  : ", (nxp-nxm)/(2*dd), " ", (nyp-nym)/(2*dd)];
DP0 = 0;
SF K2 5; SD K2 -8;
CALC;
CHRO;
DP0 = dd;  CALC; nxp = Twiss["NX","$$$"]/2/Pi; nyp = Twiss["NY","$$$"]/2/Pi;
DP0 = -dd; CALC; nxm = Twiss["NX","$$$"]/2/Pi; nym = Twiss["NY","$$$"]/2/Pi;
Print["with sextupoles xi (finite diff): ", (nxp-nxm)/(2*dd), " ", (nyp-nym)/(2*dd)];
Exit;
