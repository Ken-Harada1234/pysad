! PUTMEASURE / GETMEASURE (測定値の保存と読み戻し) と、LWAKE ON の MEASURE
! 条件: 1 GeV の輸送路。NP=1000。測定値は環境変数 SADPOUT / SADPIN のファイル (ここでは fn_PUTMEASURE_GETMEASURE.measure.dat) で受け渡す。
! K64 (gs) では MEASURE が無出力なので gs の参照は無い。
MOMENTUM = 1 GEV;
MARK M0 = (BX=8 BY=3 AX=0.5 AY=-0.3 DX=2E-4 DY=-1E-4 EMITX=1E-9 EMITY=1E-10 DP=1E-4 SIGZ=3E-3) WK=() IP=();
DRIFT D1 = (L=1.0);
QUAD QF = (L=0.3 K1=0.25) QD=(L=0.3 K1=-0.25);
BEND ST=(L=0 ANGLE=0 K0=0);
LINE TL = (M0 QF D1 ST WK D1 QD D1 IP D1);
FFS;
USE TL;
INS; CALC;
NP=1000; GAUSS; NORAD; NOFLUC;
f=OpenWrite["fn_PUTMEASURE_GETMEASURE.measure.dat"]; Close[f];          ! 空にする (PUTMEASURE は追記)
Environment["SADPOUT","fn_PUTMEASURE_GETMEASURE.measure.dat"];
Environment["SADPIN","fn_PUTMEASURE_GETMEASURE.measure.dat"];
! --- 1. 「相手のビーム」の測定値を書く
r=FFS["MEASURE IP"];                     ! 表示なしで測る (FFS[] の既定の出力先は 0)
PUTMEASURE;
LOGMEASURE;
! --- 2. 自分のビーム (ステアリングを変えた) を測り、相手の値を読んで fit の目標値にする
ST K0 5E-5;
r=FFS["MEASURE IP"];                     ! 表示なしで測る (FFS[] の既定の出力先は 0)
LOGMEASURE;
FIT IP; DX 0; DY 0;
r=FFS["GETMEASURE"];
Print["GETMEASURE returns ",r];
SHOW;
! --- 3. LWAKE ON の MEASURE: 一様な縦ウェイク 1e12 V/C、1e10 個: 重心の dp/p0 は e N W/(p0 c) = 1.602177e-6 だけ下がる
PBUNCH=1E10; NBUNCH=1;
WakeFunction[Longitudinal,"WK"]={{-1,1E12},{0,1E12},{1,1E12},{2,1E12}};
r0=FFS["MEASURE IP"];
LWAKE;
r1=FFS["MEASURE IP"];
NOLWAKE;
$FORM="14.7";
Print["LWAKE: change of <dp/p0> = ",r1[[2,6]]-r0[[2,6]],"  (analytic -1.602177E-6)"];
STOP;
