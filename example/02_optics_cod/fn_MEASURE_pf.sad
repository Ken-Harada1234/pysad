! MEASURE / TRCOD の gs との比較 (PF リング (2.5 GeV、187 m))。このファイルは台本の後半だけ: 先頭に example/pf/lattice/v9_16_asym.sad を連結して走らせる。
! 先頭に MARK ORG0 を足したリングで、ORG0 の位置の MEASURE (gs が出力する唯一の位置)・LOGMEASURE・TRCOD を gs と比べる。k64 は gs と全桁一致。
MARK ORG0 = ();
LINE RINGM = (ORG0 RING);
FFS;
EMITX=3e-8; EMITY=3e-10; SIGZ=5e-3; DP=1e-3;
USE RINGM; CELL; CALC;
NP=400;
MEASURE ORG0;
LOGMEASURE;
GAUSS; MEASURE ORG0;
NOGAUSS;
Print["R1 ", Twiss["NX","$$$"]/(2Pi), " ", Twiss["NY","$$$"]/(2Pi)];
MEASURE $$$;
Print["R2 ", FFS["MEASURE $$$"][[1]]];
TRCOD ORG0;
Print["DX ", Twiss["DPY",1]];
Exit;
