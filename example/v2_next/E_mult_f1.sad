! v2next E 項目 2: MULT の F1・F2・F1K1F・F1K1B・FRINGE (四極の線形フリンジ tqlfre)・K0 つきの FB1・FB2 (tbfrme の線形フリンジ) の Emittance[] と CALC。
! 旧 pysad は F1・FRINGE があると NotImplementedError (FB1・FB2 は黙って無視) だった。tmulte の入口 (tqfrie, tbfrme(fb1), tqlfre(f1in, f2in)、そのあと tradke(f1in) か tsetr0)、
! 出口 (tqlfre(-f1out, f2out), tbfrme(fb2), tqfrie, tradke(f1out)) を入れた。F1 は K1≠0 のときだけ効く (tsetfringepe)。
! 条件: 3 GeV、周長 45.6 m の 12 セル FODO、QF・QD を MULT (K1 = 0.7・-0.6、K0 = +-4e-4、F1 = 0.05 など) に替えたもの、RF 3 MV・h=64。
! k64 モード (PYSAD_COMPAT=k64) は gs と全桁一致 (表示 10 桁)。K0・FB1・FB2 つきは tbfrme の線形フリンジ (tbfrmle) の行列も K64 のとおり。
MOMENTUM = 3GEV;
DRIFT D1 = (L=1) D2 = (L=0.5);
MULT QF = (L=0.3 K1=0.7 F1=0.05 FRINGE=3 K0=0.0004 FB1=0.03 FB2=0.02);
MULT QD = (L=0.3 K1=-0.6 F1=0.05 FRINGE=3 K0=-0.0004 FB1=0.03 FB2=0.02);
BEND B = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
CAVI RFC = (L=0 VOLT=3e6 HARM=64);
MARK ST = ();
LINE CELL1 = (QF D2 B D2 QD D1);
LINE RING = (ST 12*CELL1 RFC);
FFS;
$FORM="14.10";
USE RING; CELL; CALC;
Print["CALC tunes ", Twiss["NX","$$$"]/(2Pi), " ", Twiss["NY","$$$"]/(2Pi)];
NORFSW; NORAD;
e = Emittance[];
Print["noRF Tunes ", Tunes/.e];
RFSW; RAD; NOFLUC;
e = Emittance[];
Print["Tunes ", Tunes/.e];
Print["U0 ", EnergyLossU0/.e, " alpha ", MomentumCompaction/.e, " EqPos ", EquilibriumPosition/.e];
Print["Emittances ", Emittances/.e];
Print["Damp ", DampingRate/.e];
Exit;
