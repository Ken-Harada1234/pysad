! v2next P4 項目 4: 追跡の WSPAC のビーム行列。gs (K64) は `CODPLOT; WSPAC; EMIT;` のあとの追跡で EMIT の最後の一周のビーム行列 (beamsize) を使う。
! 結合のある 0.5 GeV の電子リング (8 セル、周長 35.3 m、弱いスキュー四極 QS。example/v2_C/C2s_wspac.sad と同じ)、2e10 個。試験粒子のチューンシフト:
!   gs: (−2.938e-5、−1.210e-3)。v2 の既定 (ゼロ電流のビーム行列): (−2.982e-5、−1.201e-3) = gs と x 1.5%・y 0.7%。
!   v2 の WSPACSC = 1 (空間電荷つきの自己無撞着な行列。MINCOUP の下限つき): (−2.776e-5、−3.807e-4) = gs と合わない。MINCOUP = 1e-9 (下限なし): (−2.982e-5、−1.200e-3)。
!   (gs は WSPACSC を使わない: 下の 3 つの結果は gs では同じ値。K64 の追跡のビーム行列には MINCOUP の下限が入らない: 平らなリングは gs が NaN)
! 条件: 0.5 GeV、結合あり (εy/εx = 8e-4)。実機の大きなリングでは確かめていない。
MOMENTUM = 0.5GEV;
DRIFT D1 = (L=0.5);
BEND  B1 = (L=1.0 ANGLE=0.39269908169872414);
QUAD  QF = (L=0.2 K1=0.5) QD = (L=0.2 K1=-0.5) QS = (L=0.1 K1=0.02 ROTATE=45 DEG);
CAVI  CA = (VOLT=0.2MV HARM=20 PHI=0);
MARK  ORIGIN = ();
LINE CELL = (QF D1 B1 D1 QD D1 B1 D1);
LINE RING = (ORIGIN CA QS 8*CELL);
FFS;
NPARA = 1;
RFSW; RAD; NOFLUC; RADCOD;
USE RING; CELL; CALC;
$FORM = "12.6";
PBUNCH = 2e10;
dd = 1e-7; zero5 = {0, 0, 0, 0, 0};
trk[] := TrackParticles[{1, {{0, dd, 0, 0, 0}, {0, 0, dd, 0, 0}, {0, 0, 0, dd, 0}, {0, 0, 0, 0, dd}, zero5, zero5, {1, 1, 1, 1, 1}}}, 1, 1, 1][[2]];
tune[] := Module[{r = trk[]},
  {ArcCos[((r[[1, 2]]-r[[1, 1]]) + (r[[2, 3]]-r[[2, 1]]))/(2*dd)]/(2*Pi), ArcCos[((r[[3, 4]]-r[[3, 1]]) + (r[[4, 5]]-r[[4, 1]]))/(2*dd)]/(2*Pi)}];
NORAD; NORADCOD;
nu0 = tune[];
Print["BARE ", nu0[[1]], " ", nu0[[2]]];
RAD; RADCOD;
CODPLOT; WSPAC; EMIT;
NORAD; NORADCOD;
nu1 = tune[];
Print["WSPAC default (zero-current matrix)  dnu = ", nu1[[1]]-nu0[[1]], " ", nu1[[2]]-nu0[[2]]];
WSPACSC = 1;
nu2 = tune[];
Print["WSPACSC=1 (SC matrix, MINCOUP 1e-2)  dnu = ", nu2[[1]]-nu0[[1]], " ", nu2[[2]]-nu0[[2]]];
MINCOUP = 1e-9;
nu3 = tune[];
Print["WSPACSC=1, MINCOUP=1e-9 (no floor)   dnu = ", nu3[[1]]-nu0[[1]], " ", nu3[[2]]-nu0[[2]]];
Exit;
