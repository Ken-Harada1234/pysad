!********************************************************************
!*
!*   ASTRID2 - THE ULTIMATE SYNCHROTRON RADIATION SOURCE
!*   http://www.isa.au.dk/facilities/astrid2/astrid2.asp
!*
!********************************************************************

MOMENTUM= 0.58 GEV;

MARK
	MKS   =()
	MKE   =()
;

MONI
	PM     =()
;

CAVI
	CAVI=(VOLT= 50000 FREQ = 104950000)
;

BEND
	PV = ( L = 0    K0 = 0     ROTATE =-90 DEG ) 
	PH = ( L = 0    K0 = 0  )
;

QUAD
	QF3 = ( L =0.1800 K1 =5.939500*0.1800 )
	QF2 = ( L =0.1800 K1 =6.070000*0.1800 )
;

SEXT
	SF = ( L =0.0750   K2 =   125.62*0.0750 )
	SD = ( L =0.1500   K2 =   -81.93*0.15 )
;

BEND
	BH = (L = 0.8500 ANGLE = 0.523599 K1 = -1.678200*0.8500  E1=0 E2=0)
;

DRIFT
	D14837    = (L = 1.4837 )
        D14837MPW = (L = 0.5212 )
	D0100     = (L = 0.1000 )
	D0180     = (L = 0.1800 )
	D0190     = (L = 0.1900 )
	D0120     = (L = 0.1200 )

;

LINE
	HV    = (PH PV)
	NCELL
	=(MKS
	  D14837 PM D0100 QF3  D0180 HV D0180 
          BH 
          D0190 SD D0120 QF2 D0120 SF
          PM
	  SF D0120 QF2 D0120 SD D0190 
          BH D0180 HV D0180 QF3 D0100 PM D14837
          MKE) 

	RING = (3*NCELL CAVI 3*NCELL)
!	RING = (6*CELL)
;

 SEXT   SD      =(L =.15  K2 =-11.729486011842393 )
        SF      =(L =.075 K2 =8.681418961367605 )
 ;
 BEND

! Kmpw = 32.7
! lmpw = 0.175 [m]
! Bmax = 2 [T]
! rhomin = 0.9660907010809813 [m] 
! theta (average) / pole = lmpw / 2 / (Sqrt[2] * rhomin) = 0.0640435140143602

       BMPW1I = ( L = .175/4 K0 =  0.0640435140143602/2           E2 =1)
       BMPW1  = ( L = .175/2 K0 =  0.0640435140143602    E1 =.5    E2 =.5)
       BMPW2  = ( L = .175/2 K0 = -0.0640435140143602    E1 =.5    E2 =.5)
       BMPW1F = ( L = .175/4 K0 =  0.0640435140143602/2  E1 =1)
 ;
 MARK   MMPWS = ()
        MMPWE = ()
 ;
 LINE   PMPW = (BMPW1 BMPW2)
        MPW  = (MMPWS BMPW1I BMPW2 10*PMPW BMPW1F MMPWE)
        TCELL
             =(MKS
              D14837 PM D0100 QF3  D0180 HV D0180
              BH
              D0190 SD D0120 QF2 D0120 SF
              PM
              SF D0120 QF2 D0120 SD D0190
              BH D0180 HV D0180 QF3 D0100 PM D14837MPW
              MPW
              D14837MPW PM D0100 QF3  D0180 HV D0180
              BH
              D0190 SD D0120 QF2 D0120 SF
              PM
              SF D0120 QF2 D0120 SD D0190
              BH D0180 HV D0180 QF3 D0100 PM D14837
              MKE)

        RINGMPW = (2*NCELL CAVI TCELL 2*NCELL) 
 ;

! ---- v2next A2 項目 2・3: MPW (逆向きの極) 入り ASTRID2 (0.58 GeV、周長 45.7 m) の RADINT と Polarization ----
! K64: RADINT は K0 の極 (ANGLE=0 の BEND) を無視する (U0 6.17 keV、I2 = 3.870)。Polarization は NaN、PolarizationTime は符号つきの率 1/sdamp (28842 s)。
! v2: RADINT が K0 の極を入れる (U0 7.81 keV、Emittance[] と 1e-3)。Polarization = 0.7019、τ = 21915 s
!    (独立な式 P = (8/5√3)<ρ^-3>/<|ρ|^-3> = 0.7016、1/τ = (5√3/8) r_e ƛ γ^5 c <|ρ|^-3> -> 21886 s)。
FFS;
$FORM = "16.10";
USE RINGMPW; CELL; CALC;
RFSW; RAD; NOFLUC; POL;
em = Emittance[];
Print["Polarization, PolarizationTime [s] = ", {Polarization, PolarizationTime}/.em];
Print["EnergyLossU0 [eV], Emittances = ", {EnergyLossU0, Emittances}/.em];
RADINT;
Exit;
