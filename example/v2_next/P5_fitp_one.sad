! v2next P5 項目 6: FITP>1 を FITP 1 (オフモメンタムなし) と比べる基準。12 セル FODO、同じ条件で FITP 1。
MOMENTUM = 3GEV;
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS = (L=0.1);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = ();
CAVI RF = (L=0 VOLT=1.5E6 FREQ=5.0E8 PHI=0);
LINE CELL = (SF DS QF D2 B D2 QD DS SD D1);
LINE RING = (ORIGIN RF 12*CELL);
FFS;
$FORM = "10.6";
USE RING; CELL; CALC;
FREE QF QD SF SD;
DP = 0.01;
FIT $$$;
NX 3.4;
NY 2.5;
GO;
Print["after GO: K1 QF QD = ", LINE["K1","QF.1"], " ", LINE["K1","QD.1"], "  K2 SF SD = ", LINE["K2","SF.1"], " ", LINE["K2","SD.1"]];
Exit;
