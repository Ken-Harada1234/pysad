! v2next A1 項目 1 (N12): INS の CALC の後の Twiss["DETR"] (結合行列の行列式)。旧 pysad は 0 を返した (k64・v2 とも、pysad 自身の不具合)。
! 条件: 3 GeV、12 セル FODO のリングに 45 度回した四極 QS (K1=0.8) を 1 個入れた結合リング (周長 約 43 m)。gs と同じ値になる。
MOMENTUM = 3GEV;
DRIFT D1 = (L=1) D2 = (L=0.5);
QUAD QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
QUAD QS = (L=0.2 K1=0.8 ROTATE=0.7853981633974483);
BEND B = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK ST = (); MARK M2 = ();
LINE CELL1 = (QF D2 B D2 QD D1);
LINE RING = (ST 11*CELL1 QS M2 CELL1);
FFS;
$FORM = "14.8";
USE RING; CELL; CALC;
Print["CELL  CALC: DETR(M2) = ", Twiss["DETR","M2"], "  R1 = ", Twiss["R1","M2"]];
INS; CALC;
Print["INS   CALC: DETR(M2) = ", Twiss["DETR","M2"], "  R1 = ", Twiss["R1","M2"], "   (R1*R4-R2*R3 = ", Twiss["R1","M2"]*Twiss["R4","M2"]-Twiss["R2","M2"]*Twiss["R3","M2"], ")"];
Exit;
