! v2next P4 項目 3 (大きなリングでの確認): ASTRID2 (0.58 GeV、周長 45.7 m、ASTRID2_v01_01.sad) に SPCH を 3 か所 (始点・RF の前・終点) 置き、PBUNCH = 1e14 (非現実的に大きい。K64 の PSPAC の数値の一致を見るため)、
! 10 周の rms を gs と pysad k64 で比べる。k64 は gs と 11 桁以上一致 (NOSC は PSPAC なし)。v2 は別の形状関数で 8% (x) 違う。
! 条件: 4096 粒子、半径 0.3 mm の一様な円・長さ 0.03 m、PSPACDX = 3e-5、PSPACNZ = 32、PSPACDZ = 3 mm、PSPACNTURN = 10。gs は先頭が MARK でないとエラー (The first element must be a MARK element)。
!********************************************************************
!*
!*   ASTRID2 - THE ULTIMATE SYNCHROTRON RADIATION SOURCE
!*   http://www.isa.au.dk/facilities/astrid2/astrid2.asp
!*
!********************************************************************

MOMENTUM= 0.58 GEV;

MARK
	MKS   =()
	MKE   =()
;

MONI
	PM     =()
;

CAVI
	CAVI=(VOLT= 50000 FREQ = 104950000)
;

BEND
	PV = ( L = 0    K0 = 0     ROTATE =-90 DEG ) 
	PH = ( L = 0    K0 = 0  )
;

QUAD
	QF3 = ( L =0.1800 K1 =5.939500*0.1800 )
	QF2 = ( L =0.1800 K1 =6.070000*0.1800 )
;

SEXT
	SF = ( L =0.0750   K2 =   125.62*0.0750 )
	SD = ( L =0.1500   K2 =   -81.93*0.15 )
;

BEND
	BH = (L = 0.8500 ANGLE = 0.523599 K1 = -1.678200*0.8500  E1=0 E2=0)
;

DRIFT
	D14837    = (L = 1.4837 )
	D0100     = (L = 0.1000 )
	D0180     = (L = 0.1800 )
	D0190     = (L = 0.1900 )
	D0120     = (L = 0.1200 )
;

LINE
	HV    = (PH PV)
	NCELL
	=(MKS
	  D14837 PM D0100 QF3  D0180 HV D0180 
          BH 
          D0190 SD D0120 QF2 D0120 SF
          PM
	  SF D0120 QF2 D0120 SD D0190 
          BH D0180 HV D0180 QF3 D0100 PM D14837
          MKE) 

	RING = (3*NCELL CAVI 3*NCELL)
        RINGMPW = (3*NCELL CAVI 3*NCELL)
!	RING = (6*CELL)
;
 SEXT   SD      =(L =.15  K2 =-11.729486011842393 )
        SF      =(L =.075 K2 =8.681418961367605 )
 ;

SPCH SPC = ();
LINE RSP = (MKS SPC 3*NCELL SPC CAVI 3*NCELL SPC);
FFS;
NPARA = 1; RFSW; NORAD; NOFLUC;
USE RSP; CELL; CALC;
PBUNCH = 1e14;
PSPACNX = 128; PSPACNY = 128; PSPACDX = 3e-5; PSPACDY = 3e-5; PSPACNZ = 32; PSPACDZ = 0.003;
PSPACNTURN = 10; PSPACNTURNCALC = 0;
a = 3e-4; n = 4096; lb = 0.03;
u = Table[Mod[i*0.6180339887, 1], {i,1,n}];
v = Table[Mod[i*0.7548776662, 1], {i,1,n}];
w = Table[Mod[i*0.5698402910, 1], {i,1,n}];
rms[l_] := Sqrt[Plus@@(l^2)/Length[l]];
$FORM = "20.14";
bm = {a*Sqrt[u]*Cos[2*Pi*v], Table[0,{n}], a*Sqrt[u]*Sin[2*Pi*v], Table[0,{n}], lb*(w-0.5), Table[0,{n}], Table[1,{n}]};
r0 = TrackParticles[{1,bm},1,1,10];
Print["NOSC RMS ", rms[r0[[2,1]]], " ", rms[r0[[2,3]]], " ", rms[r0[[2,2]]], " ", rms[r0[[2,4]]], " ", Plus@@(r0[[2,6]])/n, " ", rms[r0[[2,6]]]];
PSPAC;
r = TrackParticles[{1,bm},1,1,10];
Print["PSPAC RMS ", rms[r[[2,1]]], " ", rms[r[[2,3]]], " ", rms[r[[2,2]]], " ", rms[r[[2,4]]], " ", Plus@@(r[[2,6]])/n, " ", rms[r[[2,6]]]];
Exit;
