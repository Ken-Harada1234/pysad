MOMENTUM = 3GEV;
! v2next D2: 12 セルの FODO (3 GeV、周長 52.8 m)。BPM (BAk・BBk)、水平・垂直ステアラ (SHk・SVk)、四極の据え付け誤差 DX・DY を式 (SIN, PI) で与える (MAIN の式の読み方の確認も兼ねる)
DRIFT D2 = (L=0.5) DS = (L=0.1) D1S = (L=0.8);
QUAD  QD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0);
BEND  B  = (L=1.2 ANGLE=PI/12 E1=PI/24 E2=PI/24);
MARK  ORIGIN = ();
CAVI RF = (L=0 VOLT=1.5E6 FREQ=5.0E8 PHI=0);
QUAD QF1 = (L=0.3 K1=0.7 DX=1E-4*SIN(1*1.7) DY=1E-4*SIN(1*2.9+0.5));
BEND SH1 = (L=0.1 ANGLE=0) SV1 = (L=0.1 ANGLE=0 ROTATE=PI/2);
MARK BA1 = () BB1 = ();
LINE C1 = (SF DS QF1 BA1 D2 B D2 QD BB1 DS SD SH1 SV1 D1S);
QUAD QF2 = (L=0.3 K1=0.7 DX=1E-4*SIN(2*1.7) DY=1E-4*SIN(2*2.9+0.5));
BEND SH2 = (L=0.1 ANGLE=0) SV2 = (L=0.1 ANGLE=0 ROTATE=PI/2);
MARK BA2 = () BB2 = ();
LINE C2 = (SF DS QF2 BA2 D2 B D2 QD BB2 DS SD SH2 SV2 D1S);
QUAD QF3 = (L=0.3 K1=0.7 DX=1E-4*SIN(3*1.7) DY=1E-4*SIN(3*2.9+0.5));
BEND SH3 = (L=0.1 ANGLE=0) SV3 = (L=0.1 ANGLE=0 ROTATE=PI/2);
MARK BA3 = () BB3 = ();
LINE C3 = (SF DS QF3 BA3 D2 B D2 QD BB3 DS SD SH3 SV3 D1S);
QUAD QF4 = (L=0.3 K1=0.7 DX=1E-4*SIN(4*1.7) DY=1E-4*SIN(4*2.9+0.5));
BEND SH4 = (L=0.1 ANGLE=0) SV4 = (L=0.1 ANGLE=0 ROTATE=PI/2);
MARK BA4 = () BB4 = ();
LINE C4 = (SF DS QF4 BA4 D2 B D2 QD BB4 DS SD SH4 SV4 D1S);
QUAD QF5 = (L=0.3 K1=0.7 DX=1E-4*SIN(5*1.7) DY=1E-4*SIN(5*2.9+0.5));
BEND SH5 = (L=0.1 ANGLE=0) SV5 = (L=0.1 ANGLE=0 ROTATE=PI/2);
MARK BA5 = () BB5 = ();
LINE C5 = (SF DS QF5 BA5 D2 B D2 QD BB5 DS SD SH5 SV5 D1S);
QUAD QF6 = (L=0.3 K1=0.7 DX=1E-4*SIN(6*1.7) DY=1E-4*SIN(6*2.9+0.5));
BEND SH6 = (L=0.1 ANGLE=0) SV6 = (L=0.1 ANGLE=0 ROTATE=PI/2);
MARK BA6 = () BB6 = ();
LINE C6 = (SF DS QF6 BA6 D2 B D2 QD BB6 DS SD SH6 SV6 D1S);
QUAD QF7 = (L=0.3 K1=0.7 DX=1E-4*SIN(7*1.7) DY=1E-4*SIN(7*2.9+0.5));
BEND SH7 = (L=0.1 ANGLE=0) SV7 = (L=0.1 ANGLE=0 ROTATE=PI/2);
MARK BA7 = () BB7 = ();
LINE C7 = (SF DS QF7 BA7 D2 B D2 QD BB7 DS SD SH7 SV7 D1S);
QUAD QF8 = (L=0.3 K1=0.7 DX=1E-4*SIN(8*1.7) DY=1E-4*SIN(8*2.9+0.5));
BEND SH8 = (L=0.1 ANGLE=0) SV8 = (L=0.1 ANGLE=0 ROTATE=PI/2);
MARK BA8 = () BB8 = ();
LINE C8 = (SF DS QF8 BA8 D2 B D2 QD BB8 DS SD SH8 SV8 D1S);
QUAD QF9 = (L=0.3 K1=0.7 DX=1E-4*SIN(9*1.7) DY=1E-4*SIN(9*2.9+0.5));
BEND SH9 = (L=0.1 ANGLE=0) SV9 = (L=0.1 ANGLE=0 ROTATE=PI/2);
MARK BA9 = () BB9 = ();
LINE C9 = (SF DS QF9 BA9 D2 B D2 QD BB9 DS SD SH9 SV9 D1S);
QUAD QF10 = (L=0.3 K1=0.7 DX=1E-4*SIN(10*1.7) DY=1E-4*SIN(10*2.9+0.5));
BEND SH10 = (L=0.1 ANGLE=0) SV10 = (L=0.1 ANGLE=0 ROTATE=PI/2);
MARK BA10 = () BB10 = ();
LINE C10 = (SF DS QF10 BA10 D2 B D2 QD BB10 DS SD SH10 SV10 D1S);
QUAD QF11 = (L=0.3 K1=0.7 DX=1E-4*SIN(11*1.7) DY=1E-4*SIN(11*2.9+0.5));
BEND SH11 = (L=0.1 ANGLE=0) SV11 = (L=0.1 ANGLE=0 ROTATE=PI/2);
MARK BA11 = () BB11 = ();
LINE C11 = (SF DS QF11 BA11 D2 B D2 QD BB11 DS SD SH11 SV11 D1S);
QUAD QF12 = (L=0.3 K1=0.7 DX=1E-4*SIN(12*1.7) DY=1E-4*SIN(12*2.9+0.5));
BEND SH12 = (L=0.1 ANGLE=0) SV12 = (L=0.1 ANGLE=0 ROTATE=PI/2);
MARK BA12 = () BB12 = ();
LINE C12 = (SF DS QF12 BA12 D2 B D2 QD BB12 DS SD SH12 SV12 D1S);
LINE RING = (ORIGIN RF C1 C2 C3 C4 C5 C6 C7 C8 C9 C10 C11 C12);
FFS;
PageWidth=1999;
USE RING; CELL; CALC;
mon=Monitor[Flatten[Table[{"BA"//ToString[k],"BB"//ToString[k]},{k,1,12}]]];
sv=Steer[Table["SV"//ToString[k],{k,1,12}]];
! 注意: rms は Sqrt[Plus@@(DY^2)/n] と書く (Plus@@Twiss[..]^2 は (ΣDY)^2 と読まれ、rms にならない)
rmy:=Sqrt[Plus@@(Twiss["DY",mon[[1]]]^2)/Length[mon[[1]]]];
Print["rms before = ",rmy];
K0save=LINE["K0","SV*"];
nl={0,1,2,3,4,6,8,12};
Do[
  n=nl[[i]];
  LINE["K0","SV*"]=K0save;
  CALC;
  opt=CalculateOptics[1,LINE["LENGTH"],Twiss["*",1],FLAG["CELL"],2];
  r=If[n==0,CorrectOrbit["Y",mon,sv,opt],CorrectOrbit["Y",mon,sv,opt,Solver->{"Micado",n}]];
  CALC;
  Print["Micado n=",n,"  rms after = ",rmy,"  max kick = ",Max[Abs[r]]],
  {i,1,Length[nl]}];
Exit;
