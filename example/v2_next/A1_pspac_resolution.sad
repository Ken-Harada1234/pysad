! v2next A1 項目 8: PSPAC (SPCH 要素) のメッシュの分解能。gs (K64) との差の原因はメッシュ (縦: λ(z) の入れ方、横: 電位の補間)。
! 条件: 5 MeV、1e11 個、半径 1 mm の一様な円・長さ lb の一様なバンチ (4096 個の準乱数)、D(0.5) SPCH D(0.5) SPCH。
! 解析式 (薄いキック): rms x = 0.5 mm (1 + s/2)、s = K L/a² (K = 2 r_e N/(lb β²γ³)、L = 0.5 m)。lb = 0.1 m で 1.2481 mm、lb = 0.02 m で 4.241 mm。
! 縦メッシュ DZ = 0.005 m のとき v2 は lb/DZ = 20 で解析式の −1.7%、10 で −4%、4 で −12%、2 で −27%、1 で −48%。gs は −1.1%、−2.8%、−7.8%、−17%、−20%。
! PSPACNZ < 4 (縦を自動) なら v2 は 1% 以内。メッシュが粗いと pysad は警告 (???-PSPAC-Warning) を出す。
! gs は 1 つのセッションで TrackParticles を繰り返すと 2 回目から PSPAC が働かない (K64 の static 変数、SPC8)。A1_pspac_resolution.gs.txt の 2 行目以降は無効で、
! gs の値は lb ごとに別のセッションで取った (上の割合)。k64 モード (PYSAD_COMPAT=k64) の pysad は PSPAC を追跡に入れない。
MOMENTUM = 5MEV;
DRIFT D1 = (L=0.5);
SPCH SP1 = ();
MARK ORIGIN = ();
LINE TL = (ORIGIN D1 SP1 D1 SP1);
FFS;
RFSW; NORAD; NOFLUC;
USE TL; INS; CALC;
PBUNCH = 1e11;
PSPACNX = 128; PSPACNY = 128; PSPACDX = 1e-4; PSPACDY = 1e-4; PSPACNZ = 32; PSPACDZ = 0.005;
lbs = {0.1, 0.02, 0.01, 0.005};
a = 1e-3; n = 4096;
u = Table[Mod[i*0.6180339887, 1], {i,1,n}];
v = Table[Mod[i*0.7548776662, 1], {i,1,n}];
w = Table[Mod[i*0.5698402910, 1], {i,1,n}];
rms[l_] := Sqrt[Plus@@(l^2)/Length[l]];
$FORM = "12.6";
PSPAC;
Do[
  lb = lbs[[k]];
  bm = {a*Sqrt[u]*Cos[2*Pi*v], Table[0,{n}], a*Sqrt[u]*Sin[2*Pi*v], Table[0,{n}], lb*(w-0.5), Table[0,{n}], Table[1,{n}]};
  r = TrackParticles[{1,bm},1,1,1];
  Print["lb = ", lb, " m: rms x, y [m] = ", rms[r[[2,1]]], ", ", rms[r[[2,3]]]],
  {k,1,4}];
Exit;
