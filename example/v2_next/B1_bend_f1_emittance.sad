! v2next B1 項目 1: Emittance[]・EMIT・CALC6D の BEND の F1・FRINGE。K64 の tbende の F1 (tblfre、tbendef1 の 2 断片、alcorr の長さの補正) と
! 周長 (tfgeo の pos: BEND の F1 の長さ補正) を入れた。旧 pysad は F1 を黙って無視した (U0 が 5%、チューンが 0.006 違った)。
! 条件: 3 GeV、周長 45.6 m の 12 セル FODO、RF 3 MV・h=64、BEND 1.2 m (15 度、E1=E2=7.5 度) に F1=0.1 FRINGE=3。K1≠0 の複合機能の BEND も。
! k64 モード (PYSAD_COMPAT=k64) は gs と全桁一致 (表示 10 桁)。v2 は端の角の場の中の行路の補正 (A の項目) が入るので U0 が 1e-3 ほど違う。
! 検算: NORFSW NORAD の Emittance[] のチューン (6D の一周写像) = CALC のチューン (4D) が F1 込みで 1e-9。
MOMENTUM = 3GEV;
DRIFT D1 = (L=1) D2 = (L=0.5);
QUAD QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
BEND B = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747 F1=0.1 FRINGE=3);
BEND BK = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747 K1=-0.05 F1=0.1 FRINGE=3);
CAVI RFC = (L=0 VOLT=3e6 HARM=64);
MARK ST = ();
LINE CELL1 = (QF D2 B D2 QD D1);
LINE CELLK = (QF D2 BK D2 QD D1);
LINE RING = (ST 12*CELL1 RFC);
LINE RINGK = (ST 12*CELLK RFC);
FFS;
$FORM="14.10";
USE RING; CELL; CALC;
Print["CALC tunes ", Twiss["NX","$$$"]/(2Pi), Twiss["NY","$$$"]/(2Pi)];
NORFSW; NORAD;
e = Emittance[];
Print["no-RF no-RAD Emittance[] tunes (= 1 - frac of CALC) ", Tunes/.e];
RFSW; RAD; NOFLUC;
e = Emittance[];
Print["F1 ring: Tunes ", Tunes/.e];
Print["F1 ring: U0 [eV], EquilibriumPosition, MomentumCompaction ", {EnergyLossU0, EquilibriumPosition, MomentumCompaction}/.e];
Print["F1 ring: DampingRate, Emittances ", {DampingRate, Emittances}/.e];
USE RINGK; CELL; CALC;
e = Emittance[];
Print["K1 BEND with F1: Tunes ", Tunes/.e];
Print["K1 BEND with F1: U0 [eV], EquilibriumPosition, MomentumCompaction ", {EnergyLossU0, EquilibriumPosition, MomentumCompaction}/.e];
Exit;
