! v2next C3 項目 1: TRCOD の閉軌道の測定。24 セルの平面 FODO (3 GeV)、リングの先頭に薄いキック (L=0 の BEND、K0=1e-5)。
! TRCOD (NP=2、ε=0、DP=0: 重心の追跡) が測った軌道を、CALC の閉軌道と、解析式 x(s) = θ √(β_s β_k)/(2 sin πν) cos(πν − |φ_s − φ_k|) と比べる。
! 結果 (v2): TRCOD と CALC の最大の差 / 最大の軌道 = 2e-9 程度、解析式との差は 1e-6 程度 (6 極なし)。gs は TRCOD で SIGSEGV (B42) なので gs の出力は無い。
! 大きなリング (PF 187 m・大きなリング A 603 m・ASTRID2) では試験 test_v2_C3_measure.py (差 6e-7〜1.3e-5、解析式との差 4e-4〜1.9e-3 (6 極のフィードダウン))。
MOMENTUM = 3GEV;
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS = (L=0.1);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORG0 = ();
BEND  KICK = (L=0 ANGLE=0 K0=1E-5);
CAVI RF = (L=0 VOLT=4.0E6 FREQ=5.0E8 PHI=0);
LINE CELLQ = (QF D2 B D2 QD DS SD D1 SF DS);
LINE RINGK = (ORG0 KICK RF 24*CELLQ);
FFS;
$FORM = "14.8";
USE RINGK; CELL; CALC;
NP = 2; DP = 0; EMITX = 0; EMITY = 0; SIGZ = 0;
nl = LINE["LENGTH"];
ox = Table[Twiss["DX", i], {i, 1, 200, 20}];
Print["CALC  DX (every 20th element) = ", ox];
TRCOD;
tx = Table[Twiss["DX", i], {i, 1, 200, 20}];
Print["TRCOD DX (every 20th element) = ", tx];
Print["max |TRCOD - CALC| / max|DX| = ", Max[Abs[tx - ox]]/Max[Abs[ox]]];
bk = Twiss["BX", "KICK"]; mk = Twiss["NX", "KICK"]; nux = Twiss["NX", "$$$"]/(2*Pi);
an = Table[-1E-5*Sqrt[Twiss["BX", i]*bk]/(2*Sin[Pi*nux])*Cos[Pi*nux - Abs[Twiss["NX", i] - mk]], {i, 1, 200, 20}];
Print["analytic DX                 = ", an];
Print["max |TRCOD - analytic| / max|DX| = ", Max[Abs[tx - an]]/Max[Abs[an]]];
Exit;
