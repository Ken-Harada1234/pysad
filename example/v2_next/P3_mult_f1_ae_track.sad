! v2next P3 項目 1・2: TrackParticles の MULT の F1・F2・FB1・FB2・FRINGE (K64 の tmulti の tqlfre 相当・tblfri) と AE1・AE2 (tmulk)。旧 pysad は F1・FRINGE で
! NotImplementedError、AE は黙って無視していた (K64 の動作の追加。gate なし)。
! 追跡の四極の線形フリンジは tsetfringep の係数 (f1 = -|K1/L F1^2|/24、f2 = |K1/L| F2。Emittance[] の tsetfringepe (F1・F2 そのもの) とは別)。
! 条件: 3 GeV、周長 45.6 m の 12 セル FODO の QF・QD を MULT (L = 0.3 m、K1 = 0.7・-0.6) に替え、K0・F1K1F・F1K1B・F1・FRINGE=3・AE・FB1・FB2・ROTATE・DX を付けた。
! 3 粒子 3 周 (NORAD と RAD)。k64 は gs と 10 桁表示の全桁一致。
MOMENTUM = 3GEV;
DRIFT D1 = (L=1) D2 = (L=0.5);
MULT QF = (L=0.3 K1=0.7 F1K1F=0.02 F1K1B=0.04 F1=0.03 FRINGE=3 AE1=0.05 K0=0.0006 FB1=0.03);
MULT QD = (L=0.3 K1=-0.6 F1K1F=0.02 F1K1B=0.04 F1=0.03 FRINGE=3 AE2=0.05 K0=-0.0006 FB2=0.03 ROTATE=0.1 DX=1e-4);
BEND B = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
CAVI RFC = (L=0 VOLT=3e6 HARM=64);
MARK ST = ();
LINE CELL1 = (QF D2 B D2 QD D1);
LINE RING = (ST 12*CELL1 RFC);
FFS;
$FORM="14.10";
bm={{1e-3,0,1e-3},{1e-4,0,0},{1e-3,0,-1e-3},{0,0,0},{0,0,0},{0,1e-3,-1e-2},{1,1,1}};
USE RING; CELL; CALC; NORFSW; NORAD;
r=TrackParticles[{1,bm},1,1,3];
Print["N3 ", r[[2]]];
RFSW; RAD; NOFLUC;
r=TrackParticles[{1,bm},1,1,3];
Print["R3 ", r[[2]]];
Exit;
