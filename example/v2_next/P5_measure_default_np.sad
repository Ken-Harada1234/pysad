! v2next P5 項目 1: NP を指定しない MEASURE。gs は粒子数 1000 (NP の既定、tffsa.f の np0=1000)。k64 も同じ (v2 は NP の指定を要求する)。
! 条件: 3 GeV、周長 48 m の 12 セル FODO。
MOMENTUM = 3GEV;
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS = (L=0.1);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = ();
LINE CELL = (DS QF D2 B D2 QD DS D1);
LINE RING = (ORIGIN 12*CELL);
FFS;
EMITX=1.2e-8; EMITY=1.5e-9; SIGZ=2e-3; DP=1.5e-3;
USE RING; CELL; CALC;
MEASURE ORIGIN;
Exit;
