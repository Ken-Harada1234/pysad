! ---- v2next P1 項目 2: 垂直の偏向 (ROTATE=90° の BEND の組) のあるリングの Polarization と PolarizationTime ----
! 0.5 GeV の 12 セル FODO (周長 45.6 m) の途中に、軌道を鉛直方向に ±0.1 rad 曲げる BEND の組 (磁場は水平、n は鉛直のまま = b·n = 0) を入れる。
! K64 (gs・k64 モード): 緩和率は符号つきの Σ r (b·n) で、垂直の偏向の放射 (ρ⁻³ の 8%) を数えない。Polarization は NaN。
! v2: 緩和率は Sokolov-Ternov の厳密式 Σ r (1 − 2/9 (n·v)²) (反転は b·n = 0 でも起きる)。独立な DK の数値積分 (pysad/tests/_p1_dk.py) と τ が 1e-5、P が 1e-3。
MOMENTUM = 0.5 GEV;
DRIFT D1 = (L=1.0) D2 = (L=0.5) DV = (L=0.3);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.55);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
BEND  VB1 = (L=0.4 ANGLE=0.1 ROTATE=90 DEG) VB2 = (L=0.4 ANGLE=-0.1 ROTATE=90 DEG);
CAVI  RFC = (VOLT=0.2e6 HARM=64);
MARK  ST = ();
LINE  CELLQ = (QF D2 B D2 QD D1);
LINE  VDOG = (VB1 DV VB2);
LINE  RING = (ST 6*CELLQ VDOG 6*CELLQ RFC);
FFS;
$FORM = "16.10";
USE RING; CELL; CALC;
RFSW; RAD; NOFLUC; POL;
em = Emittance[];
Print["Polarization, PolarizationTime [s] = ", {Polarization, PolarizationTime}/.em];
Exit;
