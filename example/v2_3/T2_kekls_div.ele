&divide_elements name=*, type=*, divisions=8, exclude="MAXAMP" &end
&run_setup
  lattice = T1_kekls_all.lte, use_beamline = RING, p_central_mev = 3000.000000, default_order = 3, rootname = twd, magnets = %s.mag,
&end
&run_control &end
&twiss_output filename = %s.twi, radiation_integrals = 1, &end
&bunched_beam n_particles_per_bunch = 1 &end
&track &end
