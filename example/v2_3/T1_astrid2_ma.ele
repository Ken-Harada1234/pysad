&run_setup
  lattice = T1_astrid2_ma.lte, use_beamline = RING,
  p_central_mev = 580.000000, default_order = 3,
  rootname = T1_astrid2_ma,
&end
&run_control n_passes = 1312 &end
&momentum_aperture
  output = %s.mmap, output_mode = 1, fiducialize = 1, verbosity = 1,
  x_initial = 0, y_initial = 0,
  delta_negative_start = 0, delta_negative_limit = -0.030000,
  delta_positive_start = 0, delta_positive_limit = 0.030000,
  delta_step_size = 0.0025, splits = 5, split_step_divisor = 2,
  include_name_pattern = "AM",
&end
