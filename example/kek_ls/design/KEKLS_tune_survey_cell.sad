!=====================================================================
! KEK-LS  v03_68  (3 GeV, 20 セル, ESRF 型 HMBA)
!
! KEK-LS は ESRF 型の HMBA (Hybrid Multi-Bend Achromat) で、ESRF の
! Pantaleo Raimondi 氏と Simone Liuzzo 氏の協力で設計した。
!
! エネルギー      3 GeV
! 周長            570.72 m (RINGC)。RING は入射セル ARCINJ の分だけ 0.9 mm 長い 570.7209 m
! 周回部          標準セル 20 個 (ARCA = ARCAH と -ARCAH。長直線部 (DRID1×2 = 5.88 m) の中心 MKS から次の MKS まで)
! RF              2 MV、ハーモニック数 952
! チューン        (48.58, 17.62)  (RINGC・RING とも)
! エミッタンス    εx 約 134 pm rad (RINGC。RING は約 136 pm rad)。エネルギー拡がり約 6.4e-4、U0 約 0.296 MeV、αc 約 2.2e-4
!
! ライン
!   ARCAH   標準セルの半分 (MKS = 長直線部の中心から MKC まで)。ARCAH1 = 直線部 (DRID1 2.94 m)・四極 QFA1H・QDA2・
!           偏向磁石 BID5〜BID1 (中央に補正磁石 HD) と四極 QDA3。ARCAH2 = 六極 SDH・SFH、四極 QFA4・QDA5、
!           偏向磁石 BPI1〜BPI5、四極 QFA6H・QFA8H、勾配つき偏向磁石 BPI6H・BPI7H、DRCT (0.55 m)
!   ARCA    標準セル 1 個 = ARCAH と -ARCAH
!   RINGC   標準セル 20 個の周回ライン (RF 空洞 RFC が中央)
!   ARCINJ  入射セル = ARCAH1 ARCAH2 + ARCINJH + -ARCINJH2 + -ARCAH2 -ARCAH1
!           (ARCINJH・ARCINJH2 は入射用の長直線部を作る四極 QS0〜QS5・キッカー K1〜K4 つき)
!   RING    標準セル 19 個 + ARCINJ の周回ライン (入射セル含む)
!
! このファイルは FFS; の前に置く (要素・ライン定義だけ。台本は後ろに続ける)。
! 要素の定義の中身は元の設計ファイルのまま (改行と先頭のコメントだけ変えた)。
!=====================================================================
 MOMENTUM = 3GEV;
 DRIFT  DRID1   =(L =2.94 )  DR05    =(L =.05 )   DR20    =(L =.2 )    DR12    =(L =.12 )   DRSS2   =(L =.3825 )
        DRSO    =(L =.2025 ) DR06    =(L =.06 )   DR28    =(L =.19 )   DR14    =(L =.14 )   DRCT    =(L =.55 )
        DRID1INJ=(L =2.7654600539435394 )
 ;
 BEND   VD      =(ANGLE =0     ROTATE =-90 DEG )
        BID5    =(L =.413 ANGLE =.01989677344 )
        BID4    =(L =.413 ANGLE =.01093590672 )
        BID3H   =(L =.2065     ANGLE =.00413604696 )
        HD      =(ANGLE =0 )
        BID2    =(L =.413 ANGLE =.00653919168 )
        BID1    =(L =.413 ANGLE =.00532646 )
        BPI1    =(L =.413 ANGLE =.0052368512 )
        BPI2    =(L =.413 ANGLE =.00631565072 )
        BPI3H   =(L =.2065     ANGLE =.00379054624 )
        BPI4    =(L =.413 ANGLE =.00957848528 )
        BPI5    =(L =.413 ANGLE =.01350338256 )
        BPI6H   =(L =.403 ANGLE =.02726687232 K1 =-1.0100957067176413 )
        BPI7H   =(L =.176 ANGLE =.00468  K1 =-.006398424930727633 )

        BID5I    =(L =.25 ANGLE =.01989677344 )
        BID4I    =(L =.25 ANGLE =.01093590672 )
        BID3IH   =(L =.125     ANGLE =.00413604696 )
        BID2I    =(L =.25 ANGLE =.00653919168 )
        BID1I    =(L =.25 ANGLE =.00532646 )
        K1 = (L = .3)
        K2 = (L = .3)
        K3 = (L = .3)
        K4 = (L = .3)
 ;
 QUAD   QFA8H   =(L =.25  K1 =.9417515241499581 )
        QFA6H   =(L =.1675     K1 =.8782619605554324 )
        QDA5    =(L =.2   K1 =-.4052202821210436 )
        QFA4    =(L =.2   K1 =.5166819921440575 )
        QS5     =(L =.2   K1 =.5280568479331271 )
        QS4     =(L =.2   K1 =-.8242016169366202 )
        QS3     =(L =.2   K1 =.5546128367232006 )
        QS2     =(L =.2   K1 =-.1734492217190123 )
        QS1     =(L =.1   K1 =-.11309930079031016 )
        QS0     =(L =.1   K1 =.22894938883952784 )
        QFA1H   =(L =.125 K1 =.46236106609239286 )
        QDA2    =(L =.2   K1 =-.725123012102831 )
        QDA3    =(L =.2   K1 =-.49958031983962237 )
        QFA4    =(L =.2   K1 =.5166819921440575 )
        QDA5    =(L =.2   K1 =-.4052202821210436 )

 ;
 SEXT   SDH     =(L =.09  K2 =-12.38248640793169 )
        SFH     =(L =.09  K2 =15.13439810682049 )
        SHA     =(L =.03  K2 =0 )
 ;
 CAVI   RFC     =(VOLT =2000000     HARM =952 )
 ;
 OCT    OCFA    =(L =.1   K3 =0 )
 ;
 MONI   BPM                             =()
 ;
 MARK   MKS     =(AX =1.8269725395795895e-14  BX =4.793340121212032    AY =5.061657878833287e-15     BY =2.3773852899436254
           EX =.024999999999712127  EPX =-6.269917972172717e-18   DP =.01   EMITX =1.319631265310858e-10  EMITY =1e-12 )
        MKBE    =(AX =1.0915299904430553 BX =2.491305955156373    PSIX =.750812602138054   AY =-1.108768449431935
           BY =14.899228084658809   PSIY =.9775906221236254  EX =.01317746375590028   EPX =-.010709118972041609     DP =.01
           EMITX =1.319631265310858e-10  EMITY =1e-12 )
        MKSDA1  =(AX =-2.70998200884407  BX =3.54290286006273     PSIX =2.438795403562738  AY =7.583458360247109
           BY =15.674832734538994   PSIY =1.12519968960124   EX =.08917916867198322   EPX =.07392275472299359  DP =.01
           EMITX =1.319631265310858e-10  EMITY =1e-12 )
        MKSFA1  =(AX =-.1389893849851418 BX =8.335022603847122    PSIX =2.6010651192329326 AY =1.1900000003019817
           BY =6.400000001617214    PSIY =1.2342357814658897 EX =.14000000000027565   EPX =.0033565669999445075     DP =.01
           EMITX =1.319631265310858e-10  EMITY =1e-12 )
        MKSDC1  =(AX =2.701045920207907  BX =3.9178996452699595   PSIX =2.7538171975351866 AY =-2.4682164774922373
           BY =8.605708880847574    PSIY =1.3800502607967173 EX =.09575556512146 EPX =-.06826941595892633 DP =.01
           EMITX =1.319631265310858e-10  EMITY =1e-12 )
        MKC     =(AX =2.3285271135756143e-14  BX =.6646241808238317    PSIX =7.630928555572884  AY =-2.6333805821142455e-15
           BY =1.3317427649375617   PSIY =2.7677431278546    EX =.01999999999994648   EPX =-7.45931094670027e-17    DP =.01
           EMITX =1.319631265310858e-10  EMITY =1e-12 )
        MKE     =(AX =2.3285271135756143e-14  BX =.6646241808238317    PSIX =7.630928555572884  AY =-2.6333805821142455e-15
           BY =1.3317427649375617   PSIY =2.7677431278546    EX =.01999999999994648   EPX =-7.45931094670027e-17    DP =.01
           EMITX =1.319631265310858e-10  EMITY =1e-12 )
        MKSE = ()
        MKS2  =()
        MKSI = ()
 ;
!-----------------------------------------
! ARC CELLS
!-----------------------------------------

  MONI
         PM = ()
  ;

  BEND   HD = ()
         VD = (ROTATE = -90 DEG)
  ;
  LINE   HV = (HD VD)
  ;
LINE
  ARCAH    =(ARCAH1 ARCAH2)

  ARCAH1   =(MKS
             DRID1 PM DR05 QFA1H VD QFA1H DR20, QDA2, DR12 MKBE
             BID5, BID4, BID3H HD BID3H, BID2, BID1,
             DR12, QDA3, DR12
             )
  ARCAH2   =(MKS2
             SDH MKSDA1 SDH
             DR05 PM
             DRSS2  DR05
             QFA4, DR12,
             SFH MKSFA1 VD SFH
             DR12, QFA4, DR12, OCFA,
             DRSO PM DR05
             SDH MKSDC1 SDH
             DR12, QDA5, DR12,
             BPI1, BPI2, BPI3H HD BPI3H BPI4, BPI5,
             DR06 PM DR06, QFA6H QFA6H DR28,
             BPI6H HD BPI6H DR05 DR14 QFA8H VD QFA8H DR12, SHA, DR12,
             BPI7H HD BPI7H DR05 PM DRCT MKC
             MKE)
  ARCAHI2   =(MKS2
             SDH MKSDA1 SDH
             DR05 PM
             DRSS2  DR05
             QS5, DR12,
             SFH MKSFA1 VD SFH
             DR12, QFA4, DR12, OCFA,
             DRSO PM DR05
             SDH MKSDC1 SDH
             DR12, QDA5, DR12,
             BPI1, BPI2, BPI3H HD BPI3H BPI4, BPI5,
             DR06 PM DR06, QFA6H QFA6H DR28,
             BPI6H HD BPI6H DR05 DR14 QFA8H VD QFA8H DR12, SHA, DR12,
             BPI7H HD BPI7H DR05 PM DRCT MKC
             MKE)
   ARCINJH  =(
             -ARCAHI2
             MKSE
             DR12  QS4  DR12 K1  DR12
             QS3 DR12
             BID1I  BID2I BID3IH HD BID3IH BID4I BID5I
             MKBE
             DR12 QS2 DR05 VD DR05 QS1
             DR05 PM
             K2
             DRID1INJ HD DR05 PM DR05 QS0
             MKSI
            )
   ARCINJH2  =(
             -ARCAHI2
             MKSE
             DR12  QS4  DR12 K1  DR12
             QS3 DR12
             BID1I  BID2I BID3IH HD BID3IH BID4I BID5I
             MKBE
             DR12 QS2 DR05 VD DR05 QS1
             DR05 PM
             K2
             DRID1INJ VD DR05 DR05 QS0
             MKSI
            )

 ARCA      = (ARCAH -ARCAH)
 RINGC      =(MKS
             ARCA, ARCA, ARCA, ARCA,
             ARCA, ARCA, ARCA, ARCA,
             ARCA, ARCA, ARCA, ARCA, RFC,
             ARCA, ARCA, ARCA, ARCA,
             ARCA, ARCA, ARCA, ARCA
             MKE)
 RING     =(MKS
             ARCA ARCINJ, ARCA,
             ARCA, ARCA, ARCA, ARCA,
             ARCA, ARCA, ARCA, ARCA, RFC,
             ARCA, ARCA, ARCA, ARCA,
             ARCA, ARCA, ARCA, ARCA
             MKE)
 ARCINJ    =(ARCAH1 ARCAH2 ARCINJH -ARCINJH2 -ARCAH2 -ARCAH1)
 ARCINJ2   =(ARCINJH -ARCINJH2)
 ;
! KEK-LS v03_68: 標準セルのチューンサーベイ  (元: matching05 と modules_tune_sv_v03_68.n。モジュールはこの台本に取り込んだ)
! リングのチューン (tunex, tuney) の格子の各点で、標準セル (ARCA) の位相進みを (tunex/20, tuney/20) に再マッチし、
! 六極 SDH・SFH でクロマティシティを補正して、リング (RINGC) のチューン・ξ・εx・六極の強さを表示する。
! 元の格子: tunex 46.05〜46.55 (0.1 刻み 6 点) × tuney 16.05〜19 (0.1 刻み 30 点) = 180 点、各点で DAsv[] (5000 周)。
!          (元の matching05 は modules_tune_sv_v03_35.n を読む。v03_68 用の modules_tune_sv_v03_68.n は読み込む台本が元のフォルダに無い。)
! 例の格子: tx0 から dtx 刻み ntx 点 × ty0 から dty 刻み nty 点 (既定 48.30〜48.90 の 5 点 × 17.30〜17.90 の 5 点 = 25 点)。追跡 (DAsv) は含めない。
!          完全な設定: tx0 = 46.05; dtx = 0.1; ntx = 6; ty0 = 16.05; dty = 0.1; nty = 30; にして、各点に modules_general.n の DAsv[] を足す。
! v03_68 に合わせた直し (元のモジュールは v03_35 の名残が残り、v03_68 では動かない):
!   (1) 目標の値: MKSFA1 の AY 1.18・BY 5.3・EX 0.1504、MKC の BY 5 (v03_35 の値) → v03_68 の設計値 (AY 1.19・BY 6.4・EX 0.14、MKC BY 1.3317)。
!   (2) FitFunction の `MKSFA2` (v03_68 に無い) → `MKSFA1.2`、`MKSFA1` → `MKSFA1.1` (1 セルに 2 回現れる)。
!   (3) ChromCor の `coup SDC SDA 1`・`SDA MAX 0`・`SFA MIN 0` → `SDH MAX 0`・`SFH MIN 0` (v03_68 の六極は SDH・SFH の 2 本だけ)。
!   (4) `free BPI6 K1`・`free BPI7 K1` は名前が合わず効かない → BPI6H・BPI7H にした。
!   (5) モジュール modules_tune_sv_v03_68.n は ../modules/modules_cell_match.n (関数 InitMag・MatchingARCA・ChromCor。Chrom・GetKQ・PutKQ を追加) に移した。`SAVE ALL` (画面にラティスを出す) は省いた。
!   (6) リングは元の RING (入射セル込み) ではなく RINGC (標準セル 20 個)。入射セルの四極 QS0〜QS5 は標準セルの変更には追従しないため。
NPARA = 8;
ON LOG;
ON RAD FLUC COD RFSW RADCOD;
FFS;
$FORM = "15.10";
PageWidth = 1999;

tx0 = 48.30;  dtx = 0.15;  ntx = 5;
ty0 = 17.30;  dty = 0.15;  nty = 5;
Get["../modules/modules_cell_match.n"];   ! InitMag・MatchingARCA・ChromCor・Chrom・GetKQ・PutKQ

Print["columns: tunex_target tuney_target tunex_ring tuney_ring xi_x xi_y emitx[pm] K2_SDH K2_SFH"];
Do[
  Do[
    FFS["USE ARCA;"];
    InitMag[];
    nxcell = tunex/20;
    nycell = tuney/20;
    MatchingARCA[1];
    MatchingARCA[1];
    MatchingARCA[0.001];
    ChromCor[];
    FFS["cell calc"];
    GetKQ[];
    FFS["USE RINGC;"];
    PutKQ[];   ! USE し直しても K1 が保たれるかに頼らず、リング側に値を入れ直す
    FFS["cell calc emit"];
    xi = Chrom[0.0005];
    Print["POINT ", tunex, " ", tuney, " ", Twiss["NX","$$$"]/2/Pi, " ", Twiss["NY","$$$"]/2/Pi, " ", xi[1], " ", xi[2], " ", EMITX*1E12, " ", kq[10], " ", kq[11]];
  ,{tuney,ty0,ty0+(nty-1)*dty+dty/2,dty}];
,{tunex,tx0,tx0+(ntx-1)*dtx+dtx/2,dtx}];
Exit;
