 LINE HV = (HD VD)
 ;
 LINE
  NCELLH = (MKS
                DLN1 PM DLN2 S1H HV MKS1 S1H D1 Q1 D1 S2H MKS2 S2H D1H PM D1H Q2 D2
                B1
                D5 S3H HV MKS3 S3H D31 PM D32 Q3 D1 S4H MKS4 S4H D1 Q4 D32O OC1 PM D31 S5H HV MKS5 S5H D5
                B2
                D6 Q5 
                DLS1 PM DLS2 HV DLS3
           MKNC)
  NCELL = (MKNC -NCELLH NCELLH MKNE)
  MCELLH = (MKMS
                DLMN PM DLM2 S1MH HV MKS1M S1MH D1 Q1M D1 S2MH MKS2M S2MH D1H PM D1H Q2M D2
                B1M
                D5 S3MH HV MKS3M S3MH D31 PM D32 Q3M D1 S4MH MKS4M S4MH D1 Q4M D32O OC1 PM D31 S5MH HV MKS5M S5MH D5
                B2M
                D6 Q5M
                DLS1 PM DLS2 HV DLS3
           MKMC)
  MCELL = (MKMC -MCELLH MCELLH MKME)
  LCELLH = (MKLS
                DLLN PM DLL2 S1LH HV MKS1L S1LH D1 Q1L D1 S2LH MKS2L S2LH D1H PM D1H Q2L D2
                B1L
                D5 S3LH HV MKS3L S3LH D31 PM D32 Q3L D1 S4LH MKS4L S4LH D1 Q4L D32O OC1 PM D31 S5LH HV MKS5L S5LH D5
                B2L
                D6 Q5L D1 QAL 
                DLS1 PM DLS2 HV DLS3
           MKLC)
  LCELL = (MKLC -LCELLH LCELLH MKLE)

  MCELLHA = (MKMSA
                DLM1 PM DLM2 S1MHA HV MKS1MA S1MHA D1 Q1MA D1 S2MHA MKS2MA S2MHA D1H PM D1H Q2MA D2
                B1MA
                D5 S3MHA HV MKS3MA S3MHA D31 PM D32 Q3MA D1 S4MHA MKS4MA S4MHA D1 Q4MA D32O OC1 PM D31 S5MHA HV MKS5MA S5MHA D5
                B2MA
                D6 Q5MA
                DLS1 PM DLS2 HV DLS3
           MKMCA)
  MCELLA = (MKMC -MCELLHA MCELLHA MKME)
  LCELLHA = (MKLSA
                DLL1 PM DLL2 S1LHA HV MKS1LA S1LHA D1 Q1LA D1 S2LHA MKS2LA S2LHA D1H PM D1H Q2LA D2
                B1LA
                D5 S3LHA HV MKS3LA S3LHA D31 PM D32 Q3LA D1 S4LHA MKS4LA S4LHA D1 Q4LA D32O OC1 PM D31 S5LHA HV MKS5LA S5LHA D5
                B2LA
                D6 Q5LA D1 QALA
                DLS1 PM DLS2 HV DLS3
           MKLCA)
  LCELLA = (MKLC -LCELLHA LCELLHA MKLE)

  RINGL = (MRST
              15*LCELL RFC 15*LCELL
          MRED)
  RINGM = (MRST
              15*MCELL RFC 15*MCELL
          MRED)

  RINGLA = (MRST
              15*LCELLA RFC 15*LCELLA
          MRED)
  RINGMA = (MRST
              15*MCELLA RFC 15*MCELLA
          MRED)

  TCELL = (MCELL LCELL)
  TCELLA = (MCELLA LCELLA)
  ACELL = (TCELL TCELLA)

  RINGN = (MRST
              8*TCELL RFC 7*TCELL
          MRED)
  RINGA = (MRST
              8*TCELLA RFCA 7*TCELLA
          MRED)


  HRING = (MRST
               LCELLHA 5*TCELLA 2*TCELL -MCELLHA
          )

  RING =(MRST   LCELLH TCELL -MCELLHA RFC -HRING LCELLHA 5*TCELLA MCELL -LCELLH )
  RING =( HRING RFC -HRING) 

  RING =(MRST LCELLH MCELL LCELLA MCELLA LCELLA MCELLA LCELLA MCELLA LCELLA MCELLA LCELLA MCELLA -LCELLHA HRING RFC MCELLHA LCELL MCELL -LCELLH MRED) 


