ON LOG;
ON RAD FLUC COD RFSW RADCOD;
FFS;
$FORM = "15.10";
PageWidth = 1999;
USE RING;
cell calc emit;
Print["circumference [m] = ", LINE["S","$$$"]];
Print["tune nx ny = ", Twiss["NX","$$$"]/2/Pi, " ", Twiss["NY","$$$"]/2/Pi];
Print["EMITX [m rad] = ", EMITX, "  SIGE = ", SIGE, "  SIGZ [m] = ", SIGZ];
Print["MOMENTUM [eV] = ", MOMENTUM];
Print["CAVI VOLT [V] FREQ [Hz] HARM = ", LINE["VOLT","RFC"], " ", LINE["FREQ","RFC"], " ", LINE["HARM","RFC"]];
Exit;
