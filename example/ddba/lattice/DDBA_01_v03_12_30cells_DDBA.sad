! ======================================================================
! DDBA_01  v03_12_30cells_DDBA
! 設計手順の段階: 1. 基本セルの構想 (セル数・直線部・偏向磁石の構成)
! 元の台本: v03_12_30cells_DDBA (設計メモの添付 2.1 KB、元の台本 2120
!     byte。同名・同サイズ)
! 設計メモのページの最終更新: 2023/07/13
! 何の版か (設計メモの記述の要約): セル数の決定。もとの NanoTerasu のラティスから始め、短直線部を 2 m、長直線部を
!     7.6 m にし、Q1・Q5 を 30 cm、Q3 を 40 cm にしてマッチング (16
!     セルでセル長 24.72 m)。750 m を割って 30 セル。短直線部中央の分散 3 cm
!     でマッチングした結果がこの台本
!     (v03_12_30cells_DDBA)。同じ設計メモには、短直線部も色消しにした版
!     (v03_11_30cell_D_DBA)、直線部を 5 m/10 m にした DDBA
!     (v03_14_DDBA)、real DBA x 2 (v03_13_D_DBA)
!     も添付されている
! 設計メモが書いている数値: セル長 24.72 m (16 セル版)。設計メモの感想:
!     「これを回るリングにするのは相当難しいだろう」
! pysad の cell calc emit (ON RAD FLUC COD RFSW RADCOD、リングのライン RING、k64 モード = gs と同じ):
!     エネルギー 5.0 GeV、周長 750.6000 m、チューン (52.8739, 17.5348)
!     εx = 5.21e-10 m rad (k64)、5.215e-10 m rad (v2 モード)、σE = 0.001019、αc = 0.0001091、U0 = 2.562 MV
!     RF: 総電圧 3.6 MV、h = 592、周波数 236.447 MHz。偏向磁石 120 台 (L > 0, |ANGLE| > 0.02)、逆曲げなどの小角 BEND 0 台、四極 300 台、6 極 300 台、八極 0 台
! 元のヘッダ: 元の台本の先頭にコメントのヘッダはない (先頭は MOMENTUM の行)。
! 変更: 改行を LF にした。ラティスの定義の中身は変えていない。
! ======================================================================
MOMENTUM = 5.0GEV;

 DRIFT  DLL     =(L =3.6 )  D1      =(L =.15 )   D2      =(L =.27 )   D3      =(L =.53 )   D4      =(L =.62 )   D5      =(L =.3 )
        D6      =(L =.36 )   DLS     =(L = 1 )
 ;
 BEND   B1      =(L =1.13 ANGLE =.09817477    E1 =.5    E2 =.5    K1 =-.7887523152761018 )
 ;
 QUAD   Q1      =(L =.3   K1 =.6554106686794453 )
        Q2      =(L =.2   K1 =-.053158321980570584 )
        Q3      =(L =.4   K1 =.9718078985515348 )
        Q4      =(L =.2   K1 =.12019091931009 )
        Q5      =(L =.3   K1 =.8871433943287228 )
 ;
 SEXT   S1      =(L =.2   K2 =18.990000000000002 )
        S2      =(L =.2   K2 =-22.4974 )
        S3      =(L =.2   K2 =-9.446800000000001 )
        S4      =(L =.2   K2 =21.2346 )
        S5      =(L =.2   K2 =-30.813600000000005 )
 ;
 CAVI   RFC     =(VOLT =3600000     HARM =592 )
 ;
MARK
  MRST = ()
  MNCS = ()
  MC   = ()
  MNCE = ()
  MRED = ()

  MKNS = ()
  MKNSA = ()

;
LINE
  NCELLH = (MNCS
                DLL S1 D1 Q1 D1 S2 D1 Q2 D2
                B1
                D2 S3 D3 Q3 D1 S4 D1 Q4 D4 S5 D5
                B1
                D6 Q5 DLS
           MC)
  NCELL = (MKNS NCELLH -NCELLH MNCE)
  RING = (MRST
              15*NCELL RFC 15*NCELL
          MRED)
;
 BEND   B1      =(L =1.13 ANGLE =.09817477    E1 =.5    E2 =.5    K1 =-.7430018073315926 )
 ;
 QUAD   Q1      =(L =.3   K1 =.6382004923654429 )
        Q2      =(L =.2   K1 =-.07519459195647325 )
        Q3      =(L =.4   K1 =.9604673905471247 )
        Q4      =(L =.2   K1 =.10469041061448142 )
        Q5      =(L =.3   K1 =.8514643972134764 )
 ;
 DRIFT  DLL     =(L =3.75 )   D1      =(L =.15 )   D2      =(L =.27 )   D3      =(L =.53 )   D4      =(L =.62 )   D5      =(L =.3 )
        D6      =(L =.36 )   DLS     =(L =1 )
 ;
 BEND   B1      =(L =1.13 ANGLE =.05235987733333333     E1 =.5    E2 =.5    K1 =-.7263925132909782 )
 ;
 QUAD   Q1      =(L =.3   K1 =.6550860672226918 )
        Q2      =(L =.2   K1 =-.11235728574040715 )
        Q3      =(L =.4   K1 =.9937313298017902 )
        Q4      =(L =.2   K1 =.04069478308633373 )
        Q5      =(L =.3   K1 =.83972985991269 )
 ;
