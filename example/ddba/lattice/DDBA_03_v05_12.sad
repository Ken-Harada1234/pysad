LINE
  NCELLH = (MKS
                DLN1 PM DLN2 S1H HV S1H D1 Q1 D1 S2H S2H D1H PM D1H Q2 D2
                B1
                D5 S3H HV S3H D31 PM D32 Q3 D1 S4H S4H D1 Q4 D32 PM D31 S5H HV S5H D5
                B2
                D6 Q5
                DLS1 PM DLS2 HV DLS3
           MKNC)
  NCELL = (MKNC -NCELLH NCELLH MKNE)
  RING = (MRST
              8*TCELL RFC 7*TCELL
          MRED)
  MCELLH = (MKMS
                DLM1 PM DLM2 S1MH HV S1MH D1 Q1M D1 S2MH S2MH D1H PM D1H Q2M D2
                B1M
                D5 S3MH HV S3MH D31 PM D32 Q3M D1 S4MH S4MH D1 Q4M D32 PM D31 S5MH HV S5MH D5
                B2M
                D6 Q5M
                DLS1 PM DLS2 HV DLS3
           MKMC)
