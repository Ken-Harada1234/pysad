! ======================================================================
! DDBA_02  v05_08_30cell
! 設計手順の段階: 1. 基本セルの構想 (セル数・直線部・偏向磁石の構成)
! 元の台本: v05_08_30cell (設計メモの添付 3.3 KB、元の台本 1400
!     byte。同名だがサイズが違う (要確認))
! 設計メモのページの最終更新: 2023/07/24
! 何の版か (設計メモの記述の要約): DBA x 2 を 28 セル (機能結合型の偏向磁石、直線部 7.5 m と 2 m が交互)
!     で検討した後、30 セルにして六極 (S1〜S5)
!     を当てずっぽうで入れた版。マッチング条件は短直線部中央の β、両直線部の色消し。水平アパーチャ
!     5 mm で足りるなら、として振幅依存チューンシフトを見ている
! 設計メモが書いている数値: 設計メモの出力 (5 GeV): U0 2.4124 MV、Vc 3.6 MV、alpha
!     9.4746e-5、f0 409888.51 Hz、チューン (48.6,
!     12.7)。v05_01 の段階で εx 1.14 nm rad、周長 700
!     m。この台本ファイルは 2.5 GeV・RF 5 MV
! pysad の cell calc emit (ON RAD FLUC COD RFSW RADCOD、リングのライン RING、k64 モード = gs と同じ):
!     エネルギー 2.5 GeV、周長 731.4000 m、チューン (48.6001, 12.7002)
!     εx = 3.182e-10 m rad (k64)、3.185e-10 m rad (v2 モード)、σE = 0.0004951、αc = 9.472e-05、U0 = 0.1508 MV
!     RF: 総電圧 5 MV、h = 992、周波数 406.609 MHz。偏向磁石 120 台 (L > 0, |ANGLE| > 0.02)、逆曲げなどの小角 BEND 0 台、四極 300 台、六極 300 台、八極 0 台
! 元のヘッダ: 元の台本の先頭にコメントのヘッダはない (先頭は MOMENTUM の行)。
! 変更: 改行を LF にした。ラティスの定義の中身は変えていない。
! ======================================================================
 MOMENTUM = 2.5GEV;

 DRIFT  DLL     =(L =3.75 )  D1      =(L =.15 )   D2      =(L =.27 )   D3      =(L =.33 )   D4      =(L =.62 )   D5      =(L =.3 )
        D6      =(L =.36 )   DLS     =(L =1 )
 ;
 BEND   B1      =(L =1.2  ANGLE =.05235987733333333     E1 =.5    E2 =.5    K1 =-.868771835846744 )
        B2      =(L =1.2  ANGLE =.05235987733333333     E1 =.5    E2 =.5    K1 =-.8687719854449119 )
 ;
 QUAD   Q1      =(L =.3   K1 =.44522796413339033 )
        Q2      =(L =.2   K1 =.20052710628632708 )
        Q3      =(L =.3   K1 =.673887977675576 )
        Q4      =(L =.3   K1 =.6738880431525528 )
        Q5      =(L =.3   K1 =.8264070492764574 )
 ;
 SEXT   S1      =(L =.2   K2 =8 )
        S2      =(L =.2   K2 =-8 )
        S3      =(L =.2   K2 =-30.99853085608388 )
        S4      =(L =.2   K2 =49.28995749440951 )
        S5      =(L =.2   K2 =-30.99853085608388 )
 ;

 CAVI   RFC     =(VOLT =5000000     HARM =992 )
 ;

MARK
  MRST = ()
  MNCS = ()
  MC   = ()
  MNCE = ()
  MRED = ()

  MKNS = ()
  MKNSA = ()
  MKNS = ()
  MKNC = ()
  MKNE = ()
  MKS = ()
;
LINE
  NCELLH = (MKS
                DLL S1 D1 Q1 D1 S2 D1 Q2 D2
                B1
                D5 S3 D3 Q3 D1 S4 D1 Q4 D3 S5 D5
                B2
                D6 Q5 !D6 Q6
                DLS
           MKNC)
  NCELL = (MKNS NCELLH -NCELLH MKNE)
  RING = (MRST
              15*NCELL RFC 15*NCELL
          MRED)
;
