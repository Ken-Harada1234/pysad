MOMENTUM = 3GEV;
! FODO ring: 24 cells, 15 deg bend per cell (2*pi total), 3 GeV
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS = (L=0.1);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = ();
CAVI RF = (L=0 VOLT=1.5E6 FREQ=5.0E8 PHI=0);
LINE CELL = (SF DS QF D2 B D2 QD DS SD D1);
LINE RING = (ORIGIN RF 24*CELL);
FFS;
$FORM="S17.10";
USE RING; CELL; CALC;
Print["R:nx0=",Twiss["NX","$$$"]/(2Pi)];
Print["R:ny0=",Twiss["NY","$$$"]/(2Pi)];
! QF と QD の K1 を変数にして、チューンを 6.75 / 4.85 に合わせる
FREE QF QD;
FIT NX 6.75 NY 4.85;
v=FFS["VAR"];
Print["variables=",Length[v]];
r=OptimizeOptics[Output->0,MaxIteration->60];
Print["R:kqf=",LINE["K1","QF.1"]];
Print["R:kqd=",LINE["K1","QD.1"]];
CALC;
Print["R:nx1=",Twiss["NX","$$$"]/(2Pi)];
Print["R:ny1=",Twiss["NY","$$$"]/(2Pi)];
Exit;
