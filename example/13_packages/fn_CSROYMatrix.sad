! CSROYMatrix は、手で作った正しい形の実数リストなら gs でも動く (36 要素。pysad と相対 1e-12 以内)。
! CSRSetupOY の出力は、4 番目 (zj) のリストの頭 (head) に zjn(1,1) が上書きされ、実数のリストでなくなるので wrongtype になる (gs の Head[s[[4]]] は数)。
FFS;
PageWidth=1999;
nr=64; nj=3; nphi=2; mphi=nphi*16;
wi=Table[0.01*Sin[0.37 i]/(1+i/10.),{i,1,nr}];
aj=Table[1e-8*i,{i,1,nj}];
om=Table[0.12+0.0003*i,{i,1,nj}];
zj=Table[2e-5*Sin[0.2 k+0.1]*(1+0.3 Mod[k,5]),{k,1,nj*mphi}];
dpj=Table[3e-4*Cos[0.17 k]*(1-0.1 Mod[k,7]),{k,1,nj*mphi}];
rj=Table[0.22/i,{i,1,nj}];
las={wi,aj,om,zj,dpj,rj};
m=CSROYMatrix[las,{2e-5,1e-8,0.01,3e-4,1e-3}];
Print["MD ",Dimensions[m]];
Print["MR ",Flatten[m]];
! CSRSetupOY の出力 s の 4 番目の Head (gs: 数、pysad k64: List)
rho=Table[Exp[-((i-16)*0.5)^2/8],{i,1,32}];
zl=Table[1./(1+i),{i,1,32}];
s=CSRSetupOY[rho,zl,{0.1,2,1,1.,0.3,-0.2,3.}];
Print["HEADS ",Map[Head,s]];
Exit;
