QUAD QF9 = (L=0.3 K1=0.7 DX=3.9674e-05 DY=-9.5791e-05);
BEND SH9 = (L=0.1 ANGLE=0) SV9 = (L=0.1 ANGLE=0 ROTATE=1.5707963267948966);
MARK BA9 = () BB9 = ();
LINE C9 = (SF DS QF9 BA9 D2 B D2 QD BB9 DS SD SH9 SV9 D1S);
QUAD QF10 = (L=0.3 K1=0.7 DX=-9.6140e-05 DY=4.2418e-05);
BEND SH10 = (L=0.1 ANGLE=0) SV10 = (L=0.1 ANGLE=0 ROTATE=1.5707963267948966);
MARK BA10 = () BB10 = ();
LINE C10 = (SF DS QF10 BA10 D2 B D2 QD BB10 DS SD SH10 SV10 D1S);
QUAD QF11 = (L=0.3 K1=0.7 DX=-1.4900e-05 DY=3.9267e-05);
BEND SH11 = (L=0.1 ANGLE=0) SV11 = (L=0.1 ANGLE=0 ROTATE=1.5707963267948966);
MARK BA11 = () BB11 = ();
LINE C11 = (SF DS QF11 BA11 D2 B D2 QD BB11 DS SD SH11 SV11 D1S);
QUAD QF12 = (L=0.3 K1=0.7 DX=9.9979e-05 DY=-9.4744e-05);
BEND SH12 = (L=0.1 ANGLE=0) SV12 = (L=0.1 ANGLE=0 ROTATE=1.5707963267948966);
MARK BA12 = () BB12 = ();
LINE C12 = (SF DS QF12 BA12 D2 B D2 QD BB12 DS SD SH12 SV12 D1S);
QUAD QF13 = (L=0.3 K1=0.7 DX=-1.0864e-05 DY=8.6984e-05);
BEND SH13 = (L=0.1 ANGLE=0) SV13 = (L=0.1 ANGLE=0 ROTATE=1.5707963267948966);
MARK BA13 = () BB13 = ();
LINE C13 = (SF DS QF13 BA13 D2 B D2 QD BB13 DS SD SH13 SV13 D1S);
QUAD QF14 = (L=0.3 K1=0.7 DX=-9.7180e-05 DY=-2.1166e-05);
BEND SH14 = (L=0.1 ANGLE=0) SV14 = (L=0.1 ANGLE=0 ROTATE=1.5707963267948966);
MARK BA14 = () BB14 = ();
LINE C14 = (SF DS QF14 BA14 D2 B D2 QD BB14 DS SD SH14 SV14 D1S);
QUAD QF15 = (L=0.3 K1=0.7 DX=3.5906e-05 DY=-5.8778e-05);
BEND SH15 = (L=0.1 ANGLE=0) SV15 = (L=0.1 ANGLE=0 ROTATE=1.5707963267948966);
MARK BA15 = () BB15 = ();
LINE C15 = (SF DS QF15 BA15 D2 B D2 QD BB15 DS SD SH15 SV15 D1S);
QUAD QF16 = (L=0.3 K1=0.7 DX=8.7927e-05 DY=9.9492e-05);
BEND SH16 = (L=0.1 ANGLE=0) SV16 = (L=0.1 ANGLE=0 ROTATE=1.5707963267948966);
MARK BA16 = () BB16 = ();
LINE C16 = (SF DS QF16 BA16 D2 B D2 QD BB16 DS SD SH16 SV16 D1S);
QUAD QF17 = (L=0.3 K1=0.7 DX=-5.8564e-05 DY=-7.3799e-05);
BEND SH17 = (L=0.1 ANGLE=0) SV17 = (L=0.1 ANGLE=0 ROTATE=1.5707963267948966);
MARK BA17 = () BB17 = ();
LINE C17 = (SF DS QF17 BA17 D2 B D2 QD BB17 DS SD SH17 SV17 D1S);
QUAD QF18 = (L=0.3 K1=0.7 DX=-7.2836e-05 DY=-1.1501e-06);
BEND SH18 = (L=0.1 ANGLE=0) SV18 = (L=0.1 ANGLE=0 ROTATE=1.5707963267948966);
MARK BA18 = () BB18 = ();
LINE C18 = (SF DS QF18 BA18 D2 B D2 QD BB18 DS SD SH18 SV18 D1S);
QUAD QF19 = (L=0.3 K1=0.7 DX=7.7333e-05 DY=7.5332e-05);
BEND SH19 = (L=0.1 ANGLE=0) SV19 = (L=0.1 ANGLE=0 ROTATE=1.5707963267948966);
MARK BA19 = () BB19 = ();
LINE C19 = (SF DS QF19 BA19 D2 B D2 QD BB19 DS SD SH19 SV19 D1S);
QUAD QF20 = (L=0.3 K1=0.7 DX=5.2908e-05 DY=-9.9234e-05);
BEND SH20 = (L=0.1 ANGLE=0) SV20 = (L=0.1 ANGLE=0 ROTATE=1.5707963267948966);
MARK BA20 = () BB20 = ();
LINE C20 = (SF DS QF20 BA20 D2 B D2 QD BB20 DS SD SH20 SV20 D1S);
QUAD QF21 = (L=0.3 K1=0.7 DX=-9.0967e-05 DY=5.6902e-05);
BEND SH21 = (L=0.1 ANGLE=0) SV21 = (L=0.1 ANGLE=0 ROTATE=1.5707963267948966);
MARK BA21 = () BB21 = ();
LINE C21 = (SF DS QF21 BA21 D2 B D2 QD BB21 DS SD SH21 SV21 D1S);
QUAD QF22 = (L=0.3 K1=0.7 DX=-2.9467e-05 DY=2.3409e-05);
BEND SH22 = (L=0.1 ANGLE=0) SV22 = (L=0.1 ANGLE=0 ROTATE=1.5707963267948966);
MARK BA22 = () BB22 = ();
LINE C22 = (SF DS QF22 BA22 D2 B D2 QD BB22 DS SD SH22 SV22 D1S);
QUAD QF23 = (L=0.3 K1=0.7 DX=9.8560e-05 DY=-8.8095e-05);
BEND SH23 = (L=0.1 ANGLE=0) SV23 = (L=0.1 ANGLE=0 ROTATE=1.5707963267948966);
MARK BA23 = () BB23 = ();
LINE C23 = (SF DS QF23 BA23 D2 B D2 QD BB23 DS SD SH23 SV23 D1S);
QUAD QF24 = (L=0.3 K1=0.7 DX=4.0693e-06 DY=9.3983e-05);
BEND SH24 = (L=0.1 ANGLE=0) SV24 = (L=0.1 ANGLE=0 ROTATE=1.5707963267948966);
MARK BA24 = () BB24 = ();
LINE C24 = (SF DS QF24 BA24 D2 B D2 QD BB24 DS SD SH24 SV24 D1S);
LINE RING = (ORIGIN RF C1 C2 C3 C4 C5 C6 C7 C8 C9 C10 C11 C12 C13 C14 C15 C16 C17 C18 C19 C20 C21 C22 C23 C24);
FFS;
$FORM="S17.10";
USE RING; CELL; CALC;
! 各セルの QF の直後・QD の直後に BPM (BAk, BBk)、D1 に水平 (SHk)・垂直 (SVk) ステアラ
mon=Monitor[Flatten[Table[{"BA"//ToString[k],"BB"//ToString[k]},{k,1,24}]]];
sh=Steer[Table["SH"//ToString[k],{k,1,24}]];
sv=Steer[Table["SV"//ToString[k],{k,1,24}]];
Print["monitors=",Length[mon[[1]]],"  steerers=",Length[sh[[1]]],"+",Length[sv[[1]]]];
rmy:=Sqrt[Plus@@Twiss["DY",mon[[1]]]^2/Length[mon[[1]]]];
rmx:=Sqrt[Plus@@Twiss["DX",mon[[1]]]^2/Length[mon[[1]]]];
Print["R:rmx0=",rmx];
Print["R:rmy0=",rmy];
! 垂直: 応答行列を作る光学を得て、最小二乗で補正 (補正量を戻し、LINE の K0 にも足す)
opt=CalculateOptics[1,LINE["LENGTH"],Twiss["*",1],FLAG["CELL"],2];
r=CorrectOrbit["Y",mon,sv,opt];
Print["nsteer=",Length[r],"  max kick=",Max[Abs[r]]];
CALC;
Print["R:rmy1=",rmy];
! 水平も同様
opt=CalculateOptics[1,LINE["LENGTH"],Twiss["*",1],FLAG["CELL"],2];
r=CorrectOrbit["X",mon,sh,opt];
CALC;
Print["R:rmx1=",rmx];
Print["R:rmy2=",rmy];
Exit;
