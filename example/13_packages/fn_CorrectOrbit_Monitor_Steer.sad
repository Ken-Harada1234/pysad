MOMENTUM = 3GEV;
! FODO_ring.sad と同じ光学 (24 セル、3 GeV、周長 105.6 m) に、BPM (MARK) とステアラ (BEND ANGLE=0) を各セルに入れ、
! 四極の据え付け誤差 DX・DY (乱数なし、式で決めた値、数 10〜100 um) を付けた誤差入りリング。補正・バンプ・光学最適化のパッケージの例に使う
! BAk: QF の直後の BPM、BBk: QD の直後の BPM。SHk/SVk: 水平・垂直ステアラ (D1 の最初の 0.2 m を置き換えるのでセル長は同じ)
DRIFT D2 = (L=0.5) DS = (L=0.1) D1S = (L=0.8);
QUAD  QD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = ();
CAVI RF = (L=0 VOLT=1.5E6 FREQ=5.0E8 PHI=0);
QUAD QF1 = (L=0.3 K1=0.7 DX=9.9166e-05 DY=-9.8748e-05);
BEND SH1 = (L=0.1 ANGLE=0) SV1 = (L=0.1 ANGLE=0 ROTATE=1.5707963267948966);
MARK BA1 = () BB1 = ();
LINE C1 = (SF DS QF1 BA1 D2 B D2 QD BB1 DS SD SH1 SV1 D1S);
QUAD QF2 = (L=0.3 K1=0.7 DX=-2.5554e-05 DY=7.7557e-05);
BEND SH2 = (L=0.1 ANGLE=0) SV2 = (L=0.1 ANGLE=0 ROTATE=1.5707963267948966);
MARK BA2 = () BB2 = ();
LINE C2 = (SF DS QF2 BA2 D2 B D2 QD BB2 DS SD SH2 SV2 D1S);
