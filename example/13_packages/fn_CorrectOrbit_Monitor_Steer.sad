BEND SH3 = (L=0.1 ANGLE=0) SV3 = (L=0.1 ANGLE=0 ROTATE=1.5707963267948966);
MARK BA3 = () BB3 = ();
LINE C3 = (SF DS QF3 BA3 D2 B D2 QD BB3 DS SD SH3 SV3 D1S);
QUAD QF4 = (L=0.3 K1=0.7 DX=4.9411e-05 DY=-7.1427e-05);
BEND SH4 = (L=0.1 ANGLE=0) SV4 = (L=0.1 ANGLE=0 ROTATE=1.5707963267948966);
MARK BA4 = () BB4 = ();
LINE C4 = (SF DS QF4 BA4 D2 B D2 QD BB4 DS SD SH4 SV4 D1S);
QUAD QF5 = (L=0.3 K1=0.7 DX=7.9849e-05 DY=9.9780e-05);
BEND SH5 = (L=0.1 ANGLE=0) SV5 = (L=0.1 ANGLE=0 ROTATE=1.5707963267948966);
MARK BA5 = () BB5 = ();
LINE C5 = (SF DS QF5 BA5 D2 B D2 QD BB5 DS SD SH5 SV5 D1S);
QUAD QF6 = (L=0.3 K1=0.7 DX=-6.9987e-05 DY=-6.1535e-05);
BEND SH6 = (L=0.1 ANGLE=0) SV6 = (L=0.1 ANGLE=0 ROTATE=1.5707963267948966);
MARK BA6 = () BB6 = ();
LINE C6 = (SF DS QF6 BA6 D2 B D2 QD BB6 DS SD SH6 SV6 D1S);
QUAD QF7 = (L=0.3 K1=0.7 DX=-6.1814e-05 DY=-1.7781e-05);
BEND SH7 = (L=0.1 ANGLE=0) SV7 = (L=0.1 ANGLE=0 ROTATE=1.5707963267948966);
MARK BA7 = () BB7 = ();
