MOMENTUM = 3GEV;
! FODO ring: 24 cells, 15 deg bend per cell (2*pi total), 3 GeV
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS = (L=0.1);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = ();
! BEAMBEAM: 弱-強モデル。強ビーム = ガウス分布 (IP で BX=BY=1 m、EMIX=EMIY=1e-8 m、SIGZ=1 mm)、NP 個、SLICE=1 は薄いレンズ
BEAMBEAM BB = (BX=1 BY=1 EMIX=1E-8 EMIY=1E-8 SIGZ=1E-3 DP=1E-3 SLICE=1 NP=1E9);
CAVI RF = (L=0 VOLT=1.5E6 FREQ=5.0E8 PHI=0);
LINE CELL = (SF DS QF D2 B D2 QD DS SD D1);
LINE RING = (ORIGIN RF 24*CELL);
LINE RINGB = (ORIGIN BB RF 24*CELL);   ! ORIGIN の直後に衝突点 BB
FFS;
NORFSW; NORAD; NOFLUC;
$FORM = "12.8";
USE RING; CELL; CALC;
Print["ring only: NX=", Twiss["NX","$$$"]/2/Pi, " NY=", Twiss["NY","$$$"]/2/Pi, " BX(ORIGIN)=", Twiss["BX","ORIGIN"], " BY=", Twiss["BY","ORIGIN"]];
! 弱ビームの小振幅粒子 (0.01 sigma) の 1 周ごとの座標から cos(mu) を出し、チューンの小数部を見る
a = 1e-6;
tune[b0_] := Module[{b = b0, xs = {}, ys = {}},
  Do[
    xs = Append[xs, b[[1,1]]]; ys = Append[ys, b[[3,1]]];
    b = TrackParticles[{1, b}, 1, n, n][[2]],
    {n, 1, 3}];
  {1 - ArcCos[(xs[[3]] + xs[[1]])/(2*xs[[2]])]/(2*Pi), 1 - ArcCos[(ys[[3]] + ys[[1]])/(2*ys[[2]])]/(2*Pi)}];
beam = {{a},{0},{a},{0},{0},{0},{1}};
Print["no BB   : frac(nu) from tracking  x,y = ", tune[beam]];
USE RINGB; CELL; CALC;
Print["with BB : NX=", Twiss["NX","$$$"]/2/Pi, " NY=", Twiss["NY","$$$"]/2/Pi, "   (光学には BEAMBEAM は効かない)"];
Print["with BB : frac(nu) from tracking  x,y = ", tune[beam]];
! 弱ビームの小さい x のキック: 1 粒子を IP の直後まで追跡 (位置 3 = BB の次)
r = TrackParticles[{1, {{a, 10*a},{0,0},{a, 10*a},{0,0},{0,0},{0,0},{1,1}}}, 3, 1, 1][[2]];
Print["kick px/x (小振幅) = ", r[[2,1]]/r[[1,1]], "   y: ", r[[4,1]]/r[[3,1]]];
Exit;
