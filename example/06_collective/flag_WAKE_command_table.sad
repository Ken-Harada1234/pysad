! 旧式の WAKE コマンドの表を行をまたいで書く (K64 の tfwake.f の構文)。
! 条件: 1.7 GeV の輸送路 (TRPT)、CAVI RF (L=0.4 m、VOLT=0)、バンチ 1e12 個、LWAKE・TWAKE が ON のとき TrackParticles で効く。
! 表の単位: s [m]、w [V/C] (縦: LONGITUDINAL)、[V/C/m] (横: TRANSVERSE)。1 行に何組でも書ける。注釈は `!`。表の途中に `;` は書けない。
! この例の flag_WAKE_command_table.pysad.txt は pysad の v2 モード (既定) の出力。PYSAD_COMPAT=k64 (K64 の動作) では WAKE は WAKECOMMAND[] を
! 評価するだけで表は読まれない (K64 の配布に WAKECOMMAND.n が無い)。同じ表を WakeFunction[…] = … で与えた結果と比べてある。
MOMENTUM = 1.7GEV;
DRIFT DR = (L=1);
QUAD QF = (L=0.3 K1=0.6) QD = (L=0.3 K1=-0.5);
CAVI RF = (VOLT=0 HARM=100 PHI=0.2 L=0.4);
MARK ST = ();
LINE BL = (ST QF DR RF DR QD DR);
FFS USE BL;
TRPT; INS; LWAKE; TWAKE; NORAD; NOFLUC;
PBUNCH = 1E12; NBUNCH = 1;
n = 200;
x0  = Table[1e-3*Sin[0.37*i], {i, n}];
px0 = Table[1e-4*Cos[0.11*i], {i, n}];
y0  = Table[1e-3*Cos[0.23*i], {i, n}];
py0 = Table[1e-4*Sin[0.71*i], {i, n}];
z0  = Table[0.01*Sin[0.13*i]+1e-4*i-0.01, {i, n}];
dp0 = Table[1e-3*Cos[0.31*i], {i, n}];
fl0 = Table[1, {i, n}];
$FORM = "16.10";
track[tag_] := Module[{r, res},
  r = TrackParticles[{1, {x0, px0, y0, py0, z0, dp0, fl0}}, 7, 1];
  res = r[[2]];
  Print[tag];
  Do[Print[k, " ", Plus@@res[[k]], " ", res[[k, 1]], " ", res[[k, 200]]], {k, 6}]];
track["no wake:"];
WAKE LONGITUDINAL RF
  -0.1   2e9          ! s [m]   w [V/C]
  -0.02  1e9
   0     5e8    0.02 -1e9     ! 1 行に 2 組
   0.1  -2e9
   0.2  -1e9
ENDWAKE;
WAKE TRANSVERSE RF
   0     1e12   0.01  5e11
   0.05  1e11   0.2   0
   0.3   0
ENDWAKE;
track["old WAKE command (table over several lines):"];
WakeFunction[Longitudinal, "RF"] = {{-0.1, 2e9}, {-0.02, 1e9}, {0, 5e8}, {0.02, -1e9}, {0.1, -2e9}, {0.2, -1e9}};
WakeFunction[Transverse, "RF"] = {{0, 1e12}, {0.01, 5e11}, {0.05, 1e11}, {0.2, 0}, {0.3, 0}};
track["WakeFunction with the same table (must be identical):"];
! エラーの例 (台本は止まらず次へ進む)
WAKE T QF
  0 1e9  0.1 0
ENDWAKE;
WAKE L RF
  0 1e9  0.1
ENDWAKE;
Exit;
