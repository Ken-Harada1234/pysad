FFS;
n = 1;
a = n + 1;
b := n + 1;
n = 10;
Print["= ", a, "  := ", b];
Print["== ", 1 == 1, 1 == 2, {1, 2} == {1, 3}, "ab" == "ab"];
Print["=== ", 1 === 1, {1, 2} === {1, 3}, {1, 2} === {1, 2}, f[x] === f[x], 1 === 1.0];
Print["<> ", 1 <> 2, "  <=> ", 1 <=> 2];
v = 10; v += 5; v -= 3; v *= 2; v /= 4;
Print["+= -= *= /= : ", v];
i = 1; Print["i++ ", i++, " then ", i, "   ++i ", ++i, "  i-- ", i--, "  --i ", --i];
{p, q} = {1, 2}; Print["{p,q} = ", p, q];
{p, q} = {q, p}; Print["swap ", p, q];
t = {0, 0, 0}; t[[2]] = 5; Print["part set ", t];
w = 3; w =.; Print["unset ", w];
h[1] = "one"; h[2] = "two"; Print["h ", h[1], h[2], h[3]];
Print["list arithmetic ", {1, 2} + {10, 20}, 2*{1, 2}, {1, 2}^2, {1, 2}.{3, 4}];
Print["precedence ", 2 + 3*4^2, " ", -2^2, " ", 2^3^2, " ", 1 - 2 - 3, " ", 12/3/2];
Exit;
