FFS;
Print["a -> 1 : ", {a, b, a} /. a -> 1];
Print["list of rules ", {x, y} /. {x -> 1, y -> 2}];
r = {x -> 1, y -> 2};
Print["f[x, y] /. r ", f[x, y] /. r];
Print["Cases on rules ", Cases[r, (x -> v_) -> v]];
c = 1;
r1 = {u -> c};
r2 = {u :> c};
c = 2;
Print["-> ", u /. r1, "   :> ", u /. r2];
cnt = 0;
Print["-> ", Table[k /. k -> (cnt++), {3}], "  :> ", Table[k /. k :> (cnt++), {3}]];
Print["pattern rule ", {1, 2, 3, 4} /. n_?EvenQ -> 0];
Print["f[a_] rule ", {f[1], f[2]} /. f[a_] -> a^2];
Print["//. repeated ", {1, {2, {3}}} //. {a_} -> a];
Print["/. once ", x /. {x -> y, y -> z}, "  //. ", x //. {x -> y, y -> z}];
Print["Replace ", Replace[f[1], f[a_] -> a]];
Print["lookup ", "b" /. {"a" -> 1, "b" -> 2}];
Exit;
