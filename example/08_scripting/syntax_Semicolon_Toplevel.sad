MOMENTUM = 3GEV;
! FODO ring: 24 cells, 15 deg bend per cell (2*pi total), 3 GeV
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS = (L=0.1);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = ();
CAVI RF = (L=0 VOLT=1.5E6 FREQ=5.0E8 PHI=0);
LINE CELL = (SF DS QF D2 B D2 QD DS SD D1);
LINE RING = (ORIGIN RF 24*CELL);
FFS;
(* FFS の最上位では ; は 1 行の中の文の区切りで、末尾の ; は結果の表示 (Out) を抑える *)
1 + 2
1 + 2;
a = 5
a = 6;
Print["a = ", a];
b = 1; c = 2; d = b + c
Print["Out の有無: 上の 1 + 2 は Out が出る (FFS では式の値が表示される場合がある)"];
(* 改行だけで区切った場合: ; が無くても行が完結していれば 1 つの文 *)
x = 1
y = 2
Print[x + y];
(* 行が完結していない (括弧・演算子が残る) と次の行に続く *)
z = 1 +
  2 +
  3;
Print["z = ", z];
(* FFS コマンドと SADScript の式の混在 *)
USE RING; CELL; CALCULATE; Print["NX=", Twiss["NX","$$$"]/2/Pi];
w = 7; Print["w=", w]; USE RING;
Exit;
