FFS;
l = {5, 3, 8, 1, 9, 2};
Print["Length   ", Length[l]];
Print["Take 3   ", Take[l, 3], " Take -2 ", Take[l, -2], " Take {2,4} ", Take[l, {2, 4}]];
Print["Drop 2   ", Drop[l, 2], " Drop -2 ", Drop[l, -2]];
Print["First/Last/Rest ", First[l], " ", Last[l], " ", Rest[l]];
Print["Join     ", Join[{1, 2}, {3}, {4, 5}]];
Print["Append/Prepend ", Append[{1, 2}, 3], " ", Prepend[{1, 2}, 0]];
Print["Flatten  ", Flatten[{1, {2, {3, 4}}, 5}], " level1 ", Flatten[{1, {2, {3, 4}}, 5}, 1]];
Print["Sort     ", Sort[l], " Sort> ", Sort[l, Greater]];
Print["Reverse  ", Reverse[l]];
Print["Range    ", Range[5], Range[2, 8, 3], Range[0, 1, 0.25]];
Print["Select   ", Select[l, # > 4 &]];
Print["Insert   ", Insert[{a, b, c}, x, 2]];
Print["Delete   ", Delete[{a, b, c, d}, 2]];
Print["Complement ", Complement[{1, 2, 3, 4, 5}, {2, 4}]];
Print["Union/Intersection ", Union[{3, 1, 2, 3, 1}], " ", Intersection[{1, 2, 3, 4}, {3, 4, 5}]];
Print["Partition ", Partition[Range[7], 3], " ", Partition[Range[5], 2, 1]];
Print["Dimensions ", Dimensions[{{1, 2, 3}, {4, 5, 6}}], " Depth ", Depth[{1, {2}}]];
Print["RotateLeft ", RotateLeft[{1, 2, 3, 4}, 1], " RotateRight ", RotateRight[{1, 2, 3, 4}, 1]];
Print["Sum/Product ", Sum[i, {i, 10}], " ", Product[i, {i, 5}]];
Print["Fold    ", Fold[Plus, 0, {1, 2, 3}], " ", Fold[f, x, {a, b}]];
Print["Part    ", l[[2]], " ", l[[{1, 3}]], " ", l[[-1]]];
Print["ReplacePart ", ReplacePart[{a, b, c}, z, 2]];
Print["Difference ", Difference[{1, 4, 9, 16}]];
Print["MapIndexed ", MapIndexed[List, {a, b}]];
Print["Extract ", Extract[{{1, 2}, {3, 4}}, {2, 1}]];
Print["Dot/Vec ", {1, 2, 3}.{4, 5, 6}, " ", {1, 2} + {10, 20}, " ", 2*{1, 2}];
Exit;
