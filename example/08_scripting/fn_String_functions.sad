FFS;
s = "Hello, SAD World";
Print["StringLength ", StringLength[s]];
Print["StringJoin ", StringJoin["ab", "cd", "ef"], " // ", "x" // 1 // "y"];
Print["part ", s[1, 5], " ", s[-5, -1], " ", s[1]];
Print["StringPosition ", StringPosition["abcbcbcbcb", "bcb"], StringPosition["abcbcbcbcb", "bcb", 2]];
Print["StringReplace ", StringReplace["abcbcbcbc", "bcb" -> "xyx"]];
Print["StringReplace 2 ", StringReplace["abcbcbcbc", {"bcb" -> "xy", "cbc" -> "pqrs"}]];
Print["StringTrim [", StringTrim["  pad\t "], "]"];
Print["StringFill ", StringFill["ab", "-", 7], " ", StringFill["ab", "-", -7]];
Print["StringMatchQ * ", StringMatchQ["QF.1", "QF*"], StringMatchQ["QD.1", "QF*"]];
Print["StringMatchQ % ", StringMatchQ["Q1", "Q%"], StringMatchQ["Q12", "Q%"], StringMatchQ["QF1", "Q%%"]];
Print["StringMatchQ {} ", StringMatchQ["QF", "Q{FD}"], StringMatchQ["QX", "Q{FD}"], StringMatchQ["QX", "Q{^FD}"], StringMatchQ["SF", "QF|SF"]];
Print["StringMatchQ ? (SAD の wildcard ではない) ", StringMatchQ["Q1", "Q?"]];
Print["ToUpper/Lower ", ToUpperCase[s], " ", ToLowerCase[s]];
Print["Characters ", Characters["abc"]];
Print["ToCharacterCode ", ToCharacterCode["AZ"], " FromCharacterCode ", FromCharacterCode[{83, 65, 68}], FromCharacterCode[65]];
Print["ToExpression ", ToExpression["1+2*3"], " ", ToExpression["Range[3]"]];
Print["Symbol ", Symbol["abc"], " SymbolName ", SymbolName[abc]];
Print["DigitQ/LetterQ ", DigitQ["123"], DigitQ["12a"], LetterQ["abc"], LetterQ["a1"]];
Print["StringDrop ", StringDrop["abcdef", 2], " ", StringDrop["abcdef", -2]];
Print["StringInsert ", StringInsert["abcdef", "-", 3]];
Print["escape tab quote ", ToCharacterCode["\t\""]];
Print["escape backslash ", ToCharacterCode["\\"]];
Print["escape octal 101 ", ToCharacterCode["\101"]];
Print["number to string ", "x=" // 1.5 // ", n=" // 3];
Exit;
