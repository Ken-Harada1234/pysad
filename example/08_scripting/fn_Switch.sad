FFS;
h[x_] := Switch[x, 1, "one", 2 | 3, "two-three", _String, "str", _, "other"];
Print["Switch  ", h /@ {1, 3, "q", 9, 2.5}];
Print["no match ", Switch[9, 1, "one"]];
Print["Switch string ", Switch["ab", "x", 1, "ab", 2, _, 3]];
sw[x_] := Switch[x, _String, "string", _Real, "real", _List, "list", _, "other"];
Print["by type ", sw["a"], " ", sw[1.5], " ", sw[{1}], " ", sw[f]];
Print["Switch pattern variable ", Switch[f[3], f[x_], x*10, _, 0]];
Exit;
