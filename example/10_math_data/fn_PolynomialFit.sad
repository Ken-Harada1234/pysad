! PolynomialFit (ラティスなし。乱数なし)
FFS;
$FORM="S17.10";
! y = 1 + 2 x - 0.5 x^2 に決定的な小さな揺らぎ 0.02 sin(5x) を足した 11 点
dat=Table[{x,1+2*x-0.5*x^2+0.02*Sin[5*x]},{x,0,5,0.5}];
r2=PolynomialFit[dat,2];
Print["order2=",r2];
Print["R:c0=",r2[[1,1]]];
Print["R:c1=",r2[[1,2]]];
Print["R:c2=",r2[[1,3]]];
Print["R:res2=",Residual/.r2[[2]]];
! 1 次で当てはめると残差が大きくなる
r1=PolynomialFit[dat,1];
Print["order1=",r1];
Print["R:d0=",r1[[1,1]]];
Print["R:d1=",r1[[1,2]]];
Print["R:res1=",Residual/.r1[[2]]];
Exit;
