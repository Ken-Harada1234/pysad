! SingularValues (ラティスなし)。Packages/Matrix.n: 既定は Inverse->True (特異値の逆数を返す)
FFS;
$FORM="S17.12";
a={{3.,1.},{1.,3.},{0.,2.}};
! 既定 {u, 1/w, v}。1/w は昇順
s=SingularValues[a];
Print["s=",s];
Print["R:inv1=",s[[2,1]]];
Print["R:inv2=",s[[2,2]]];
Print["dims=",Map[Dimensions,s]];
! Inverse->False なら特異値そのもの (降順)
t=SingularValues[a,Inverse->False];
Print["t=",t];
Print["R:w1=",t[[2,1]]];
Print["R:w2=",t[[2,2]]];
! 再構成: A = U^T diag(w) V (Inverse->False)。既定のままだと 疑似逆行列の転置になる
Print["recon=",Transpose[t[[1]]].DiagonalMatrix[t[[2]]].t[[3]]];
Print["pinvT=",Transpose[s[[1]]].DiagonalMatrix[s[[2]]].s[[3]]];
Exit;
