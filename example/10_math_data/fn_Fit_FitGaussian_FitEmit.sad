! Fit / FitGaussian / FitEmit (ラティスなし。乱数なし、決定的なデータ)
FFS;
$FORM="S17.10";
! (1) Fit: y = 2 x + 1 + 0.1 sin(3x), x=1..10 を a + b x で当てはめる
dat=Table[{i,2*i+1+0.1*Sin[i*3]},{i,1,10}];
r=Fit[dat,a+b*x,x,{a,1},{b,1}];
Print["fit=",r];
Print["R:a=",a/.r];
Print["R:b=",b/.r];
Print["R:chi=",ChiSquare/.r];
! (2) FitGaussian: 正規分布の分位点 (sigma=0.8, mean=0.3) に小さな揺らぎ
n=400;
d=Table[Sqrt[2]*InverseErf[2*(i-0.5)/n-1]*0.8+0.3+0.05*Sin[i*1.3],{i,n}];
g=FitGaussian[d];
Print["fg=",g];
Print["R:sig=",g[[1]]];
Print["R:mean=",g[[2]]];
! (3) FitEmit: 独立な 2 つの正規分布から (x,px) を作る。eps=1e-6, beta=5, alpha=-1
n=300;
u=Table[Sqrt[2]*InverseErf[2*(i-0.5)/n-1],{i,n}];
v=Table[u[[Mod[i*37,n]+1]],{i,n}];
eps=1e-6; bet=5.; alp=-1.;
x=Sqrt[eps*bet]*u;
px=Sqrt[eps/bet]*(v-alp*u);
e=FitEmit[x,px];
Print["fe=",e];
Print["R:alpha=",e[[1,3]]];
Print["R:beta=",e[[1,4]]];
Print["R:emit=",e[[1,5]]];
Exit;
