! NIntegrate (ラティスなし)
FFS;
$FORM="S17.15";
Print["R:sin=",NIntegrate[Sin[x],{x,0,Pi}]];
Print["R:pi=",NIntegrate[4/(1+x^2),{x,0,1}]];
Print["R:gauss=",NIntegrate[Exp[-x^2],{x,-5,5}]];
Print["R:sqrt=",NIntegrate[Sqrt[x],{x,0,1}]];
Print["R:cplx=",NIntegrate[Exp[I*x],{x,0,Pi}]];
Print["R:acc=",NIntegrate[Sin[x],{x,0,Pi},AccuracyGoal->1e-6]];
Print["R:ip=",NIntegrate[Sin[x],{x,0,Pi},InitialPoints->50]];
Exit;
