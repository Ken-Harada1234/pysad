FFS;
(* 複素引数の PolyLog・Zeta・HurwitzZeta・HypergeometricU。pysad は独立な参照 (Borwein、Euler–Maclaurin、spence、積分表示) と相対 1e-11 以内。
   gs が正しい点 (P1 P2 P3 P4 P5 P7 P8 P10 Z1 Z3 Z4 Z7 H2 U2 U3 U5 U6 U8) は gs と相対 1e-13 で一致。
   gs が誤る点: H1 (HurwitzZeta[2+I,.5]: gs は相対 12% 違う)、H3、L1・L2 (非整数次の PolyLog、第 3 象限・|z|>1)、U1・U9 (b が整数で NaN)、U10 (相対 1e-8) *)
PageWidth=200;
Print["P1 ",PolyLog[2,0.5+0.5*I]];
Print["P2 ",PolyLog[2,2+I]];
Print["P3 ",PolyLog[3,-3+2*I]];
Print["P4 ",PolyLog[2.5,0.3+0.4*I]];
Print["P5 ",PolyLog[2,-0.5-0.5*I]];
Print["P7 ",PolyLog[2,2-0.1*I]];
Print["P8 ",PolyLog[2,2+0.1*I]];
Print["P10 ",PolyLog[0.5,0.9*I]];
Print["L1 ",PolyLog[2.5,-1.2-0.2*I]];
Print["L2 ",PolyLog[1.5,-3.2843023372255384-3.5397879004724295*I]];
Print["Z1 ",Zeta[2+3*I]];
Print["Z3 ",Zeta[-1+2*I]];
Print["Z4 ",Zeta[0.5*I]];
Print["Z7 ",Zeta[2*I]];
Print["H1 ",HurwitzZeta[2+I,0.5]];
Print["H2 ",HurwitzZeta[2,0.5+I]];
Print["H3 ",HurwitzZeta[2+I,3.5]];
Print["U1 ",HypergeometricU[1,2,0.5+0.5*I]];
Print["U2 ",HypergeometricU[0.5,1.5,1+I]];
Print["U3 ",HypergeometricU[0.5,1.5,-1+0.1*I]];
Print["U5 ",HypergeometricU[0.5,1.5,-2]];
Print["U6 ",HypergeometricU[-2,1.5,2+I]];
Print["U8 ",HypergeometricU[0.5,1.5,3*I]];
Print["U9 ",HypergeometricU[2,3,-0.5+0.5*I]];
Print["U10 ",HypergeometricU[1.5,3,20+5*I]];
Exit;
