MOMENTUM = 3GEV;
! FODO ring: 24 cells, 15 deg bend per cell (2*pi total), 3 GeV
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS = (L=0.1);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = ();
! COORD = 座標変換 (ずらし DX DY DZ と回転 CHI1 CHI2 CHI3)。DIR=1 は逆変換。C2 は C1 の逆変換: DIR=1 は「回してからずらす」の順で、回転角は符号を反転して与える (DY, DZ は符号が逆に効くので使わない: elem_COORD.md)
COORD C1 = (DX=1E-3 CHI3=0.01) C2 = (DX=1E-3 CHI3=-0.01 DIR=1);
COORD C3 = (DX=1E-3 DY=-2E-3 CHI3=0.01);   ! 単独の変換の追跡用 (DY もある)
CAVI RF = (L=0 VOLT=1.5E6 FREQ=5.0E8 PHI=0);
LINE CELL = (SF DS QF D2 B D2 QD DS SD D1);
LINE RING = (ORIGIN RF 24*CELL);
LINE RINGC = (ORIGIN C1 RF 24*CELL C2);   ! リング全体を C1 と C2 で挟む (座標系ごとずれたリングと同じ)
LINE RINGCP = (ORIGIN C1 C2 RF 24*CELL);  ! C1 の直後に逆変換 C2 (打ち消して元のリングと同じ)
LINE RINGC3 = (ORIGIN C3 RF 24*CELL);   ! 単独の COORD C3 のあるリング (追跡の位置合わせ用)
