! v2.3.0 Q2: SAD の台本から 6 極の共鳴駆動項・ADTS・クロマティシティを出す (pysad の新しい FFS 関数。K64 の gs にはない)。
! 条件: 小さな FODO (example/00_lattice/FODO_ring.sad と同じ。24 セル、3 GeV、105.6 m、νx = 6.696329、νy = 4.906056) に 6 極 SF・SD の K2L = 4、−6 を入れた。
!   δ = 0 の設計光学 (CALC)、結合・垂直分散なし、6 極は厚い式 (Method->"Analytic")、数値積分 (Method->"Numeric", Slices->n) と照合する。
! 関数: ResonanceDrivingTerms[Terms->{"h21000",...}, Method->, Slices->]  → {H21000->{実部, 虚部}, ...}
!       AmplitudeTuneShift[Method->, Slices->]  → {DNuxDJx->, DNuxDJy->, DNuyDJy->, Sextupole->{xx,xy,yy}, Octupole->{xx,xy,yy}}  (J はアクション、1/(m rad))
!       ChromaticityTerms[Order->n, DeltaMax->]  → {Tunes->, D1->(∂ν/∂δ), D2->(∂²ν/∂δ²), ..., SextupolePart->(6 極の 1 次の寄与)}
! 実行: py -3.12 run_sad.py example/14_nonlinear_dynamics/adts_rdt/fn_ResonanceDrivingTerms_fodo.sad
MOMENTUM = 3GEV;
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS = (L=0.1);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=4) SD = (L=0.2 K2=-6);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = ();
CAVI RF = (L=0 VOLT=1.5E6 FREQ=5.0E8 PHI=0);
LINE CELL = (SF DS QF D2 B D2 QD DS SD D1);
LINE RING = (ORIGIN RF 24*CELL);
FFS;
USE RING; CELL; CALC;
Print["Tunes ", {Twiss["NX","$$$"]/2/Pi, Twiss["NY","$$$"]/2/Pi}];
Print["RDT (10 terms, analytic) ", ResonanceDrivingTerms[]];
Print["RDT numeric 16 slices    ", ResonanceDrivingTerms[Terms->{"h21000","h30000","h11001"}, Method->"Numeric", Slices->16]];
Print["ADTS analytic ", AmplitudeTuneShift[]];
Print["ADTS numeric 16 ", AmplitudeTuneShift[Method->"Numeric", Slices->16]];
Print["Chromaticity ", ChromaticityTerms[Order->3]];
Exit;
