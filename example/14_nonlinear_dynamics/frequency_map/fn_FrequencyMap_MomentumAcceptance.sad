! SAD の台本から使う FrequencyMap[]・MomentumAcceptance[]・TouschekLifetimeLMA[] (K64 にない pysad の追加機能。gs では走らない)。
! 使い方 (リポジトリ直下から): py -3.12 run_sad.py example/astrid/lattice/ASTRID2_v01_01.sad example/14_nonlinear_dynamics/frequency_map/fn_FrequencyMap_MomentumAcceptance.sad
! 条件: ASTRID2 (0.58 GeV、周長 45.7 m、6 セル、RF 50 kV)。周波数マップは NORFSW・NORAD、位置 2 (長直線部)、11 × 8 の格子、512 周。
!       LMA は RFSW・RAD (FLUC なし)・RADCOD、アパーチャ LOSSAMPL = 10 mm (例の値)、最初のセルの位置を Distance->0.9 m おきに (6 点)、損失の判定は 1 要素ごと (CheckEvery->1)、周回数はシンクロトロン振動 2 周期分 (既定)。
FFS;
USE RING; CELL; CALC;
NORFSW; NORAD;
LOSSAMPL = 0.1;
f = FrequencyMap[2, 512, X->{0.0005, 0.018, 11}, Y->{0.0005, 0.014, 8}, Output->"fn_FrequencyMap_MomentumAcceptance_fmap.table.txt", Plot->"fn_FrequencyMap_MomentumAcceptance_fmap.png"];
Print["points ", Length[Diffusion /. f], ", lost ", Count[LostTurn /. f, _?(# > 0 &)]];
Print["D(smallest amplitude) = ", (Diffusion /. f)[[1]], ", nux = ", (NuX /. f)[[1]], ", nuy = ", (NuY /. f)[[1]]];
RFSW; RAD; RADCOD; NOFLUC;
Emittance[];
INTRA; PBUNCH = 1e9;
Emittance[];
LOSSAMPL = 0.01;
m = MomentumAcceptance[Cell->True, Distance->0.9, Workers->2, CheckEvery->1, Output->"fn_FrequencyMap_MomentumAcceptance_lma.table.txt", Plot->"fn_FrequencyMap_MomentumAcceptance_lma.png"];
Print["S      = ", S /. m];
Print["DPPlus = ", DPPlus /. m];
Print["DPMinus= ", DPMinus /. m];
Print["Touschek lifetime with local acceptance [s] = ", TouschekLifetimeLMA[]];
Exit;
