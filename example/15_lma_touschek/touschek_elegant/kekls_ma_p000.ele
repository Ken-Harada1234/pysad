&run_setup
  lattice = kekls_ma.lte, use_beamline = RING,
  p_central_mev = 3000.000000, default_order = 3,
  rootname = kekls_ma_p000,
&end
&run_control n_passes = 1500 &end
&momentum_aperture
  output = %s.mmap, output_mode = 0, soft_failure = 1, fiducialize = 1, verbosity = 1,
  x_initial = 0, y_initial = 0,
  delta_negative_start = 0, delta_negative_limit = -0.050000,
  delta_positive_start = 0, delta_positive_limit = 0.050000,
  delta_step_size = 0.005, splits = 6, split_step_divisor = 2,
  include_name_pattern = "AM001",
&end
