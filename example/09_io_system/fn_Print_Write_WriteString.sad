FFS;
Print["Print: a newline is appended. ", 1, " ", 2.5, " ", "str", " ", {1, 2}, " ", x + y];
Print["no args:"]; Print[];
Print["real forms ", 1/3, " ", 1.5e10, " ", 123456789012, " ", 1e-5, " ", -0.5];
Print["string vs symbol: ", "text", " ", text];
f = TemporaryName[];
fd = OpenWrite[f];
Write[fd, "Write adds a newline ", 1, " ", {1, 2, 3}];
WriteString[fd, "WriteString: no newline "];
WriteString[fd, "(same line) ", 3.5, "\n"];
Write[fd, a + b];
Close[fd];
fd = OpenRead[f];
Print["read back 1: ", ReadString[fd]];
Print["read back 2: ", ReadString[fd]];
Print["read back 3: ", ReadString[fd]];
Close[fd];
(* $Output が標準出力 (-1)。ファイル番号 -1 で Write すると画面に出る *)
Print["$Output = ", $Output];
Write[$Output, "Write to $Output"];
WriteString[$Output, "WriteString to $Output\n"];
DeleteFile[f];
Exit;
