FFS;
x = Pi*1000;
Print["default $FORM = ", $FORM];
Print[x, " ", Pi/1000];
$FORM = "10.4"; Print["10.4  ", x, " ", Pi/1000, " ", 1];
$FORM = "S10.4"; Print["S10.4 ", x, " ", 2.5, " ", 1];
$FORM = "F10.4"; Print["F10.4 ", x, " ", Pi/1000, " ", 2.5];
$FORM = "M10.4"; Print["M10.4 ", x, " ", Pi/1000e10];
$FORM = "6.2"; Print["6.2   ", x, " ", {Pi, 2*Pi}];
$FORM = "12.8"; Print["12.8  ", Pi, " ", -Pi, " ", 100*Pi];
$FORM = "17.15"; Print["17.15 ", Pi];
Print["StandardForm ", StandardForm[Pi]];
$FORM = "10.4";
Print["$FORM stays ", $FORM, "  ", StandardForm[$FORM], "  ", $FORM];
$FORM = "S17.15";
Print["PageWidth = ", PageWidth];
PageWidth = 40;
Print["narrow ", Range[30]];
PageWidth = 130;
Print["wide ", Range[30]];
Exit;
