FFS;
f = TemporaryName[];
a = OpenWrite[f];
Write[a, "alpha beta, gamma  12.5 7"];
Write[a, "x+y  3*4"];
Write[a, "1 2 3"];
Write[a, "4 5 6"];
Write[a, "end of file"];
Close[a];
c = OpenRead[f];
Print["Word     ", Read[c, Word]];
Print["Word     ", Read[c, Word]];
Print["list {Word,Word,Real} ", Read[c, {Word, Real, Real}]];
Print["Expression ", Read[c, Expression]];
Print["{Real,Real}   ", Read[c, {Real, Real}]];
Print["list     ", Read[c, {Real, Real, Real}]];
Print["Character", Read[c, Character]];
Print["ReadString (rest) [", ReadString[c], "]"];
Print["next ReadString ", ReadString[c]];
Close[c];
a = OpenWrite[f]; Write[a, "a:b:c"]; Write[a, "d:e"]; Close[a];
c = OpenRead[f];
Print["WordSeparators ", Read[c, Word, WordSeparators -> ":"], Read[c, Word, WordSeparators -> ":"]];
Close[c];
c = OpenRead[f];
Print["ReadNewRecord->False ", Read[c, Word, ReadNewRecord -> False, WordSeparators -> ":"], " ", Read[c, Word, ReadNewRecord -> False, WordSeparators -> ":"]];
Close[c];
DeleteFile[f];
Exit;
