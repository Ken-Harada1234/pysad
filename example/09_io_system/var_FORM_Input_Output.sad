FFS;
Print["$FORM   = ", $FORM];
Print["$Input  = ", $Input];
Print["$Output = ", $Output];
Print["Head ", Head[$Input], " ", Head[$Output]];
$FORM = "8.3";
Print[Pi, " ", 1/3];
$FORM = "S17.15";
Print[Pi];
f = TemporaryName[];
a = OpenWrite[f];
Write[a, "from file"];
Close[a];
c = OpenRead[f];
Write[$Output, "writing to the console via $Output"];
Close[c];
DeleteFile[f];
Exit;
