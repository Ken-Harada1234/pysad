FFS;
PRINT 1 + 2;
OUTPUT "ex_out.txt";
PRINT 3 + 4;
Print["Print inside OUTPUT is also redirected"];
CLOSE OUTPUT;
PRINT "back on the console";
APPEND "ex_out.txt";
PRINT 5 * 6;
CLOSE OUTPUT;
c = OpenRead["ex_out.txt"];
Print["--- content of ex_out.txt ---"];
While[(s = ReadString[c]) <=> EndOfFile, Print["| ", s]];
Close[c];
a = OpenWrite["ex_cmd.txt"];
Write[a, "x = 11;"];
Write[a, "Print[\"inside READ file x=\", x];"];
Close[a];
READ "ex_cmd.txt";
Print["after READ x = ", x];
INPUT "ex_cmd.txt";
Print["after INPUT"];
DeleteFile["ex_out.txt"]; DeleteFile["ex_cmd.txt"];
Exit;
