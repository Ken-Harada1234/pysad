FFS;
f = TemporaryName[];
Print["TemporaryName is a String: ", Head[f]];
a = OpenWrite[f];
Print["file number is Real: ", Head[a], " ", a > 0];
Write[a, "line 1"];
Write[a, "line 2"];
Close[a];
b = OpenAppend[f];
Write[b, "line 3 (appended)"];
Close[b];
c = OpenRead[f];
n = 0;
While[(s = ReadString[c]) <=> EndOfFile, n++; Print[n, ": ", s]];
Close[c];
Print["lines ", n];
a = OpenWrite[f]; Write[a, "rewritten"]; Close[a];
c = OpenRead[f]; Print["after OpenWrite: ", ReadString[c], " / ", ReadString[c]]; Close[c];
Print["FileType ", FileType[f], "  FileQ ", FileQ[f]];
DeleteFile[f];
Print["after delete ", FileType[f], "  FileQ ", FileQ[f]];
a = OpenWrite[f]; b = OpenWrite[f // "2"]; Close[{a, b}];
Print["Close[{a,b}] done"];
DeleteFile[f]; DeleteFile[f // "2"];
Exit;
