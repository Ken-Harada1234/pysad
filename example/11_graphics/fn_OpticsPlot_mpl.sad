MOMENTUM = 3GEV;
! FODO ring: 24 cells, 15 deg bend per cell (2*pi total), 3 GeV
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS = (L=0.1);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = ();
CAVI RF = (L=0 VOLT=1.5E6 FREQ=5.0E8 PHI=0);
LINE CELL = (SF DS QF D2 B D2 QD DS SD D1);
LINE RING = (ORIGIN RF 24*CELL);
FFS;
! pysad の拡張 (gs には無い): Graphics を Tk でなく matplotlib に描く。環境変数 PYSAD_DISPLAY=mpl と PYSAD_DISPLAY_FILE=x.png でも同じ
$DisplayFunction=MatplotlibDrawer;
MatplotlibDrawer$Option={File->"fn_OpticsPlot_mpl_plot.png"};   ! 2 枚目以降は _plot_2.png のように番号が付く (上書きしない)
USE RING; CELL; CALC;
Print["NX=",Twiss["NX","$$$"]/2/Pi];
g=OpticsPlot[{{"BX","BY"},{"EX"}},PlotLabel->"FODO ring 3 GeV"];
Print["Head=",Head[g]," Length=",Length[g]];
h=Plot[Sin[x],{x,0,6},FrameLabel->{"x","sin x"}];
k=ListPlot[{{1,1},{2,4},{3,9},{4,16}},PlotJoined->True,Legend->"x^2",PlotLabel->"ListPlot"];
Exit;
