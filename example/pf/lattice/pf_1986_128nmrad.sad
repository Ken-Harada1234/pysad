!============================================================================
!  pf_1986_128nmrad.sad : PF リング (2.5 GeV) の 1986 年 のオプティクス
!  最初の高輝度化のオプティクス (PF 履歴フォルダの pf0 と同じ内容)
!----------------------------------------------------------------------------
!  元のファイル: pf_128nmrad
!  周長      187.0741 m (RING の 2*HALF = リング全体。HALF は半周)
!  チューン  nux = 8.45400, nuy = 3.30000 (元のヘッダの NUX=8.454 NUY=3.300 と一致)
!  エミッタンス  名前は 128 nm rad、計算値は 1.213e-7 m rad (121 nm rad)。名前と合わない (要確認)
!  エネルギー 2.5 GeV (MOMENTUM=2.5 GEV)、偏向磁石 28 台 (矩形、E1=E2=0.5)、空洞 CAVI 2 台 (各 VOLT 850 kV)。
!  元は設計値のラティス (誤差なし)。数値は ON RAD FLUC COD RFSW RADCOD; のあとの `cell calc emit` の値
!  (gs と pysad の k64 モードで全桁一致。example/pf/lattice/PF_history.md の表)。
!  整理: なし (台本の中身は元のまま。改行を LF にしただけ)。
!        RING = (IMARK III 2*HALF RMARK)、HALF = (HMARK -RQUAD LQUAD) で周回のラインになっている (Get・USE・計算コマンドは無い)。
!        -RQUAD の中の -RQUADM (二重の反転) を pysad が正しく展開しなかったので、pysad/parser.py を直した (gs は元から正しい)。
!============================================================================
!  ---- 元のヘッダ (pf_128nmrad の先頭) ----
!***********************************************************************
!*       PF-RING MEDIUM-E LOW-B HIGH NUY OPTICS VERSION
!*       THIS IS HALF LATTICE OF PF-RING
!*       NUX=8.454 NUY=3.300
!*
!*       SEXTUPOLE(SF,SD) 2 FAMILY CORRECTION
!*       OCTUPOLE (OCT1,OCT2,OCT3,OCT4)
!*         B'''L/BRHO =-180.9144 (OCT1,2,4 = -1.6(A))
!*                    =-252.2826 (OCT3     = -1.6(A))
!*
!*       HORIZONTAL STEERING (=BENDING CORRECTION COIL)
!*       VERTICAL STEERING (=VERTICAL DIPOLE (VD))
!*       POSITION MONITOR (PM)
!***********************************************************************
MOMENTUM=2.5 GEV;
OFF CTIME;OFF   ECHO;ON COD;
 ;
 MARK RMARK=()
      HMARK=()
      QMARK=()
      MMARK   =(ALPHAX =-8.8817842E-16 BETAX = 23.1259849194
                ALPHAY =-8.8817842E-16 BETAY = 7.4165730053
                EX = 1.2674828181      EPX = 3.8857806E-16 )
      DMARK=()
      IMARK=()
 ;
 MONI PM=()
 ;
 CAVI CAVI=(VOLT= 850000 FREQ=500000000)
 ;
 OCT  OCT3=(K3=-157.2826)
      OCT2=(K3=-112.9144)
      OCT1=(K3=-112.9144)
      OCT4=(K3=-112.9144)
! OCT -1.6A
 ;
 BEND   B02     =(L = 1.944076 ANGLE = 0.22439698  E1 = 0.5 E2=0.5)
        B03     =(L = 1.944076 ANGLE = 0.22439698  E1 = 0.5 E2=0.5)
        B04     =(L = 1.944076 ANGLE = 0.22439698  E1 = 0.5 E2=0.5)
        B05     =(L = 1.944076 ANGLE = 0.22439698  E1 = 0.5 E2=0.5)
        B06     =(L = 1.944076 ANGLE = 0.22439698  E1 = 0.5 E2=0.5)
        B07     =(L = 1.944076 ANGLE = 0.22439698  E1 = 0.5 E2=0.5)
        B08     =(L = 1.944076 ANGLE = 0.22439698  E1 = 0.5 E2=0.5)
        B09     =(L = 1.944076 ANGLE = 0.22439698  E1 = 0.5 E2=0.5)
        B10     =(L = 1.944076 ANGLE = 0.22439698  E1 = 0.5 E2=0.5)
        B11     =(L = 1.944076 ANGLE = 0.22439698  E1 = 0.5 E2=0.5)
        B12     =(L = 1.944076 ANGLE = 0.22439698  E1 = 0.5 E2=0.5)
        B13     =(L = 1.944076 ANGLE = 0.22439698  E1 = 0.5 E2=0.5)
        B14     =(L = 1.944076 ANGLE = 0.22439698  E1 = 0.5 E2=0.5)
        B15     =(L = 1.944076 ANGLE = 0.22439698  E1 = 0.5 E2=0.5)

        VD      =(L = 0   ROTATE = -90 DEG )
 ;
  DRIFT  III    =(L = 0 )
        L309    =(L = 3.09 )
        L303    =(L = 3.03 )
        L224    =(L = 2.24 )
        L213    =(L = 2.13 )
        L1065   =(L = 1.065 )
        L1055   =(L = 1.055 )
        L091    =(L = 0.91 )
        L066    =(L = 0.66 )
        L060    =(L = 0.60 )
        L056    =(L = 0.56 )
        L054    =(L = 0.54 )
        L053    =(L = 0.53 )
        L050    =(L = 0.50 )
        L045    =(L = 0.45 )
        L0425   =(L = 0.425 )
        L042    =(L = 0.42 )
        L0415   =(L = 0.415 )
        L041    =(L = 0.41 )
        L040    =(L = 0.40 )
        L0395   =(L = 0.395 )
        L036    =(L = 0.36 )
        L035    =(L = 0.35 )
        L033    =(L = 0.33 )
        L032    =(L = 0.32 )
        L030    =(L = 0.30 )
        L0275   =(L = 0.275 )
        L0265   =(L = 0.265 )
        L026    =(L = 0.26 )
        L025    =(L = 0.25 )
        L0225   =(L = 0.225 )
        L022    =(L = 0.22 )
        L021    =(L = 0.21 )
        L0205   =(L = 0.205 )
        L020    =(L = 0.20 )
        L019    =(L = 0.19 )
        L018    =(L = 0.18 )
        L0165   =(L = 0.165 )
        L015    =(L = 0.15 )
        L0145   =(L = 0.145 )
        L0125   =(L = 0.125 )
        L012    =(L = 0.12 )
        L0113   =(L = 0.113 )
        L0112   =(L = 0.112 )
        L010    =(L = 0.10 )
        L0075   =(L = 0.075 )
        L005    =(L = 0.05 )
        LESP    =(L = 1E-8 )
 ;
 QUAD   QFH     =(L = .25 K1 = .2308209 )
        QDH     =(L = .25 K1 = -.1156956 )
        Q10H    =(L = .25 K1 = .1439818932 )
        Q9H     =(L = .25 K1 = .2326126409 )
        QAH     =(L = .25 K1 = -.2683059682 )
        Q8H     =(L = .25 K1 = .1274162816 )
        Q6H     =(L = .3  K1 = .3203662759 )
        Q5H     =(L = .3  K1 = -.2369520412 )
        Q3H     =(L = .25 K1 = -.2965672325 )
        Q4H     =(L = .5  K1 = .6795459596 )
        Q2H     =(L = .375     K1 = .3754598701 )
        Q1H     =(L = .375     K1 = -.29867433 )

        SQ1     =(L = .0   ROTATE = -45 DEG)
        SQ2     =(L = .0   ROTATE = -45 DEG)
 ;
 SEXT   SF      =(L = .0   K2 = .0)
        SD      =(L = .0   K2 = .0)

 ;


 LINE   RING    =(IMARK III 2*HALF  RMARK)

        HALF    =(HMARK -RQUAD  LQUAD)

        NCELL   =(QFR   QDRC  QFRC  MMARK QFLC  QDLC  QFL)

        LQUAD   =(MMARK   LQUADM  QMARK)
        LQUADM  =(QFLC  QDLC  QFL   QDL   Q10L  Q9L   QAL   Q8L
                  Q6L   Q5L   Q4L   Q3L   Q2L   Q1L   )
        LQUAD1  =(MMARK   LQUADM1  )
        LQUADM1 =(QFLC  QDLC  QFL   QDL   Q10L  Q9L   QAL   Q8L   Q6L   Q5L)

        RQUAD   =(MMARK  -RQUADM QMARK)
        RQUAD1  =(MMARK  -RQUADM1 )

        RQUADM  =(Q1R   Q2R   Q3R   Q4R   Q5R   Q6R   Q8R   QAR
                  Q9R   Q10R  QDR   QFR   QDRC  QFRC  )
        RQUADM1 =(Q5R   Q6R   Q8R   QAR   Q9R   Q10R  QDR   QFR   QDRC  QFRC  )

        Q1R     =(L224  PM    L026  Q1H   )
        Q2R     =(Q1H   L018  Q2H  )
        Q3R     =(Q2H   L0265 PM    L0415 VD    L1055 B02
                  L050  VD    L010  PM    L0125 Q3H )
        Q4R     =(Q3H   L018  Q4H   Q4H   L018  Q3H   )
        Q5R     =(Q3H   L0112 PM    L0113 VD    L050  B03
                  L056  VD    L0165 Q5H   )
        Q6R     =(Q5H   L018  Q6H   )
        Q8R     =(Q6H   L026  PM    L054  OCT1  L036  OCT2  L1065 CAVI
                  L1065 PM    L026  L050  L018  Q8H   )
        QAR     =(Q8H   L0165 VD    L056  DMARK B04
                  L091  VD    L0165 QAH   )
        Q9R     =(QAH   L021  SD    L019  Q9H   )
        Q10R    =(Q9H   L0265 PM    L309  VD    L0395 Q10H  )
        QDR     =(Q10H  L0225 SF    L040  PM    L030  B05   L053  VD    L0205
                  SD    L019  QDH  )
        QFR     =(QDH   L0265 PM    L033  OCT3  L033  B06   L053  VD    L0205
                  SF    L019  QFH  )
        QDRC    =(QFH   L0225 SF    L040  PM    L030  B07   L053  VD    L0205
                  SD    L019  QDH  )
        QFRC    =(QDH   L0265 PM    L033  SQ1   L033  B08   L053  VD    L0205
                  SF    L019  QFH  )
!
! Mirror Symmetry Point
!
        QFLC    =(QFH   L0265 PM    L033  OCT4  L033  B09   L053  VD    L0205
                  SD    L019  QDH  )
        QDLC    =(QDH   L0265 PM    L066  B10   L053  VD    L0205 SF    L019
                  QFH  )
        QFL     =(QFH   L0265 PM    L066  B11   L053  VD    L0205 SD    L019
                  QDH  )
        QDL     =(QDH   L0265 PM    L033  SQ2   L033  B12   L030  PM    L040
                  SF    L0225 Q10H  )
        Q10L    =(Q10H  L0395 VD    L309  PM    L0265 Q9H   )
        Q9L     =(Q9H   L021  SD    L019  QAH   )
        QAL     =(QAH   L0165 VD    L091  B13   DMARK L056  VD    L0165 Q8H  )
        Q8L     =(Q8H   L018  L050  L026  PM    L303  PM    L026  Q6H   )
        Q6L     =(Q6H   L018  Q5H   )
        Q5L     =(Q5H   L0165 VD    L056  B14   L050  VD    L0113 PM    L0112
                  Q3H   )
        Q4L     =(Q3H   L018  Q4H   Q4H   L018  Q3H   )
        Q3L     =(Q3H   L0125 PM    L010  VD    L050  B15   L1055 VD    L0415
                  PM    L0265 Q2H   )
        Q2L     =(Q2H   L018  Q1H   )
        Q1L     =(Q1H   L026  PM    L224  )
;
