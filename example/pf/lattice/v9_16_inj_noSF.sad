 SEXT   SFH     =(L =.1   K2 =3.9242032090679 )
        SDH     =(L =.1   K2 =-3.9053258695379 )
 ;
 OCT    OCT     =(L = .2   K3 =  .0 )
 ;

 DRIFT  LLS1    =(L =4.365 ) L050    =(L =.05 )   L300    =(L =.3 )    L250    =(L =.25 )   LLS2    =(L =.605 )
        LLS3    =(L =2.605 ) LLS32   =(L =2.455 ) L400    =(L =.4 )    LLS4    =(L =2.545 ) L110    =(L =.11 )   L220    =(L =.22 )
        L080    =(L =.08 )   L100    =(L =.1 )    L200    =(L =.2 )    L500    =(L =.5 )    L225    =(L =.225 )
        LLS5    =(L =2.2125 )       LLS33   =(L =2.405 ) LI5     =(L =.168 )  LI6     =(L =.132 )  LI1     =(L =.23 )
        LI2     =(L =2.63 )  LI3     =(L =.685 )  LI4     =(L =.28 )   LLS331  =(L =.35 )   LLS332  =(L =1.755 )
        LSX     =(L = .1)
