 ;
!VD : vertical dipole (slow corrector)
!PV : vertical dipole for feedback (fast corrector)
!PH : horizontal dipole for feedback (do not exist in the real machine)
!VS : vertical dipole (correction coil of the sextupole magnet)

 BEND   VD      =(L = 0.15 K0 = 0     ROTATE =-90 DEG )
        PV      =(L = 0    K0 = 0     ROTATE =-90 DEG ) 
        PH      =(L = 0    K0 = 0  )
        VS      =(L = 0    K0 = 0     ROTATE =-90 DEG)
 ;
!SQ : skew quadrupole corrector (correction coil for the sextupole magnet)
 QUAD   SQ      =(L = 0   K1 = .0 ROTATE=45  deg)
 ;
 QUAD   Q1      =(L =.4   K1 =.698096426338 )
        Q2      =(L =.4   K1 =-.6928509495915 )
        Q3      =(L =.3   K1 =-.7582257471804 )
        Q4      =(L =.3   K1 =.8485774395228 )
        Q5B     =(L =.4   K1 =-.7477651492198 )
        Q6B     =(L =.4   K1 =.8213108186402 )
