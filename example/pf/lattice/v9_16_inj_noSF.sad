LINE
! fast steering set
        PHV    = (PH PV) 
! "MPHV" and "MPM" is the place where geometrically we can install steering magnets
! and beam position monitors (but we do not install them, not decided yet).

        N1     =(MKNCWS
                 QF
                 L100            SFH  SQ SFH   L200            B09    L300  QD
                 L050  PM  L050  SDH  VS SDH   L500  PHV  L050    PM  L050
                 )
        NCELL = (N1)
        NN1    =(MKNN1S
                 L175 PHV  L050    PM  L050
                 QF
                 L100            SFH  SQ SFH   L200            B09    L300  QD
                 L050  PM  L050  SDH  VS SDH 
                 L325 
                 MKNN1E)
