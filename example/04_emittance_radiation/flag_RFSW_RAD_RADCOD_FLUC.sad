MOMENTUM = 3GEV;
! FODO ring: 24 cells, 15 deg bend per cell (2*pi total), 3 GeV
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS = (L=0.1);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = ();
CAVI RF = (L=0 VOLT=4.0E6 FREQ=5.0E8 PHI=0);
LINE CELL = (SF DS QF D2 B D2 QD DS SD D1);
LINE RING = (ORIGIN RF 24*CELL);
! QF から始まる並び (RADINT は先頭が SEXT だと DL=0 で NaN になるため。FODO_ring と同じ磁石列、位相だけ違う)
LINE CELLQ = (QF D2 B D2 QD DS SD D1 SF DS);
LINE RINGQ = (ORIGIN RF 24*CELLQ);
FFS;
$FORM = "10.6";
USE RINGQ;
CELL;
CALCULATE;

rep[tag_] := Module[{e = Emittance[]},
  Print[tag, " U0=", EnergyLossU0 /. e, " Vc=", RfVoltageVc /. e, " dz=", EquilibriumPosition /. e,
        " ex=", (Emittances /. e)[[1]], " sigE=", MomentumSpread /. e, " sigz=", BunchLength /. e,
        " Stable=", Stable /. e]];
NORFSW; NORAD; NORADCOD; rep["RFSW=0 RAD=0 RADCOD=0 FLUC=1"];
NORFSW; RAD; NORADCOD;   rep["RFSW=0 RAD=1 RADCOD=0 FLUC=1"];
RFSW; NORAD; NORADCOD;   rep["RFSW=1 RAD=0 RADCOD=0 FLUC=1"];
RFSW; RAD; NORADCOD;     rep["RFSW=1 RAD=1 RADCOD=0 FLUC=1"];
RFSW; RAD; RADCOD;       rep["RFSW=1 RAD=1 RADCOD=1 FLUC=1"];
NORFSW; RAD; RADCOD;     rep["RFSW=0 RAD=1 RADCOD=1 FLUC=1"];
RFSW; RAD; NORADCOD; NOFLUC; rep["RFSW=1 RAD=1 RADCOD=0 FLUC=0"];
FLUC;
SeedRandom[7];
RFSW; RAD; NORADCOD;
b0 = Table[{0},{6}]; 
np = 200;
beam = {Table[0,{np}],Table[0,{np}],Table[0,{np}],Table[0,{np}],Table[0,{np}],Table[0,{np}],Table[1,{np}]};
Do[ beam = TrackParticles[{1, beam}, 1, 1, 1][[2]]; , {100}];
Print["FLUC  rms dp after 100 turns (RFSW RAD) ", Sqrt[Plus @@ (beam[[6]]^2)/np]];
NOFLUC;
beam = {Table[0,{np}],Table[0,{np}],Table[0,{np}],Table[0,{np}],Table[0,{np}],Table[0,{np}],Table[1,{np}]};
Do[ beam = TrackParticles[{1, beam}, 1, 1, 1][[2]]; , {100}];
Print["NOFLUC rms dp after 100 turns (RFSW RAD) ", Sqrt[Plus @@ (beam[[6]]^2)/np]];
Exit;
