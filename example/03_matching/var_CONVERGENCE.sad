MOMENTUM = 3GEV;
! FODO ring: 24 cells, 15 deg bend per cell (2*pi total), 3 GeV
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS = (L=0.1);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = ();
CAVI RF = (L=0 VOLT=1.5E6 FREQ=5.0E8 PHI=0);
LINE CELL = (SF DS QF D2 B D2 QD DS SD D1);
LINE RING = (ORIGIN RF 24*CELL);
FFS;
! 特殊変数: CONVERGENCE (収束判定) MAXITERATION (反復上限) ExponentOfResidual OffMomentumWeight DP DP0
$FORM = "10.6";
USE RING; CELL; CALC;
Print["CONVERGENCE = ", CONVERGENCE, "  ExponentOfResidual = ", ExponentOfResidual, "  OffMomentumWeight = ", OffMomentumWeight, "  DP = ", DP, "  DP0 = ", DP0];
FREE QF QD;
FIT $$$;
NX 6.7 NY 4.9;
CONVERGENCE = 1E-3;
GO;
Print["CONVERGENCE 1e-3: K1 = ", LINE["K1","QF.1"], " ", LINE["K1","QD.1"], "  NX NY = ", Twiss["NX","$$$"]/2/Pi, " ", Twiss["NY","$$$"]/2/Pi];
QF K1 0.7; QD K1 -0.6;
CONVERGENCE = 1E-9;
GO;
Print["CONVERGENCE 1e-9: K1 = ", LINE["K1","QF.1"], " ", LINE["K1","QD.1"], "  NX NY = ", Twiss["NX","$$$"]/2/Pi, " ", Twiss["NY","$$$"]/2/Pi];
QF K1 0.7; QD K1 -0.6;
MAXITERATION 2;
GO;
Print["MAXITERATION 2: K1 = ", LINE["K1","QF.1"], " ", LINE["K1","QD.1"], "  NX NY = ", Twiss["NX","$$$"]/2/Pi, " ", Twiss["NY","$$$"]/2/Pi];
DP0 = 0.001;
CALC;
Print["DP0 = 0.001: NX NY = ", Twiss["NX","$$$"]/2/Pi, " ", Twiss["NY","$$$"]/2/Pi];
Exit;
