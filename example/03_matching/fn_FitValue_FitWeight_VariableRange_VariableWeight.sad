MOMENTUM = 3GEV;
! FODO ring: 24 cells, 15 deg bend per cell (2*pi total), 3 GeV
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS = (L=0.1);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
SEXT  SF = (L=0.2 K2=0) SD = (L=0.2 K2=0);
BEND  B  = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK  ORIGIN = ();
CAVI RF = (L=0 VOLT=1.5E6 FREQ=5.0E8 PHI=0);
LINE CELL = (SF DS QF D2 B D2 QD DS SD D1);
LINE RING = (ORIGIN RF 24*CELL);
FFS;
! フック関数: FitValue (目標値の書き換え) FitWeight (重み) VariableRange (範囲) VariableWeight (変数の重み)
$FORM = "10.6";
USE RING; CELL; CALC;
FREE QF QD;
FIT $$$;
NX 6.7 NY 4.9;
GO;
Print["plain      : K1 QF QD = ", LINE["K1","QF.1"], " ", LINE["K1","QD.1"], "  NX NY = ", Twiss["NX","$$$"]/2/Pi, " ", Twiss["NY","$$$"]/2/Pi];
! FitValue: NX の目標を goal + 0.05 にする
FitValue["$$$", "NX", {_, dp_}, goal_, now_] := goal + 0.05*2*Pi;
GO;
Print["FitValue   : K1 QF QD = ", LINE["K1","QF.1"], " ", LINE["K1","QD.1"], "  NX NY = ", Twiss["NX","$$$"]/2/Pi, " ", Twiss["NY","$$$"]/2/Pi];
FitValue["$$$", "NX", {_, dp_}, goal_, now_] := goal;
! FitWeight: NY の重みを 100 倍
QF K1 0.7; QD K1 -0.6;
FitWeight["$$$", "NY", {_, dp_}, w_] := 100*w;
GO;
Print["FitWeight  : K1 QF QD = ", LINE["K1","QF.1"], " ", LINE["K1","QD.1"], "  NX NY = ", Twiss["NX","$$$"]/2/Pi, " ", Twiss["NY","$$$"]/2/Pi];
FitWeight["$$$", "NY", {_, dp_}, w_] := w;
! VariableRange: QD の K1 を -0.58 以上 (絶対値 0.58 以下) に制限
QF K1 0.7; QD K1 -0.6;
VariableRange["QD", "K1", v_] := {-0.58, 0};
GO;
Print["VariableRange QD in [-0.58,0]: K1 QF QD = ", LINE["K1","QF.1"], " ", LINE["K1","QD.1"], "  NX NY = ", Twiss["NX","$$$"]/2/Pi, " ", Twiss["NY","$$$"]/2/Pi];
VariableRange["QD", "K1", v_] := {-1E10, 1E10};
! VariableWeight: QF の重みを 0.1 倍
QF K1 0.7; QD K1 -0.6;
VariableWeight["QF", "K1", v_] := 0.1*v;
GO;
Print["VariableWeight: K1 QF QD = ", LINE["K1","QF.1"], " ", LINE["K1","QD.1"], "  NX NY = ", Twiss["NX","$$$"]/2/Pi, " ", Twiss["NY","$$$"]/2/Pi];
Exit;
