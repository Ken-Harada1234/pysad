! ============================================================
! bench_level10.sad — Level 10 benchmark: 放射の揺らぎ (RAD + FLUC) の粒子追跡
!   Level 6 のリング。emit で trf0 を決めてから 5 粒子を追跡。
!   乱数は既定プラグイン "SAD" (合同法)。追跡の直前に SeedRandom[17] で種を固定し、
!   追跡後に SeedRandom[] で内部状態 (seed) を出す (pysad と乱数を引いた回数を照合するため)。
! ============================================================
ON LOG;

MOMENTUM= 2.5 GEV;

MARK ORG = ()
;
DRIFT D1  = (L=1.2)
      DQS = (L=0.1)
      DS  = (L=0.9)
;
QUAD  QF  = (L=0.3 K1= 1.8*0.3)
      QD  = (L=0.3 K1=-1.7*0.3)
;
SEXT  SF = (L=0.2 K2= 0.6)
      SD = (L=0.2 K2=-1.2)
;
BEND  B  = (L=0.8 ANGLE=0.157079632679490 E1=0.5 E2=0.5)
;
CAVI  CA  = (L=0   VOLT=1.5E6 HARM=234)
;
LINE CELL0 = (ORG CA QF DQS SF DS B D1 QD DQS SD DS B D1);
LINE CELL  = (ORG QF DQS SF DS B D1 QD DQS SD DS B D1);
LINE RING  = (CELL0 19*CELL);
;

FFS;
