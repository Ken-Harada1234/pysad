! ============================================================
! bench_level3d.sad — Level 3D benchmark: strength errors (DK, DDK)
!   ラティスは bench_level3c.sad と同じ (QD K1=-1.7*0.3, QF-DQS-SF, QD-DQS-SD, DS=0.9)。
!   DK  σ elem : 既定キーワード (QUAD は K1) への相対誤差 (errk, terror.f)
!   DDK σ elem : K0 への絶対誤差 (BEND では追加の曲げ角)
!   誤差: QF.2 に DK (1 台), QD* に DK (全台に別々の乱数), B.3 に DDK (1 台)。
!   σ: DK 1e-3, DDK 1e-4。GCUT=2, SeedRandom[23]。
!   比べる量: 誤差の値, 閉軌道, 光学 (β, η, チューン), Emittance[]。
! ============================================================
ON LOG;

MOMENTUM= 2.5 GEV;

MARK ORG = ()
;
DRIFT D1  = (L=1.2)
      DQS = (L=0.1)
      DS  = (L=0.9)
;
QUAD  QF = (L=0.3 K1= 1.8*0.3)
      QD = (L=0.3 K1=-1.7*0.3)
;
SEXT  SF = (L=0.2 K2= 0.6)
      SD = (L=0.2 K2=-1.2)
;
BEND  B  = (L=0.8 ANGLE=0.157079632679490 E1=0.5 E2=0.5)
;
LINE CELL = (ORG QF DQS SF DS B D1 QD DQS SD DS B D1);
LINE RING = (20*CELL);
;

FFS;
