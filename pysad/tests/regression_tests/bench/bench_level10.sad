! ============================================================
! bench_level10.sad — Level 10 benchmark: 放射の揺らぎ (RAD + FLUC) の粒子追跡
!   Level 6 のリング。emit で trf0 を決めてから 5 粒子を追跡。
!   乱数は既定プラグイン "SAD" (合同法)。追跡の直前に SeedRandom[17] で種を固定し、
!   追跡後に SeedRandom[] で内部状態 (seed) を出す (pysad と乱数を引いた回数を照合するため)。
! ============================================================
ON LOG;

MOMENTUM= 2.5 GEV;

MARK ORG = ()
;
DRIFT D1  = (L=1.2)
      DQS = (L=0.1)
      DS  = (L=0.9)
;
QUAD  QF  = (L=0.3 K1= 1.8*0.3)
      QD  = (L=0.3 K1=-1.7*0.3)
;
SEXT  SF = (L=0.2 K2= 0.6)
      SD = (L=0.2 K2=-1.2)
;
BEND  B  = (L=0.8 ANGLE=0.157079632679490 E1=0.5 E2=0.5)
;
CAVI  CA  = (L=0   VOLT=1.5E6 HARM=234)
;
LINE CELL0 = (ORG CA QF DQS SF DS B D1 QD DQS SD DS B D1);
LINE CELL  = (ORG QF DQS SF DS B D1 QD DQS SD DS B D1);
LINE RING  = (CELL0 19*CELL);
;

FFS;
$FORM="15.10";

x0  = { 1E-3, 3E-3, 0,     1E-3,  0    };
px0 = { 0,    0,    0,     1E-4,  0    };
y0  = { 0,    0,    1E-3,  1E-3,  0    };
py0 = { 0,    0,    0,     0,     0    };
z0  = { 0,    0,    0,     0,     1E-3 };
dp0 = { 0,    0,    0,     1E-3,  1E-3 };
fl0 = { 1,    1,    1,     1,     1    };
beam0 = {1, {x0, px0, y0, py0, z0, dp0, fl0}};

prtb[tag_, b_] := Do[
  Print[tag, " P", i, " ", {b[[2,1,i]], b[[2,2,i]], b[[2,3,i]], b[[2,4,i]], b[[2,5,i]], b[[2,6,i]], b[[2,7,i]]}],
  {i, 1, 5}];

Print["=== Test 10: RING, RAD + FLUC, SeedRandom[17] ==="];
USE RING;
RFSW;
CELL;
CALC;
emit;
RAD;
FLUC;
Print["FLAGS ", {RAD, FLUC, PHOTONS, FIXSEED}];
SeedRandom[17];
b1   = TrackParticles[beam0, 1, 1, 1];
prtb["F T1", b1];
Print["SEED T1 ", SeedRandom[]];
SeedRandom[17];
b10  = TrackParticles[beam0, 1, 1, 10];
prtb["F T10", b10];
Print["SEED T10 ", SeedRandom[]];
SeedRandom[17];
b100 = TrackParticles[beam0, 1, 1, 100];
prtb["F T100", b100];
Print["SEED T100 ", SeedRandom[]];
NORAD;

stop;
stop;
