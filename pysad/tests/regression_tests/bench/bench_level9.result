 *** Run time Environment:     /mnt/d/work/SAD-master/SAD-master/Packages/init.local.n ***
 RFSW RADCOD RAD  FLUC  INTRA POL   COD  DAPER EMIOU K64   FOURI SMEAR
   F     F     F     T     F     F     T     F     F     T     F     T
 $FORM="15.10";
 
 x0  = { 1E-3, 3E-3, 0,     1E-3,  0    };
 px0 = { 0,    0,    0,     1E-4,  0    };
 y0  = { 0,    0,    1E-3,  1E-3,  0    };
 py0 = { 0,    0,    0,     0,     0    };
 z0  = { 0,    0,    0,     0,     1E-3 };
 dp0 = { 0,    0,    0,     1E-3,  1E-3 };
 fl0 = { 1,    1,    1,     1,     1    };
 beam0 = {1, {x0, px0, y0, py0, z0, dp0, fl0}};
 
 prtb[tag_, b_] := Do[
   Print[tag, " P", i, " ", {b[[2,1,i]], b[[2,2,i]], b[[2,3,i]], b[[2,4,i]], b[[2,5,i]], b[[2,6,i]], b[[2,7,i]]}],
   {i, 1, 5}];
 
 Print["=== Test 9: RINGS (SOL BZ=2 T around D1 QD) ==="];
=== Test 9: RINGS (SOL BZ=2 T around D1 QD) ===
 USE RINGS;
Out[1]:= USE
 RFSW;
 CELL;
