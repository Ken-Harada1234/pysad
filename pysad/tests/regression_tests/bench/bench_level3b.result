$$$       f AY    #######  #    .422243 $$$       f BY    #######  #    .669153 $$$       f NY    #######  #   8.009509
$$$       f LENG  #######  #  140.00000
 
 ! 最小二乗の多項式当てはめ (bench_level3a.sad と同じ。SAD の PolynomialFit はバグあり)
 MyPolyFit[d_,nord_]:=Module[{x,y,h,u,col,a,m,v,c,k,res},
   {x,y}=Thread[d];
   h=Max[Abs[x]];
   u=x/h;
   col=Table[1,{Length[x]}];
   a={};
   Do[AppendTo[a,col]; col=col*u,{k,0,nord}];
   a=Transpose[a];
   m=Transpose[a].a;
   v=Transpose[a].y;
   c=LinearSolve[m,v];
   res=Sqrt[(Plus@@((a.c-y)^2))/Length[x]];
   {Table[c[[k+1]]/h^k,{k,0,nord}],res}];
 
 ! ------------------------------------------------------------
 ! (1) 誤差を 1 台だけ入れる
 ! ------------------------------------------------------------
 GCUT = 2;
 SeedRandom[13];
 DELX 1E-4 QD.1;
 DELY 1E-4 SF.1;
 cell calc;
 Matched. (  0.000    ) DP = 0.01000  DP0 = 0.00000  ExponentOfResidual = 2.0  OffMomentumWeight =   1.000  CALEXP  
