! ============================================================
! bench_level3b.sad — Level 3B benchmark: closed orbit through sextupoles
!   ラティスは bench_level3a.sad を基に、QF-SF と QD-SD の間に 0.1 m のドリフト DQS を挟んだもの
!   (ドリフトなしで続けると SF は QF と一緒に動き、SF 単独の誤差を入れられないため)。
!   周長 140 m を保つため DS を 0.9 m にした。六極は補正前の K2。
!   誤差を 1 台だけ入れる: QD.1 に DELX、SF.1 に DELY (σ=1e-4, GCUT=2, SeedRandom[13])。
!   比べる量: 誤差の値, 閉軌道, COD ありの光学 (チューン, β, 結合 R1-R4), 色収差。
! ============================================================
ON LOG;

MOMENTUM= 2.5 GEV;

MARK ORG = ()
;
DRIFT D1  = (L=1.2)
      DQS = (L=0.1)
      DS  = (L=0.9)
;
QUAD  QF = (L=0.3 K1= 1.8*0.3)
      QD = (L=0.3 K1=-1.8*0.3)
;
SEXT  SF = (L=0.2 K2= 0.6)
      SD = (L=0.2 K2=-1.2)
;
BEND  B  = (L=0.8 ANGLE=0.157079632679490 E1=0.5 E2=0.5)
;
LINE CELL = (ORG QF DQS SF DS B D1 QD DQS SD DS B D1);
LINE RING = (20*CELL);
;

FFS;
