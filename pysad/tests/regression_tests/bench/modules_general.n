
WriteGraphs[]:=(
  FFS["draw bx & by & ex q*",12];
!!  FFS["draw nx & ny & epx b*",13];
!  FFS["draw dx & dy b*",15];
!  FFS["draw geo",14];
);


 DAsv[]:=(DAPWIDTH = 51;
           FFS["cell calc emit",6];
           dp = 0.01 / SIGE;
           zrange   = Range[-4.5 * dp, 4.6 * dp, dp /2];
           range    = {{1,400},{1,1},zrange};
           FFS["cell calc"];
!           FFS["disp MK*.*",6];
           res = DynamicApertureSurvey[range,5000,Output->6];
           res;
           Print[res[2,2,1,2],res[2,2,2,2],res[2,2,3,2],res[2,2,4,2],res[2,2,5,2],res[2,2,6,2],res[2,2,7,2],res[2,2,8,2],res[2,2,9,2],res[2,2,10,2],res[2,2,11,2],res[2,2,12,2],res[2,2,13,2],res[2,2,14,2],res[2,2,15,2],res[2,2,16,2],res[2,2,17,2],res[2,2,18,2],res[2,2,19,2]];
!           Write[datafile,res[2,2,1,2],res[2,2,2,2],res[2,2,3,2],res[2,2,4,2],res[2,2,5,2],res[2,2,6,2],res[2,2,7,2],res[2,2,8,2],res[2,2,9,2],res[2,2,10,2],res[2,2,11,2],res[2,2,12,2],res[2,2,13,2],res[2,2,14,2],res[2,2,15,2],res[2,2,16,2],res[2,2,17,2],res[2,2,18,2],res[2,2,19,2]];
           range    = {{1,1},{1,400},zrange};
           FFS["cell calc"];
           res = DynamicApertureSurvey[range,5000,Output->6];
           Print[res[2,2,1,2],res[2,2,2,2],res[2,2,3,2],res[2,2,4,2],res[2,2,5,2],res[2,2,6,2],res[2,2,7,2],res[2,2,8,2],res[2,2,9,2],res[2,2,10,2],res[2,2,11,2],res[2,2,12,2],res[2,2,13,2],res[2,2,14,2],res[2,2,15,2],res[2,2,16,2],res[2,2,17,2],res[2,2,18,2],res[2,2,19,2]];
!           Write[datafile,res[2,2,1,2],res[2,2,2,2],res[2,2,3,2],res[2,2,4,2],res[2,2,5,2],res[2,2,6,2],res[2,2,7,2],res[2,2,8,2],res[2,2,9,2],res[2,2,10,2],res[2,2,11,2],res[2,2,12,2],res[2,2,13,2],res[2,2,14,2],res[2,2,15,2],res[2,2,16,2],res[2,2,17,2],res[2,2,18,2],res[2,2,19,2]];
           res;
          );



