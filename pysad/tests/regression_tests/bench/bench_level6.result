 ! 粒子: {x, px, y, py, z, dp, 生存フラグ} を列ごとに並べる
 x0  = { 1E-3, 3E-3, 0,     1E-3,  0    };
 px0 = { 0,    0,    0,     1E-4,  0    };
 y0  = { 0,    0,    1E-3,  1E-3,  0    };
 py0 = { 0,    0,    0,     0,     0    };
 z0  = { 0,    0,    0,     0,     1E-3 };
 dp0 = { 0,    0,    0,     1E-3,  1E-3 };
