$FORM="18.14";
PageWidth=1999;
NPARA=1;
USE RING;
CELL;
CALC;
pms={"$$$","BMS.1","BMS.3","BMA.2","CAVI","Q1A.1",100,300,500,"^^^"};
keys={"DX","DPX","EX","EPX","NX","BX"};
show[tag_]:=(Do[Print[tag," ",pms[[i]]," ",Twiss[keys,pms[[i]]]],{i,Length[pms]}]);
show["T0"];
