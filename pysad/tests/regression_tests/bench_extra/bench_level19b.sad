! Level 19B: 幾何の分岐テスト (ROTATE 付き BEND, 垂直偏向, フリンジ長補正, MARK OFFSET, ORG)
MOMENTUM = 1GEV;
DRIFT D1 = (L = 1.2) D2 = (L = 0.7);
BEND B1 = (L = 1.0 ANGLE = 0.3)
     B2 = (L = 0.8 ANGLE = 0.2 ROTATE = 30 DEG)
     B3 = (L = 0.6 ANGLE = -0.15 ROTATE = 90 DEG)
     B4 = (L = 0.5 ANGLE = 0.1 FRINGE = 1 F1 = 0.3 E1 = 0.2 E2 = 0.3 AE1 = 0.01)
     B5 = (L = 0.4 ANGLE = 0.25 ROTATE = -60 DEG FRINGE = 1 FB1 = 0.2 FB2 = 0.1 F1 = 0.05);
QUAD QF = (L = 0.3 K1 = 0.5);
MARK M0 = () M1 = (OFFSET = 2.3) M2 = (OFFSET = -1.5) ME = ();
LINE L1 = (M0 D1 B1 D2 QF B2 M1 D1 B3 D2 B4 M2 D1 B5 QF D2 ME);
FFS;
$FORM="18.14";
PageWidth=1999;
USE L1;
lkeys={"GX","GY","GZ","GCHI1","GCHI2","GCHI3"};
Do[Print["LN ",i," ",LINE[lkeys,i]],{i,1,LINE["LENGTH"]}];
Do[Print["LN ",i+0.37," ",LINE[lkeys,i+0.37]],{i,1,LINE["LENGTH"]-1}];
Print["POS ",LINE["S","*"]];
Print["NAMES ",LINE["NAME","*"]];
ORG B3 1.5 -2.5 0.5 10 20 30;
CALC;
Do[Print["ORG ",i," ",LINE[lkeys,i]],{i,1,LINE["LENGTH"]}];
stop;
stop;
