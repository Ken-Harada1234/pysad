! bench_item6_tiny.sad — ESRF の 1 セル (ARCA, 160 要素) だけのリング: emit6d の解析ヤコビアン・tcod のユニットテスト用参照値
! (pysad/tests/kek-ls_v03_12.lat を連結して SAD に渡す)。RFSW OFF / RFSW / RFSW+RADCOD の Emittance[] を全桁で出す
 CAVI RFT = (VOLT = 7e4 HARM = 50);
 LINE TINY = (MKS ARCA RFT MKE);
FFS;
NPARA = 1;
$FORM="18.14";
PageWidth = 1999;
USE TINY;
CELL;
CALC;
ON RAD;
NORFSW; NORADCOD;
  em = Emittance[];
  Print["K ", 1];
  Print["EMT ", Emittances/.em];
  Print["SIG ", {MomentumSpread/.em, BunchLength/.em}];
  Print["TUN ", Tunes/.em];
  Print["ALP ", {MomentumCompaction/.em, EnergyLossU0/.em, RfVoltageVc/.em, EquilibriumPosition/.em, BucketHeight/.em}];
  Print["DMP ", DampingRate/.em];
  Print["COD ", OrbitAtExit/.em];
RFSW; NORADCOD;
  em = Emittance[];
  Print["K ", 2];
  Print["EMT ", Emittances/.em];
  Print["SIG ", {MomentumSpread/.em, BunchLength/.em}];
  Print["TUN ", Tunes/.em];
  Print["ALP ", {MomentumCompaction/.em, EnergyLossU0/.em, RfVoltageVc/.em, EquilibriumPosition/.em, BucketHeight/.em}];
  Print["DMP ", DampingRate/.em];
  Print["COD ", OrbitAtExit/.em];
RFSW; RADCOD;
  em = Emittance[];
  Print["K ", 3];
  Print["EMT ", Emittances/.em];
  Print["SIG ", {MomentumSpread/.em, BunchLength/.em}];
  Print["TUN ", Tunes/.em];
  Print["ALP ", {MomentumCompaction/.em, EnergyLossU0/.em, RfVoltageVc/.em, EquilibriumPosition/.em, BucketHeight/.em}];
  Print["DMP ", DampingRate/.em];
  Print["COD ", OrbitAtExit/.em];
stop;
stop;
