MOMENTUM = 0.5GEV;
DRIFT D1 = (L=0.5);
BEND  B1 = (L=1.0 ANGLE=0.39269908169872414);
QUAD  QF = (L=0.2 K1=0.5) QD = (L=0.2 K1=-0.5) QS = (L=0.1 K1=0.02 ROTATE=45 DEG);
CAVI  CA = (VOLT=0.2MV HARM=20 PHI=0);
MARK  ORIGIN = ();
LINE CELL = (QF D1 B1 D1 QD D1 B1 D1);
LINE RING = (ORIGIN CA QS 8*CELL);
FFS;
NPARA = 1;
RFSW; RAD; NOFLUC; RADCOD;
USE RING; CELL; CALC;
$FORM = "22.16";
PBUNCH = 2e10;
CODPLOT; WSPAC; EMIT;
e = Emittance[];
sz = BunchLength /. e;
Print["SZ ", sz];
NORAD; NORADCOD;
zs = sz*{1, 2, -1, -1, 1, 2, 1, 1};
ds = {0, 0, 0, 0, 0, 0, 0.01, 0.0};
z8 = {0,0,0,0,0,0,0,0};
xs0 = {0, 0, 0, 1e-3, 1e-3, 1e-3, 1e-3, 1e-3}; ys0 = {0, 0, 0, 1e-4, 1e-4, 1e-4, 1e-4, 0};
bm = {xs0, z8, ys0, z8, zs, ds, {1,1,1,1,1,1,1,1}};
PBUNCH = 2e10;
WSPAC;
r1 = TrackParticles[{1, bm}, 1, 1, 1][[2]];
NOWSPAC;
r0 = TrackParticles[{1, bm}, 1, 1, 1][[2]];
Print["PB ", PBUNCH];
Print["DD ", r1[[6]] - r0[[6]]];
Print["DX ", r1[[1]] - r0[[1]]];
Print["DY ", r1[[3]] - r0[[3]]];
Print["DZ ", r1[[5]] - r0[[5]]];
PBUNCH = 4e10;
WSPAC;
r1 = TrackParticles[{1, bm}, 1, 1, 1][[2]];
NOWSPAC;
r0 = TrackParticles[{1, bm}, 1, 1, 1][[2]];
Print["PB ", PBUNCH];
Print["DD ", r1[[6]] - r0[[6]]];
Print["DX ", r1[[1]] - r0[[1]]];
Print["DY ", r1[[3]] - r0[[3]]];
Print["DZ ", r1[[5]] - r0[[5]]];
CALC6D;
nlat = LINE["LENGTH"];
Do[ Print["EL ", k, " ", LINE["S", k], " ", LINE["L", k], " ", LINE["SIGX", k], " ", LINE["SIGY", k], " ", LINE["SIGXY", k], " ", LINE["SIGZ", k]], {k, 1, nlat}];
Exit;
