MOMENTUM = 3GEV;
DRIFT D1 = (L=1.0) D2 = (L=0.5) DS = (L=0.1);
QUAD  QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6) QX = (L=0.3 K1=0.7 );
BEND B = (L=1.2 ANGLE=0.2617993877991494 E1=0.5 E2=0.5)
 BR = (L=1.2 ANGLE=0.2617993877991494 E1=0.5 E2=0.5 );
MULT MB = (L=1.2 ANGLE=0.2617993877991494 E1=0.5 E2=0.5 CHI2=0.03)
 MM = (L=0.2 K1=0.05 K2=0.3 );
MARK  ORIGIN = ();
CAVI RF = (L=0 VOLT=4E6 FREQ=5.0E8 PHI=0);
LINE CELL = (QF D2 B D2 QD DS D1 DS MM);
LINE CELLR = (QF D2 B D2 QD DS D1 DS MM);
LINE CELLX = (QF D2 MB D2 QD DS D1 DS MM);
LINE RING = (ORIGIN RF 23*CELL CELLX);
FFS;
USE RING; CELL; CALC; RFSW; RAD; NOFLUC;
$FORM = "22.15";
PageWidth = 1999;
em = Emittance[];
Print["EM ", em];
Print["OR ", Twiss[{"DX","DY","DPX","DPY"}, "$$$"]];
Print["NU ", Twiss[{"NX","NY"}, "$$$"]];
Exit;
