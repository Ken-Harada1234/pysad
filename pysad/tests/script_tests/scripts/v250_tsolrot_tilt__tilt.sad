MOMENTUM = 3GEV;
SOL SA=(L=0 BZ=13 BOUND=1) SB=(L=0 BZ=0 BOUND=1);
MULT M=(L=0 K2=1e-9 CHI1=0.03 CHI2=-0.02 DZ=0.01);
MARK ST = ();
LINE ONE = (ST SA M SB);
FFS; NORFSW; NORAD; NOFLUC;
$FORM = "22.16";
beam = {{0.001, 0.0030000000000000001, -0.002, 0.00050000000000000001}, {0.002, -0.0040000000000000001, 0.01, 0.050000000000000003}, {-0.00050000000000000001, 0.002, 0.001, 0.00050000000000000001}, {0.001, 0.0050000000000000001, -0.0080000000000000002, 0.029999999999999999}, {0, 0, 0, 0}, {0, 0.01, -0.02, 0}, {1, 1, 1, 1}};
USE ONE; CELL;
r = TrackParticles[{1, beam}, 1, 1, 1];
Print["R ", r[[2]]];
