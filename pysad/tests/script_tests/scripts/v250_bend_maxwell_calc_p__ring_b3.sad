MOMENTUM = 3GEV;
BEND B1 = (L=1.0 ANGLE=0.2 E1=0 E2=0 FRINGE=1 DISFRIN=0 );
BEND B2 = (L=1.0 ANGLE=-0.2 E1=-0 E2=-0 FRINGE=1 DISFRIN=0 );
QUAD QF = (L=0.3 K1=0.9 DY=0.003) QD = (L=0.3 K1=-0.9 DY=-0.003);
DRIFT D = (L=0.5);
MARK ORG = () ENDM = ();
LINE CELL = (ORG QF D B1 D QD D B2 D ENDM);
FFS;
NORFSW; NORAD; NOFLUC;
$FORM = "22.16";
USE CELL; DP0 = 0.0; CELL; CALC;
Print["NXNY ", Twiss["NX",-1], " ", Twiss["NY",-1]];
c = {Twiss["DX",1], Twiss["DPX",1], Twiss["DY",1], Twiss["DPY",1], Twiss["DZ",1], Twiss["DDP",1]};
Print["EX ", Twiss["EX",1], " ", Twiss["EY",1]];
Print["COD ", c];
beam = {{c[[1]]}, {c[[2]]}, {c[[3]]}, {c[[4]]}, {c[[5]]}, {c[[6]]}, {1.0}};
r = TrackParticles[{1, beam}, 1, 1, 1];
Print["R ", {r[[2,1,1]], r[[2,2,1]], r[[2,3,1]], r[[2,4,1]], r[[2,5,1]], r[[2,6,1]]}];
Print["RES ", {r[[2,1,1]]-c[[1]], r[[2,2,1]]-c[[2]], r[[2,3,1]]-c[[3]], r[[2,4,1]]-c[[4]], r[[2,5,1]]-c[[5]], r[[2,6,1]]-c[[6]]}];

h = 1e-7;
mkb[x_] := Module[{b = Table[Table[c[[k]], {9}], {k, 6}], j},
  Do[b[[j,2*j]] = b[[j,2*j]] + h; b[[j,2*j+1]] = b[[j,2*j+1]] - h, {j, 4}];
  Join[b, {Table[1.0, {9}]}]];
b = mkb[0];
r = TrackParticles[{1, b}, 1, 1, 1];
Mt = Table[(r[[2,i,2*j]] - r[[2,i,2*j+1]])/(2*h), {i, 4}, {j, 4}];
d4 = Table[r[[2,i,1]] - c[[i]], {i, 4}];
dc = LinearSolve[IdentityMatrix[4] - Mt, d4];
Print["DCOD ", dc];
c2 = Table[c[[i]] + dc[[i]], {i, 4}];
b = Join[Table[{c2[[i]]}, {i, 4}], {{c[[5]]}, {c[[6]]}, {1.0}}];
r = TrackParticles[{1, b}, 1, 1, 1];
Print["RES2 ", Table[r[[2,i,1]] - c2[[i]], {i, 4}]];
