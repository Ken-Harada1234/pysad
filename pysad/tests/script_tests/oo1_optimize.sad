MOMENTUM = 3GEV;
DRIFT D1 = (L=1) D2 = (L=0.5);
QUAD QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
BEND B = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK ST = ();
LINE CELL1 = (QF D2 B D2 QD D1);
LINE RING = (ST 12*CELL1);
FFS;
$FORM="14.10";
USE RING;
CELL;
CALC;
Print["T0 ",Twiss[{"NX","NY"},"$$$"]/(2Pi)];
FREE QF QD;
FIT NX 2.75 NY 1.85;
v=FFS["VAR"];
Print["V ",Length[v]," ",Take[v[[1]],5]];
r=OptimizeOptics[Output->0,MaxIteration->60];
Print["R ",Length[r]," ",r[[1,1]]];
Print["K ",LINE["K1","QF.1"]," ",LINE["K1","QD.1"]];
CALC;
Print["T1 ",Twiss[{"NX","NY"},"$$$"]/(2Pi)];
Exit;
