BEND SH9 = (L=0.1 ANGLE=0) SV9 = (L=0.1 ANGLE=0 ROTATE=1.5707963267948966);
MARK BA9 = () BB9 = ();
LINE C9 = (QF9 SH9 SV9 BA9 D2 B D2 QD BB9 D1);
QUAD QF10 = (L=0.3 K1=0.7 DX=-4.410353e-05 DY=8.326907e-05);
BEND SH10 = (L=0.1 ANGLE=0) SV10 = (L=0.1 ANGLE=0 ROTATE=1.5707963267948966);
MARK BA10 = () BB10 = ();
LINE C10 = (QF10 SH10 SV10 BA10 D2 B D2 QD BB10 D1);
QUAD QF11 = (L=0.3 K1=0.7 DX=5.314509e-05 DY=-6.807916e-05);
BEND SH11 = (L=0.1 ANGLE=0) SV11 = (L=0.1 ANGLE=0 ROTATE=1.5707963267948966);
MARK BA11 = () BB11 = ();
LINE C11 = (QF11 SH11 SV11 BA11 D2 B D2 QD BB11 D1);
QUAD QF12 = (L=0.3 K1=0.7 DX=5.942940e-05 DY=-7.224652e-05);
BEND SH12 = (L=0.1 ANGLE=0) SV12 = (L=0.1 ANGLE=0 ROTATE=1.5707963267948966);
MARK BA12 = () BB12 = ();
LINE C12 = (QF12 SH12 SV12 BA12 D2 B D2 QD BB12 D1);
LINE RING = (ST C1 C2 C3 C4 C5 C6 C7 C8 C9 C10 C11 C12);
FFS;
$FORM="14.10";
USE RING;
CELL;
CALC;
Print["TUN ", Twiss[{"NX","NY"},"$$$"]/(2Pi)];
mon=Monitor[{"BA1","BB1","BA2","BB2","BA3","BB3","BA4","BB4","BA5","BB5","BA6","BB6","BA7","BB7","BA8","BB8","BA9","BB9","BA10","BB10","BA11","BB11","BA12","BB12"}];
str=Steer[{"SH1","SV1","SH2","SV2","SH3","SV3","SH4","SV4","SH5","SV5","SH6","SV6","SH7","SV7","SH8","SV8","SH9","SV9","SH10","SV10","SH11","SV11","SH12","SV12"}];
Print["MON ",Length[mon[[1]]]," ",Length[str[[1]]]];
rms:=Sqrt[Plus@@Twiss["DY",mon[[1]]]^2/Length[mon[[1]]]];
rmx:=Sqrt[Plus@@Twiss["DX",mon[[1]]]^2/Length[mon[[1]]]];
Print["RM0 ",rms," ",rmx];
opt=CalculateOptics[1,LINE["LENGTH"],Twiss["*",1],FLAG["CELL"],2];
a=ResponseMatrixG[mon[[1]],str,opt,FLAG["CELL"],"Y"];
Print["A ",Dimensions[a]," ",Take[a[[1]],4]," ",Take[a[[5]],4]];
r=CorrectOrbit["Y",mon,str,opt];
Print["R ",Length[r]," ",Take[r,6]];
CALC NOEXP;
Print["RMS ",rms," ",rmx];
opt=CalculateOptics[1,LINE["LENGTH"],Twiss["*",1],FLAG["CELL"],2];
r=CorrectOrbit["X",mon,str,opt];
Print["RX ",Length[r]," ",Take[r,6]];
CALC NOEXP;
Print["RMSX ",rms," ",rmx];
r=CorrectOrbit[{"X","Y"},mon,str,opt,Solver->{"Micado",6}];
Print["RM ",Length[r]," ",Take[r,6]];
CALC NOEXP;
Print["RMSM ",rms," ",rmx];
Exit;
