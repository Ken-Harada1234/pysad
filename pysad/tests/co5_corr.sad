QUAD QF5 = (L=0.3 K1=0.7 DX=8.867134e-05 DY=2.979491e-05);
BEND SH5 = (L=0.1 ANGLE=0) SV5 = (L=0.1 ANGLE=0 ROTATE=1.5707963267948966);
MARK BA5 = () BB5 = ();
LINE C5 = (QF5 SH5 SV5 BA5 D2 B D2 QD BB5 D1);
QUAD QF6 = (L=0.3 K1=0.7 DX=8.018010e-05 DY=-7.735881e-05);
BEND SH6 = (L=0.1 ANGLE=0) SV6 = (L=0.1 ANGLE=0 ROTATE=1.5707963267948966);
MARK BA6 = () BB6 = ();
