QUAD QF7 = (L=0.3 K1=0.7 DX=-6.186190e-06 DY=-5.068543e-05);
BEND SH7 = (L=0.1 ANGLE=0) SV7 = (L=0.1 ANGLE=0 ROTATE=1.5707963267948966);
MARK BA7 = () BB7 = ();
LINE C7 = (QF7 SH7 SV7 BA7 D2 B D2 QD BB7 D1);
QUAD QF8 = (L=0.3 K1=0.7 DX=8.752172e-06 DY=1.478824e-05);
BEND SH8 = (L=0.1 ANGLE=0) SV8 = (L=0.1 ANGLE=0 ROTATE=1.5707963267948966);
MARK BA8 = () BB8 = ();
