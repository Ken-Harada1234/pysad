             2*SDC MKSDC1 2*SDC
             DR08, QDA5, DR08,
             BPI1, BPI2, BPI3H HD BPI3H BPI4, BPI5
             DR08H BPM DR08H QFA6H QFA6H DR28,
             BPI6 HD BPI6 DR281 DR282 QFA8H VD QFA8H DR08, SHA, DR08,
             BPI7 DRCT MKC
             MKE)
 ARCA      = (ARCAH -ARCAH2)
 RING      =(MKS
             ARCA, ARCA, ARCA, ARCA,
             ARCA, ARCA, ARCA, ARCA,
             ARCA, ARCA, ARCA, ARCA, RFC,
             ARCA, ARCA, ARCA, ARCA,
             ARCA, ARCA, ARCA, ARCA
