MOMENTUM = 1e9;
DRIFT D1 = (L=1) D2 = (L=0.5);
QUAD QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
BEND B = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
MARK ST = ();
LINE CELL1 = (QF D2 B D2 QD D1);
LINE RING = (ST 3*CELL1);
FFS;
$FORM="18.14";
PageWidth = 1999;
USE RING;
CELL;
CALC;
RADLIGHT;
np=2;
x=Table[0,{7},{np}];
x[[1,2]]=1e-4;x[[3,2]]=-1e-4;x[[6,2]]=1e-3;
Do[x[[7,i]]=1,{i,np}];
d={3,x};
r=TrackParticles[d,9,1,2];
t=r[[2]];
Print["S1 ",t[[1,1]]];Print["S2 ",t[[1,2]]];Print["S3 ",t[[1,3]]];Print["S4 ",t[[1,4]]];Print["S5 ",t[[2,1]]];Print["S6 ",t[[2,2]]];Print["S7 ",t[[2,3]]];Print["S8 ",t[[2,4]]];
Print["R ",r[[1,2]]];
Exit;
