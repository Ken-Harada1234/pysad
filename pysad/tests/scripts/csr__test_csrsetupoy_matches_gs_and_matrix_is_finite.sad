FFS;
$FORM="18.14";
PageWidth=1999;
nr=256; dz=2e-5;
zl=Table[0.02*Cos[0.3 i]/(1+i/10.), {i,1,nr}];
rho=CSRHaissin[zl,{dz,1e-8,-0.3,3e-4}];
s=CSRSetupOY[rho,zl,{dz,6,3,1e-8,0.05,-0.3,3}];
Print["S ",Length/@s];
Print["AJ ",s[[2]]];
Print["OM ",s[[3]]];
Print["RJ ",s[[6]]];
Print["ZS ",Plus@@s[[5]]];
m=CSROYMatrix[s,{dz,1e-8,0.01,3e-4,1e-3}];
Print["M ",Dimensions[m]];
Exit;
