FFS;
$FORM="18.12";
SeedRandom[3];
Do[r = BBBrem1[3e9, 1e-6]; Print["BR ", r[[1,1]], " ", r[[1,2]], " ", r[[1,3]], " ", r[[1,4]], " ", r[[2]]], {i, 6}];
Do[r = BBBrem1[1e10*i, 1e-3]; Print["BS ", r[[1,1]], " ", r[[1,2]], " ", r[[1,3]], " ", r[[1,4]], " ", r[[2]]], {i, 1, 4}];
Print["BU ", Random[]];
Exit;
