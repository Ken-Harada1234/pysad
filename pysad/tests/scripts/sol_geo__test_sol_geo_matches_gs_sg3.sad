MOMENTUM = 3GEV;
DRIFT D1 = (L=1) D2 = (L=0.5) D3 = (L=0.25);
QUAD QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6) QS = (L=0.2 K1=-0.05 ROTATE=0.3);
BEND B = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
SOL SA = (L=0 BZ=2 BOUND=1) SM = (L=0 BZ=0.8) SB = (L=0 BZ=0 BOUND=1 GEO=1 DX=1e-3 DY=2e-3 DPX=-2e-3 DPY=1e-3);
MARK ST = ();
LINE CELLS = (QF D2 B D2 QD D3 SA D3 QS D3 SM D3 SB D3 B D2);
LINE RING = (ST CELLS);
FFS;
$FORM="16.10";
USE RING;
INS; CALC;
Do[Print["G ", k, " ", LINE["S",k], " ", LINE["GX",k], " ", LINE["GZ",k], " ", LINE["GCHI2",k], " ", LINE["GCHI3",k]], {k, 1, 18}];
Exit;
