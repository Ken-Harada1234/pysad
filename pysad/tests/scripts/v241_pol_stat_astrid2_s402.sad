MOMENTUM= 0.58 GEV;

MARK
	MKS   =()
	MKE   =()
;

MONI
	PM     =()
;

CAVI
	CAVI=(VOLT= 50000 FREQ = 104950000)
;

BEND
	PV = ( L = 0    K0 = 0     ROTATE =-90 DEG ) 
	PH = ( L = 0    K0 = 0  )
;

QUAD
	QF3 = ( L =0.1800 K1 =5.939500*0.1800 )
	QF2 = ( L =0.1800 K1 =6.070000*0.1800 )
;

SEXT
	SF = ( L =0.0750   K2 =   125.62*0.0750 )
	SD = ( L =0.1500   K2 =   -81.93*0.15 )
;

BEND
	BH = (L = 0.8500 ANGLE = 0.523599 K1 = -1.678200*0.8500  E1=0 E2=0)
;

DRIFT
	D14837    = (L = 1.4837 )
	D0100     = (L = 0.1000 )
	D0180     = (L = 0.1800 )
	D0190     = (L = 0.1900 )
	D0120     = (L = 0.1200 )
;

LINE
	HV    = (PH PV)
	NCELL
	=(MKS
	  D14837 PM D0100 QF3  D0180 HV D0180 
          BH 
          D0190 SD D0120 QF2 D0120 SF
          PM
	  SF D0120 QF2 D0120 SD D0190 
          BH D0180 HV D0180 QF3 D0100 PM D14837
          MKE) 

	RING = (3*NCELL CAVI 3*NCELL)
        RINGMPW = (3*NCELL CAVI 3*NCELL)
!	RING = (6*CELL)
;
 SEXT   SD      =(L =.15  K2 =-11.729486011842393 )
        SF      =(L =.075 K2 =8.681418961367605 )
 ;
FFS;
$FORM = "14.8";
PageWidth = 1999;
NPARA = 1;
USE RING;
CELL;
LINE["DY","Q*"] = {-0.001603863,-0.002648718,-0.000496723,0.00084089,0.002272093,0.000219413,-0.001105295,-0.001569561,0.001497492,0.003269566,0.000545538,-0.002466657,-0.00191653,0.003200038,0.000405765,-0.00346427,-0.000167392,-0.002326452,-0.001258576,-0.000976012,-0.001426627,0.001106757,-0.000126172,-0.001178863};
CALC;

RFSW; RAD; NOFLUC; NORADPOL;
POL;
em = Emittance[];
Print["EM ", {PolarizationTime, SpinTune, NominalSpinTune, Polarization, PolarizationVector}/.em];
Print["EMB ", {MomentumSpread, EquilibriumPosition}/.em, " ", Emittances/.em];
n0 = {-0.000903738579213,0.999981216948,0.00606209597116};
N0 = {{-0.42997316299,0.00590988250134,0.980567272861,0.000262597233688,3.10125454503e-07,0.0770171137842},{-0.00592730839106,0.000168515815529,0.0135170950888,0.000654369659668,3.25313111524e-09,0.00106200767581},{0.00105039406158,-0.738560112827,0.000297945546986,-5.52129498038,8.67075890952e-06,-0.00276552228668}};
cod = {-0.00325958043236,-1.81497397353e-07,0.0119771972803,-7.45904399949e-08,8.57553550505e-05,0.000897059655269};
np = 40;
one = Table[1, {i, np}];
beam = {{-0.0033524773673,-0.003106406703,-0.003572810433,-0.00317311937036,-0.0034134027414,-0.00311367850401,-0.00331930400498,-0.00341255544261,-0.00340692020404,-0.0032148045533,-0.00356033756628,-0.00315458199345,-0.00314605138425,-0.00350369746467,-0.0034848640718,-0.00275691120237,-0.00306584995499,-0.00324662480446,-0.00312853171313,-0.00312146219793,-0.00320079183721,-0.00302446201159,-0.00300063604053,-0.00356966334396,-0.00339463116463,-0.00325448463926,-0.00297173751374,-0.0030665704927,-0.00319365410307,-0.00339703765597,-0.00346530317476,-0.00366433264238,-0.00350588457372,-0.00304486650483,-0.00341800590197,-0.00361268663844,-0.00278974750685,-0.0037082233344,-0.00263582135883,-0.00328071140087},{-5.99149200505e-05,2.18986163449e-06,1.72232564202e-05,-9.45509686795e-06,-4.20441326828e-05,7.35780224019e-05,-2.54919800764e-06,-4.18672821998e-06,-5.37538733114e-05,0.000128971124194,-7.80334994569e-05,-4.19815882201e-05,-0.000100985272742,4.03627103424e-05,-8.01378683354e-05,-2.8326591814e-05,-2.51489652261e-05,-8.79973704532e-05,-3.58098416831e-05,-4.78940977953e-06,-0.000113029465644,0.000108929557788,-0.000117037335765,-2.19925923245e-05,-4.48829620376e-06,8.81293534779e-05,-0.000113133532339,-2.65719922327e-05,7.08301652437e-05,1.22096863356e-05,3.00240283162e-05,5.57960127757e-05,-1.21716614755e-05,-1.5144012671e-05,-8.21561582164e-05,1.82436289321e-06,2.96105124466e-05,-8.344772369e-06,2.84645091198e-05,-1.04689138809e-05},{0.0119296950673,0.0120746393232,0.0119452108055,0.0119507775343,0.0119619762045,0.0120094796702,0.011933900562,0.0119609118354,0.0119386686342,0.0119986464229,0.011872801857,0.0120457259777,0.011985137862,0.0119675668325,0.0119220953934,0.0120589300244,0.0119991416911,0.0119650503053,0.0120121372027,0.0120086825828,0.0119596030989,0.0120768986214,0.0120379596096,0.0119302950307,0.0119869964161,0.0119728637717,0.0120682169698,0.0119948942469,0.012017269911,0.0119539147192,0.0119782516631,0.0119075801837,0.0119151568513,0.012004644