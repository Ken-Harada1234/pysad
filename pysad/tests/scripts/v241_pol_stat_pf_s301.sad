LINE
! fast steering set
        PHV    = (PH PV) 
! "MPHV" and "MPM" is the place where geometrically we can install steering magnets
! and beam position monitors (but we do not install them, not decided yet).

        STRNW  =(
!                 MKASYMST
!                 B01 L300 PHV   L050  PM    L050
!                 Q2  L050 VD    L050
!                 Q1  L050 PM    L050  MPHVM LLS1
!                 MKSNEE
                 MKSNWS
                 U02  LLS1  PHV   L050   PM     L050
                 Q1   L050  VD    L050 
                 Q2   L050  PM    L050   MPHVM  L300
