        MKSNWE  = ()
        MKSNEE  = ()
        MKSSWE  = ()
        MKSSEE  = ()
        MKNCWE  = ()
        MKNCEE  = ()

        DM      = ()
   ! BPM not used for user operation.
   !   because signal processors are not caribrated.
        MPM     = ()
   ! PHV ; nothing is set up.
        MPHV    = ()
   ! PHV ; magnet and girder are already set.
        MPHVM   = ()
   ! PHV ; only girder is set.
        MPHVG   = ()

