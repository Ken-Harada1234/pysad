MOMENTUM = 3GEV;
MARK ST=();
DRIFT D1 = (L=1) D2 = (L=0.5);
QUAD QF = (L=0.3 K1=0.7) QD = (L=0.3 K1=-0.6);
SEXT SF = (L=0.2 K2=0);
BEND B = (L=1.2 ANGLE=0.2617993877991494 E1=0.1308996938995747 E2=0.1308996938995747);
LINE CELL1 = (QF D2 B D2 QD D1);
LINE RING = (ST 6*CELL1);
FFS;
$FORM="S22.15"; PageWidth=19999;
USE RING; CELL; CALC;
g=OpticsPlot[{{"BX","BY"},{"EX"}},Region->{3,20},Lattice->True,Names->"B*",DisplayFunction->Identity];
l=Cases[g,_Line,Infinity];
Do[Print["LINE ",i," ",Length[l[[i,1]]]," ",Flatten[l[[i,1]]]],{i,Length[l]}];
r=Select[Cases[g,_Rectangle,Infinity],Head[#[[3]]]===Rule&];
Print["NRECT ",Length[r]];
Do[Print["RECT ",i," ",r[[i,1]]," ",r[[i,2]]],{i,Length[r]}];
t=Cases[g,_Text,Infinity];
Print["NTEXT ",Length[t]];
Do[Print["TEXT ",i," ",t[[i,1,1]]," ",t[[i,1,2,1,1]]],{i,Length[t]}];
Exit;
